// The flora capability's own types (ADR-0007, ADR-0027; docs/subsystems/flora.md). They live with
// the capability, so ENGINE_WITH_FLORA=OFF takes them out of the build with everything else it owns:
// a build without the capability refuses a `.flora.json` mesh by the mesh-generator registry's
// sentence, and never needs to read one.
namespace engine.flora

/// The date palm (Phoenix dactylifera), the solver's first species (flora.md, "The date palm"):
/// every parameter the solver reads, with the range it accepts and a default that makes a 9 m palm.
/// The same parameters give the same mesh, byte for byte, on every toolchain.
struct Palm @version(1) {
  /// Everything the parameters leave to chance — the lean's azimuth, each ring's twist, each
  /// frond's turn and spread — is drawn from this. Any u64.
  seed: u64 = 1
  /// The trunk's apex above its base, where the fronds spring: 1 to 30 m.
  height_m: f32 = 9.0 @unit(m)
  /// The trunk's radius at the ground, over the ring scars: 0.05 to 1 m.
  trunk_base_radius_m: f32 = 0.24 @unit(m)
  /// The trunk's radius where the crown's leaf sheaths begin, which swell it by 40% by the apex:
  /// 0.03 m up to the base radius.
  trunk_top_radius_m: f32 = 0.18 @unit(m)
  /// How far from vertical the trunk leaves the ground: 0 to 40 degrees.
  lean_deg: f32 = 7.0 @unit(deg)
  /// How much of the lean the spine takes back by the apex: 0 a straight leaning trunk, 1 an apex
  /// that stands vertical again.
  curve: f32 = 0.5
  /// The leaf-scar rings: one ring every this many metres up the trunk, 0.04 to 1 m.
  ring_spacing_m: f32 = 0.11 @unit(m)
  /// How deep a scar cuts below the trunk's radius: 0 to a quarter of the top radius, and 0.1 m.
  ring_depth_m: f32 = 0.014 @unit(m)
  /// Green fronds in the crown: 1 to 64.
  frond_count: u32 = 26
  /// A green frond's length along its rachis: 0.5 to 8 m.
  frond_length_m: f32 = 3.8 @unit(m)
  /// How far a frond's rachis curves down along its length: 0 straight, 1 the tip turned 100 degrees
  /// further from vertical than the base.
  frond_droop: f32 = 0.45
  /// The crown's cone: the outermost frond leaves the apex this far from vertical, 5 to 120 degrees.
  frond_spread_deg: f32 = 75.0 @unit(deg)
  /// Leaflets on each side of a frond: 2 to 160.
  leaflet_count: u32 = 64
  /// A leaflet's width at its base: 0.005 to 0.12 m, and never wider than the gap between two.
  leaflet_width_m: f32 = 0.04 @unit(m)
  /// The angle a leaflet makes with the rachis, towards the frond's tip: 10 to 85 degrees.
  leaflet_angle_deg: f32 = 38.0 @unit(deg)
  /// Dead brown fronds hanging below the crown, 0 for none: 0 to 64.
  dead_skirt_fronds: u32 = 10
  /// The most triangles the mesh may have: 2,000 to 2,000,000. The solver builds the full detail
  /// when it fits and spends less where it does not (flora.md, "The budget").
  triangle_budget: u32 = 60000
}

/// A deciduous broadleaf (flora.md, "The broadleaf"): an oak-like tree of a trunk, scaffold limbs,
/// their branches and leafy twigs, grown by seeded self-similar branching — each order's shoots
/// spaced along their parent on the golden angle, turned towards the light, their radii by the pipe
/// model — with its leaves as two-sided cards on the twigs. Defaults make a 12 m oak.
struct Broadleaf @version(3) {
  /// Everything left to chance: the lean's azimuth, every shoot's turn, spread and wander.
  seed: u64 = 1
  /// The leader's top above the ground: 3 to 40 m.
  height_m: f32 = 12.0 @unit(m)
  /// The trunk's radius at the ground: 0.05 to 2 m, or 0 for the allometric radius of the height
  /// (`allometry_exponent`: 0.35 m at 12 m). Every shoot's radius follows from it by the pipe model.
  trunk_radius_m: f32 = 0.0 @unit(m)
  /// Where the crown begins, as a share of the height: the lowest limb leaves the trunk here,
  /// 0.1 to 0.8.
  crown_base: f32 = 0.3
  /// How far from vertical the trunk leaves the ground: 0 to 30 degrees.
  lean_deg: f32 = 3.0 @unit(deg)
  /// Scaffold limbs (order 1) along the trunk in the crown: 1 to 12.
  limbs: u32 = 8
  /// A limb's angle from the trunk where it leaves it, the lowest limb's: 15 to 85 degrees (the
  /// upper limbs a third more upright).
  limb_angle_deg: f32 = 60.0 @unit(deg)
  /// The lowest limb's length as a share of the height: 0.15 to 0.9 (the upper limbs shorter).
  limb_length: f32 = 0.5
  /// Branches (order 2) on every limb: 1 to 8.
  branches: u32 = 6
  /// The most laterals a shoot above the limbs bears (a cap on `branching_ratio` - 1; it was the
  /// twigs on every branch): 1 to 10.
  twigs: u32 = 9
  /// A branch's or a twig's angle from its parent: 15 to 85 degrees.
  branch_angle_deg: f32 = 45.0 @unit(deg)
  /// A branch's length over its limb's: 0.2 to 0.9.
  branch_length: f32 = 0.5
  /// The terminal twig's length, a species constant: 0.1 to 3 m.
  twig_length_m: f32 = 0.7 @unit(m)
  /// How far each shoot turns towards the light along its length, as a share of 40 degrees:
  /// -1 (weeping) to 1.
  upturn: f32 = 0.5
  /// How far a shoot wanders from straight at every step: 0 to 25 degrees.
  wander_deg: f32 = 5.0 @unit(deg)
  /// The most leaf cards along each side of a twig (the count is `leaf_area_index`'s): 1 to 40.
  leaves: u32 = 12
  /// A leaf card's length, out from the twig — one leaf, a species constant: 0.03 to 0.6 m.
  leaf_length_m: f32 = 0.24 @unit(m)
  /// A leaf's angle from its twig, towards the tip: 10 to 85 degrees.
  leaf_angle_deg: f32 = 50.0 @unit(deg)
  /// The most triangles the mesh may have: 8,000 to 2,000,000 (flora.md, "The broadleaf").
  triangle_budget: u32 = 60000
  // ---- allometric branching (G72; flora.md "Allometry", docs/experiments/tree-allometry.md).
  // Above the limbs the crown is a recursion of self-similar orders down to a terminal twig of the
  // species' own size: `branches` is then the limbs' laterals, `twigs` a cap on a shoot's laterals,
  // `leaves` a cap on a twig's cards a side, and the leaf count comes from `leaf_area_index`.
  /// The terminal twig's radius, a species constant that never scales with the tree (Corner's
  /// rules): 0.001 to 0.012 m. The recursion stops where a shoot's thinnest child would be thinner.
  twig_radius_m: f32 = 0.004 @unit(m) @since(2)
  /// The pipe model's exponent: a parent's radius to this power is the sum of its children's
  /// (da Vinci's 2; measured trees 1.8 to 2.5): 1.8 to 3.
  area_exponent: f32 = 2.0 @since(2)
  /// Children a shoot of the recursion bears, its leader included (Horton's bifurcation ratio,
  /// 3 to 5 in trees): 2 to 6.
  branching_ratio: u32 = 4 @since(2)
  /// A child's length over its parent's (West, Brown and Enquist's space-filling n^(-1/3), 0.63
  /// for 4 children): 0.4 to 0.9.
  length_ratio: f32 = 0.63 @since(2)
  /// The leader's share of a node's cross-section, the laterals sharing the rest equally: 0.1 to
  /// 0.7. Above 1 / `branching_ratio` the leader dominates (apical control).
  leader_share: f32 = 0.3 @since(2)
  /// One-sided leaf area over the crown's footprint (the convex hull of its shoot tips from above),
  /// which sets the leaf count: 0.5 to 10 (temperate broadleaf crowns 3 to 6).
  leaf_area_index: f32 = 4.0 @since(2)
  /// A leaf card's width over its length: 0.1 to 1.
  leaf_width: f32 = 0.5 @since(2)
  /// The exponent b of height on trunk diameter, H ~ D^b (elastic similarity's 2/3), by which a
  /// `trunk_radius_m` of 0 is found from `height_m`: 0.4 to 1.
  allometry_exponent: f32 = 0.6667 @since(2)
  /// A branch-group card's baked tile, texels a side; 0 bakes no branch-group levels (flora.md, "The
  /// impostor chain"): 0, or 16 to 256.
  card_bake_px: u32 = 64 @since(3)
  /// A whole-tree impostor view, texels a side; 0 makes no impostor: 0, or 32 to 1024.
  impostor_px: u32 = 256 @since(3)
}

/// A conifer (flora.md, "The conifer"): a pine or spruce of a straight trunk and whorls of
/// branches in tiers, longest at the bottom and thinning upward, each branch a woody shoot carrying
/// a spray of needle-bundle cards. Defaults make a 16 m spruce.
struct Conifer @version(1) {
  /// Everything left to chance: the lean's azimuth, every whorl's turn, every branch's spread.
  seed: u64 = 1
  /// The leader's top above the ground: 1 to 60 m.
  height_m: f32 = 16.0 @unit(m)
  /// The trunk's radius at the ground: 0.03 to 1.5 m.
  trunk_radius_m: f32 = 0.3 @unit(m)
  /// Where the lowest whorl is, as a share of the height: 0 to 0.8.
  crown_base: f32 = 0.12
  /// How far from vertical the trunk leaves the ground: 0 to 20 degrees.
  lean_deg: f32 = 1.0 @unit(deg)
  /// Tiers of branches up the crown: 2 to 60.
  whorls: u32 = 28
  /// Branches in the lowest whorl: 2 to 10 (fewer higher up, by `thinning`).
  branches_per_whorl: u32 = 6
  /// The share of a whorl's branches the top of the crown has lost: 0 to 0.8.
  thinning: f32 = 0.4
  /// The lowest branches' reach from the trunk: 0.2 to 12 m; the crown's cone narrows to the top.
  crown_radius_m: f32 = 3.2 @unit(m)
  /// The lowest whorl's angle from vertical: 60 to 130 degrees (more than 90 hangs below level).
  bottom_angle_deg: f32 = 105.0 @unit(deg)
  /// The top whorl's angle from vertical: 20 to 100 degrees.
  top_angle_deg: f32 = 55.0 @unit(deg)
  /// How far a branch's tip turns back up towards the light: 0 to 1.
  upturn: f32 = 0.5
  /// Needle-bundle cards along each side of the longest branch (shorter ones in proportion):
  /// 2 to 60.
  needle_cards: u32 = 24
  /// A needle-bundle card's length, out from its branch: 0.03 to 1 m.
  needle_length_m: f32 = 0.42 @unit(m)
  /// The most triangles the mesh may have: 8,000 to 2,000,000 (flora.md, "The conifer").
  triangle_budget: u32 = 40000
}

/// A birch (flora.md, "The birch"): one to three slender white stems from one foot, a narrow crown
/// of short limbs on the golden angle, and fine twigs that droop at the crown's edge, each a spray
/// of small leaf cards. Defaults make a 14 m two-stemmed birch.
struct Birch @version(1) {
  /// Everything left to chance: the stems' azimuths, every limb's and twig's turn and spread.
  seed: u64 = 1
  /// The tallest stem's top above the ground: 3 to 30 m (the others a little shorter).
  height_m: f32 = 14.0 @unit(m)
  /// The tallest stem's radius at the ground: 0.03 to 0.5 m (the others thinner).
  stem_radius_m: f32 = 0.13 @unit(m)
  /// Stems from the one foot: 1 to 3.
  stems: u32 = 2
  /// How far from vertical the second and third stems leave the foot: 0 to 30 degrees.
  stem_spread_deg: f32 = 12.0 @unit(deg)
  /// Where the crown begins on a stem, as a share of its height: 0.15 to 0.8.
  crown_base: f32 = 0.4
  /// Limbs on every stem: 2 to 16.
  limbs: u32 = 12
  /// The lowest limb's angle from its stem: 15 to 80 degrees (the upper limbs a half more upright).
  limb_angle_deg: f32 = 45.0 @unit(deg)
  /// The lowest limb's length as a share of the height: 0.08 to 0.5 (the upper limbs shorter).
  limb_length: f32 = 0.24
  /// Twigs on every limb, and on every stem's top: 2 to 16.
  twigs: u32 = 12
  /// A twig's length: 0.2 to 3 m.
  twig_length_m: f32 = 1.1 @unit(m)
  /// How far the twigs hang: 0 not at all, 1 the outermost turned 80 degrees towards the ground
  /// along their length.
  droop: f32 = 0.6
  /// How far a shoot wanders from straight at every step: 0 to 20 degrees.
  wander_deg: f32 = 6.0 @unit(deg)
  /// Leaf cards along each side of a twig: 1 to 30.
  leaves: u32 = 12
  /// A leaf card's length, out from the twig: 0.02 to 0.25 m.
  leaf_length_m: f32 = 0.09 @unit(m)
  /// A leaf's angle from its twig, towards the tip: 10 to 85 degrees.
  leaf_angle_deg: f32 = 55.0 @unit(deg)
  /// The most triangles the mesh may have: 8,000 to 2,000,000 (flora.md, "The birch").
  triangle_budget: u32 = 50000
}

/// A weeping willow (flora.md, "The willow"): a short thick trunk, limbs arching out and up from
/// its top, branches along their outer half, and from the branches long hanging curtains of twigs —
/// each a chain of leaf cards drooping under gravity, a part of its own. Defaults make an 11 m
/// willow.
struct Willow @version(1) {
  /// Everything left to chance: every limb's turn, every branch's spread, every curtain's length.
  seed: u64 = 1
  /// The crown's top above the ground: 4 to 25 m.
  height_m: f32 = 11.0 @unit(m)
  /// The trunk's radius at the ground: 0.08 to 1.5 m.
  trunk_radius_m: f32 = 0.45 @unit(m)
  /// Where the trunk divides into its limbs, as a share of the height: 0.15 to 0.6.
  trunk_height: f32 = 0.3
  /// Limbs from the trunk's top: 2 to 12.
  limbs: u32 = 7
  /// A limb's angle from vertical where it leaves the trunk: 20 to 80 degrees.
  limb_angle_deg: f32 = 50.0 @unit(deg)
  /// A limb's length as a share of the height: 0.3 to 1.
  limb_length: f32 = 0.62
  /// Branches along the outer half of every limb: 1 to 10.
  branches: u32 = 5
  /// A branch's length over its limb's: 0.15 to 0.8.
  branch_length: f32 = 0.4
  /// Hanging curtains of twigs along every branch: 1 to 16.
  curtains: u32 = 6
  /// A curtain's length, before the ground shortens it: 0.5 to 15 m.
  curtain_length_m: f32 = 5.0 @unit(m)
  /// How far a shoot wanders from straight at every step: 0 to 20 degrees.
  wander_deg: f32 = 5.0 @unit(deg)
  /// Leaf cards along each side of a curtain: 2 to 40.
  leaves: u32 = 28
  /// A leaf card's length, out from the twig: 0.03 to 0.4 m.
  leaf_length_m: f32 = 0.14 @unit(m)
  /// A leaf's angle from its twig, towards the tip (down): 5 to 60 degrees. A willow's leaves are
  /// narrow and hang close along the twig.
  leaf_angle_deg: f32 = 22.0 @unit(deg)
  /// The most triangles the mesh may have: 12,000 to 2,000,000 (flora.md, "The willow").
  triangle_budget: u32 = 60000
}

/// An orchard tree (flora.md, "The orchard tree"): an apple-like tree of a short trunk, a low broad
/// crown of scaffold limbs, branches and leafy twigs — pruned to a flat-topped vase, or left free —
/// and optionally fruit on the twigs. Defaults make a 4.5 m pruned apple without fruit.
struct Orchard @version(1) {
  /// Everything left to chance: every limb's turn, every shoot's spread and wander.
  seed: u64 = 1
  /// The crown's top above the ground: 2 to 12 m.
  height_m: f32 = 4.5 @unit(m)
  /// The trunk's radius at the ground: 0.04 to 0.6 m.
  trunk_radius_m: f32 = 0.14 @unit(m)
  /// Where the trunk divides into its scaffold limbs, as a share of the height: 0.12 to 0.5.
  trunk_height: f32 = 0.25
  /// Scaffold limbs from the trunk's top: 2 to 8.
  limbs: u32 = 5
  /// A limb's angle from vertical: 25 to 80 degrees.
  limb_angle_deg: f32 = 52.0 @unit(deg)
  /// A limb's length as a share of the height: 0.3 to 1.2.
  limb_length: f32 = 0.7
  /// Branches on every limb: 1 to 8.
  branches: u32 = 5
  /// Leafy twigs on every branch: 1 to 12.
  twigs: u32 = 9
  /// A twig's length: 0.1 to 1.5 m.
  twig_length_m: f32 = 0.45 @unit(m)
  /// Pruned to an open, flat-topped vase: the limbs straight and the branches levelled under the
  /// crown's top. False lets them grow towards the light into a rounder crown.
  pruned: bool = true
  /// How far a shoot wanders from straight at every step: 0 to 20 degrees.
  wander_deg: f32 = 7.0 @unit(deg)
  /// Leaf cards along each side of a twig: 1 to 30.
  leaves: u32 = 10
  /// A leaf card's length, out from the twig: 0.03 to 0.25 m.
  leaf_length_m: f32 = 0.1 @unit(m)
  /// A leaf's angle from its twig, towards the tip: 10 to 85 degrees.
  leaf_angle_deg: f32 = 50.0 @unit(deg)
  /// Fruit hanging from every twig: 0 for none, up to 6.
  fruit: u32 = 0
  /// A fruit's radius: 0.02 to 0.08 m.
  fruit_radius_m: f32 = 0.04 @unit(m)
  /// The fruit's colour, linear red, green and blue, each 0 to 1.
  fruit_red: f32 = 0.62
  fruit_green: f32 = 0.08
  fruit_blue: f32 = 0.05
  /// The most triangles the mesh may have: 8,000 to 2,000,000 (flora.md, "The orchard tree").
  triangle_budget: u32 = 40000
}

/// The architecture of an ancient tree's crown (flora.md, "Megaflora"; docs/experiments/
/// megaflora-habits.md): where on the trunk its limbs leave, how many, their angles, whether the
/// trunk carries through to the top or dissolves into the limbs, and how wide the crown is against
/// the tree's height.
enum AncientHabit : u8 {
  /// Very tall: a long clear bole, the limbs in the top half, the trunk carrying through to the top
  /// (excurrent), the limbs leaving near level and turning up, a crown about 0.4 of the height wide
  /// — the giant sequoia, an old Douglas-fir.
  emergent
  /// Very wide: a short trunk dissolving into a few great limbs (decurrent) that fork again and
  /// again into a dome about 1.5 times as wide as the tree is tall, where the wood allows it — the
  /// open-grown oak, the monkeypod.
  spreading
  /// The two together, the rarer and the fantastical: an emergent's clear bole carrying a
  /// spreading crown on top, about 0.9 of the height wide (the tropical emergents — kapok,
  /// tualang — come closest).
  mixed
}

/// An ancient tree, the megaflora regime (flora.md, "Megaflora"): a trunk metres thick flaring into
/// buttress roots at its foot, with doorway-sized hollows, and major limbs whose first stretch is a
/// straight run — where platforms go — and which then meander and fork as the habit says, each
/// limb no longer than its wood could carry, down to the allometric crown. Its parts carry the
/// structural table (section 37). Defaults make a 100 m emergent tree; a limb field left at 0 is
/// the habit's.
struct Ancient @version(4) {
  /// Everything left to chance: the buttresses', hollows' and limbs' azimuths, every shoot's turn.
  seed: u64 = 1
  /// The crown's top above the ground: 40 to 150 m.
  height_m: f32 = 100.0 @unit(m)
  /// The trunk's core radius at the ground, inside the buttresses: 2 to 12.5 m (4 to 25 m across).
  trunk_radius_m: f32 = 5.0 @unit(m)
  /// The core's radius at the trunk's top as a share of its radius at the ground: 0.15 to 0.8.
  taper: f32 = 0.4
  /// How far from vertical the trunk stands: 0 to 8 degrees. It is straight.
  lean_deg: f32 = 1.0 @unit(deg)
  /// Buttress roots flaring from the foot: 0 to 12.
  buttresses: u32 = 6
  /// How high up the trunk a buttress runs: 1 to 40 m.
  buttress_height_m: f32 = 10.0 @unit(m)
  /// How far a buttress reaches out at the ground, as a share of the core radius: 0 to 2.5.
  buttress_reach: f32 = 1.1
  /// Doorway-sized hollows in the trunk, between the buttresses: 0 to 3, the first at
  /// `hollow_sill_m`, each next one `hollow_spacing_m` above the last.
  hollows: u32 = 1
  /// A hollow's doorway width: 0.6 to 5 m.
  hollow_width_m: f32 = 1.6 @unit(m)
  /// A hollow's doorway height: 1.2 to 8 m.
  hollow_height_m: f32 = 2.8 @unit(m)
  /// How deep a hollow goes into the trunk, as a share of the core radius there: 0.15 to 0.7.
  hollow_depth: f32 = 0.5
  /// The first hollow's floor above the ground: 0 to 60 m.
  hollow_sill_m: f32 = 0.3 @unit(m)
  /// From one hollow's floor to the next one's: 3 to 60 m.
  hollow_spacing_m: f32 = 14.0 @unit(m)
  /// Major limbs: 2 to 12; 0, the habit's (emergent 10, spreading 6, mixed 7).
  limbs: u32 = 0
  /// The lowest major limb leaves the trunk this high: 8 to 110 m; 0, the habit's share of the
  /// height (emergent 0.5, spreading 0.2, mixed 0.55).
  limb_low_m: f32 = 0.0 @unit(m)
  /// The highest major limb leaves the trunk this high: `limb_low_m` to 0.75 of the height; 0, the
  /// habit's share (emergent 0.75, spreading 0.3, mixed 0.7).
  limb_high_m: f32 = 0.0 @unit(m)
  /// The lowest limb's radius where it leaves the trunk: 0.5 to 2.5 m (1 to 5 m thick; the upper
  /// limbs thinner); 0, the habit's share of the trunk's core there.
  limb_radius_m: f32 = 0.0 @unit(m)
  /// A limb's first run's rise above horizontal: -5 to 30 degrees.
  limb_rise_deg: f32 = 4.0 @unit(deg)
  /// The lowest limb's first run, straight, from inside the trunk (half its core radius out from
  /// the axis): 4 to 60 m, and at least 2 m past the core (the upper limbs' shorter); 0, the
  /// habit's share of the limb. Asked, not promised: a limb is shortened, run and all, until the
  /// wood can carry it (flora.md, "Limbs a wood could carry").
  limb_run_m: f32 = 0.0 @unit(m)
  /// The lowest limb's length past its first run, meandering and forking: 4 to 80 m; 0, what the
  /// habit's crown width leaves. Asked, not promised, like the run.
  limb_reach_m: f32 = 0.0 @unit(m)
  /// Branches on every limb past its run, and on the trunk's top: 2 to 10.
  branches: u32 = 6
  /// A branch's angle from its parent: 15 to 80 degrees.
  branch_angle_deg: f32 = 40.0 @unit(deg)
  /// A branch's length over its limb's reach: 0.2 to 0.9. Its leaders carry it on by
  /// `length_ratio` an order, so a branch system reaches about 1 / (1 - `length_ratio`) of this.
  branch_length: f32 = 0.3
  /// A cap on the laterals a shoot of the recursion bears (it was the sub-branches on every
  /// branch): 1 to 8.
  sub_branches: u32 = 5
  /// A second cap on the same (it was the leafy twigs on every sub-branch): 1 to 12.
  twigs: u32 = 6
  /// The terminal twig's length, a species constant (it was a 5 m leaf-cluster twig): 0.3 to 1.5 m.
  twig_length_m: f32 = 0.8 @unit(m)
  /// How far each shoot past the runs turns towards the light, as a share of 40 degrees: -1 to 1.
  upturn: f32 = 0.5
  /// How far a shoot past the runs wanders from straight at every step: 0 to 20 degrees.
  wander_deg: f32 = 5.0 @unit(deg)
  /// The most leaf cards along each side of a twig (the count is `leaf_area_index`'s): 1 to 60.
  leaves: u32 = 16
  /// A leaf card's length — one leaf at the species' size, never the tree's: 0.05 to 0.6 m.
  leaf_length_m: f32 = 0.3 @unit(m)
  /// A card's angle from its twig, towards the tip: 10 to 85 degrees.
  leaf_angle_deg: f32 = 50.0 @unit(deg)
  /// The most triangles the mesh may have: 20,000 to 4,000,000 (flora.md, "Megaflora").
  triangle_budget: u32 = 1500000
  // ---- allometric branching (G72; flora.md "Allometry", docs/experiments/tree-allometry.md).
  // Past the limbs' runs the crown is a recursion of self-similar orders down to a terminal twig of
  // the species' own size: `branches` is then the limbs' laterals, `sub_branches` and `twigs`
  // caps on a shoot's laterals, `leaves` a cap on a twig's cards a side, and the leaf count comes
  // from `leaf_area_index`.
  /// The terminal twig's radius, a species constant that never scales with the tree (Corner's
  /// rules: a large leaf needs a stout twig): 0.001 to 0.012 m.
  twig_radius_m: f32 = 0.006 @unit(m) @since(2)
  /// The pipe model's exponent: 1.8 to 3.
  area_exponent: f32 = 2.0 @since(2)
  /// Children a shoot of the recursion bears, its leader included: 2 to 6.
  branching_ratio: u32 = 4 @since(2)
  /// A child's length over its parent's: 0.4 to 0.9.
  length_ratio: f32 = 0.63 @since(2)
  /// The leader's share of a node's cross-section: 0.1 to 0.7 (an old crown's apical control is
  /// weak, so the default splits nearly evenly).
  leader_share: f32 = 0.28 @since(2)
  /// One-sided leaf area over the crown's footprint: 0.5 to 10.
  leaf_area_index: f32 = 3.0 @since(2)
  /// A leaf card's width over its length: 0.1 to 1.
  leaf_width: f32 = 0.6 @since(2)
  /// A branch-group card's baked tile, texels a side; 0 bakes no branch-group levels (flora.md, "The
  /// impostor chain"): 0, or 16 to 256.
  card_bake_px: u32 = 64 @since(3)
  /// A whole-tree impostor view, texels a side; 0 makes no impostor: 0, or 32 to 1024.
  impostor_px: u32 = 256 @since(3)
  // ---- the habit and the wood (G79; flora.md "Megaflora", docs/experiments/megaflora-habits.md).
  /// The crown's architecture; the limb fields above left at 0 are its.
  habit: AncientHabit = emergent @since(4)
  /// The crown's width over the tree's height, which sets how far the limbs reach: 0.2 to 2.5; 0,
  /// the habit's (emergent 0.4, spreading 1.5, mixed 0.9). The wood may stop the limbs short.
  crown_spread: f32 = 0.0 @since(4)
  /// How many times a major limb forks past its run: 1 to 4; 0, the habit's (emergent 2,
  /// spreading 3, mixed 3).
  forks: u32 = 0 @since(4)
  /// The green wood's modulus of rupture, which caps how far a limb reaches at its thickness and
  /// angle: 20 to 150 MPa (green white oak about 50).
  wood_rupture_mpa: f32 = 50.0 @since(4)
  /// The green wood's density, water and all: 300 to 1300 kg/m3 (green white oak about 1000).
  wood_density: f32 = 1000.0 @since(4)
}

/// A tiled PBR set a part's material samples (flora.md, "Materials"): the images' paths, relative
/// to the flora file, any of them empty for none, and the set's physical repeat. A set that names
/// an image replaces the material pack's default for its part (docs/subsystems/materials.md).
struct MaterialSet @version(2) {
  base_color: string = ""
  /// Tangent-space normals, OpenGL convention (+Y up), as the material lab writes them.
  normal: string = ""
  roughness: string = ""
  metallic: string = ""
  /// A height map, carried for parallax and for the lab's provenance; the renderer reads none yet.
  height: string = ""
  /// The set's repeat in metres: one tile covers this much surface, 0.05 to 20 m.
  tile_m: f32 = 1.0 @unit(m)
  /// How far the normal map bends the shading normal, glTF's `normalTexture.scale`: 0 to 4.
  normal_scale: f32 = 1.0 @since(2)
}

/// The images a tree's parts sample, any absent for the flat colour (flora.md, "Materials").
struct FloraMaterials @version(1) {
  /// The trunk's and the branches' bark, tiled by `tile_m` round and up them.
  bark: MaterialSet?
  /// A palm's green fronds, or a tree's leaves and needles: one card per image.
  leaf: MaterialSet?
  /// A palm's dead fronds.
  skirt: MaterialSet?
  /// The wood inside the bark: no part shows it until environment destruction cuts a trunk and
  /// needs a cross-section and a cap (flora.md, "Not yet"). Recorded, keyed, and not drawn.
  wood: MaterialSet?
}

// ---- the understory (G75; flora.md "The understory", docs/experiments/understory.md) ----------
//
// The shrub, herb and ground layers under a forest's canopy. Each species carries the detail tier
// a graphics preset may drop its kind at, and the rule that what a preset may drop never collides:
// a shrub whose stems stop a walker is never `rich` (the reader refuses it by name).

/// Which graphics presets keep a kind of plant (flora.md, "Detail tiers"): `essential` on every
/// preset, `standard` on all but the lowest, `rich` only on the highest. A kind whose instances
/// carry a collision body is never `rich`, so dropping one never changes what a walker meets.
enum DetailTier : u8 {
  /// Kept on every preset: trees, and shrubs whose stems collide.
  essential
  /// Dropped only by the lowest presets: shrubs a walker passes through.
  standard
  /// Kept only by the highest presets: ferns, grass tufts and herbs, which never collide.
  rich
}

/// A shrub (flora.md, "The shrub"): a multi-stemmed woody plant branching at the ground — hazel,
/// elder, dogwood, hawthorn — whose basal stems rise from a stool and each grow the allometric
/// recursion (G73) to a terminal twig of the species' size, with leaves at the species' size and
/// their count from the leaf area index. Defaults make a 4 m coppiced hazel of 16 stems.
struct Shrub @version(1) {
  /// Everything left to chance: each stem's azimuth, lean and size, every shoot's turn and wander.
  seed: u64 = 1
  /// The tallest stem's top above the ground: 0.5 to 6 m.
  height_m: f32 = 4.0 @unit(m)
  /// Basal stems from the stool: 1 to 40.
  stems: u32 = 16
  /// The stoutest stem's radius at the ground: 0.003 to 0.08 m (the others down to 0.55 of it), or
  /// 0 for the allometric radius of the height, 0.022 m at 4 m as H ~ r^(2/3). Every stem whose
  /// radius is at least 0.0125 m stops a walker (flora.md, "The shrub").
  stem_radius_m: f32 = 0.0 @unit(m)
  /// The stool's radius, over which the stems' feet stand: 0.02 to 1.5 m.
  stool_radius_m: f32 = 0.25 @unit(m)
  /// How far from vertical the outermost stems leave the stool: 0 to 70 degrees (the inner ones
  /// more upright).
  stem_spread_deg: f32 = 28.0 @unit(deg)
  /// How far each stem turns towards the light along its length, as a share of 40 degrees: -1
  /// (arching canes that bow back to the ground, a bramble's) to 1.
  upturn: f32 = 0.4
  /// How far a shoot wanders from straight at every step: 0 to 25 degrees.
  wander_deg: f32 = 6.0 @unit(deg)
  /// Laterals on every stem, along its upper part: 1 to 12.
  branches: u32 = 6
  /// A stem's first lateral's length over the stem's: 0.1 to 0.8.
  branch_length: f32 = 0.35
  /// A lateral's angle from its parent: 15 to 85 degrees.
  branch_angle_deg: f32 = 40.0 @unit(deg)
  /// The terminal twig's radius, a species constant: 0.0008 to 0.008 m.
  twig_radius_m: f32 = 0.0016 @unit(m)
  /// The terminal twig's length — a season's shoot, a species constant: 0.05 to 1 m.
  twig_length_m: f32 = 0.45 @unit(m)
  /// The pipe model's exponent: 1.8 to 3.
  area_exponent: f32 = 2.0
  /// Children a shoot of the recursion bears, its leader included: 2 to 6.
  branching_ratio: u32 = 4
  /// A child's length over its parent's: 0.4 to 0.9.
  length_ratio: f32 = 0.63
  /// The leader's share of a node's cross-section: 0.1 to 0.7.
  leader_share: f32 = 0.35
  /// One-sided leaf area over the shrub's footprint: 0.5 to 8 (a shrub layer's 1 to 4).
  leaf_area_index: f32 = 2.5
  /// The most leaf cards along each side of a twig: 1 to 30.
  leaves: u32 = 10
  /// A leaf card's length — one leaf, a species constant: 0.02 to 0.3 m.
  leaf_length_m: f32 = 0.1 @unit(m)
  /// A leaf card's width over its length: 0.1 to 1.
  leaf_width: f32 = 0.8
  /// A leaf's angle from its twig, towards the tip: 10 to 85 degrees.
  leaf_angle_deg: f32 = 55.0 @unit(deg)
  /// The most triangles the mesh may have: 4,000 to 400,000.
  triangle_budget: u32 = 30000
  /// The kind's detail tier: `essential` for a shrub whose stems collide (the default hazel's do),
  /// `standard` for one a walker passes through; never `rich` when a stem collides.
  detail_tier: DetailTier = essential
}

/// A fern (flora.md, "The fern"): a crown of pinnate fronds from a rhizome — male fern, lady fern,
/// a bracken frond — each frond a stipe and a rachis carrying pinnae as cards, the longest a little
/// below the middle and shortening to the tip. Defaults make a 0.9 m male fern of 14 fronds.
struct Fern @version(1) {
  /// Everything left to chance: each frond's turn, spread, length and droop.
  seed: u64 = 1
  /// Fronds in the crown: 1 to 40.
  fronds: u32 = 14
  /// A frond's length, stipe and blade: 0.15 to 2.5 m (the youngest down to 0.75 of it).
  frond_length_m: f32 = 0.9 @unit(m)
  /// The bare stipe's share of the frond: 0.05 to 0.5.
  stipe: f32 = 0.22
  /// Pinnae along each side of the blade: 3 to 40.
  pinnae: u32 = 24
  /// The longest pinna's length over the frond's: 0.05 to 0.4.
  pinna_length: f32 = 0.15
  /// A pinna's angle from the rachis, towards the tip: 30 to 90 degrees.
  pinna_angle_deg: f32 = 70.0 @unit(deg)
  /// The crown's cone: the outermost frond leaves the crown this far from vertical, 5 to 85
  /// degrees (the youngest stand nearly upright: a shuttlecock).
  spread_deg: f32 = 50.0 @unit(deg)
  /// How far a frond arches over along its length: 0 straight, 1 its tip turned 90 degrees down.
  droop: f32 = 0.45
  /// The rhizome crown's radius, the ring the fronds rise from: 0.005 to 0.3 m.
  crown_radius_m: f32 = 0.04 @unit(m)
  /// The most triangles the mesh may have: 500 to 100,000.
  triangle_budget: u32 = 4000
  /// The kind's detail tier: a fern never collides, so any; `rich` by default.
  detail_tier: DetailTier = rich
}

/// A grass tuft (flora.md, "The grass tuft"): a bunch of blades from one base — tufted hair-grass,
/// a fescue's tussock — each blade a tapering strip along a curved axis, a part of its own.
/// Defaults make a 0.45 m tuft of 120 blades.
struct Tuft @version(1) {
  /// Everything left to chance: each blade's turn, spread, length and arch.
  seed: u64 = 1
  /// Blades in the tuft: 4 to 400.
  blades: u32 = 120
  /// The longest blade's length: 0.05 to 1.2 m (the others down to 0.6 of it).
  blade_length_m: f32 = 0.45 @unit(m)
  /// A blade's width at its base, tapering to its tip: 0.002 to 0.03 m.
  blade_width_m: f32 = 0.004 @unit(m)
  /// The outermost blade's angle from vertical where it leaves the base: 0 to 80 degrees (the
  /// inner ones more upright).
  spread_deg: f32 = 35.0 @unit(deg)
  /// How far a blade arches over along its length: 0 straight, 1 its tip turned 90 degrees down.
  droop: f32 = 0.5
  /// The base's radius, the ring the blades rise from: 0.002 to 0.3 m.
  base_radius_m: f32 = 0.04 @unit(m)
  /// Rows along a blade: 2 to 8 (the ladder's to lower).
  segments: u32 = 5
  /// Each blade as two crossed strips instead of one: reads from every side at a distance.
  crossed: bool = false
  /// The most triangles the mesh may have: 1,500 to 50,000.
  triangle_budget: u32 = 4000
  /// The kind's detail tier: a tuft never collides, so any; `rich` by default.
  detail_tier: DetailTier = rich
}

/// A herb (flora.md, "The herb"): a stem with leaves and flowers — a meadow flower's single head,
/// a foxglove's spike of bells, a nettle's leafy stem with none. Defaults make a 0.6 m ox-eye
/// daisy-like herb with one white head.
struct Herb @version(1) {
  /// Everything left to chance: the stem's lean and wander, each leaf's turn and size.
  seed: u64 = 1
  /// The stem's top above the ground: 0.1 to 2 m.
  height_m: f32 = 0.6 @unit(m)
  /// The stem's radius at the ground: 0.001 to 0.015 m.
  stem_radius_m: f32 = 0.0025 @unit(m)
  /// How far from vertical the stem leaves the ground: 0 to 30 degrees.
  lean_deg: f32 = 6.0 @unit(deg)
  /// How far the stem wanders from straight at every step: 0 to 20 degrees.
  wander_deg: f32 = 4.0 @unit(deg)
  /// Leaves up the stem: 0 to 40.
  leaves: u32 = 8
  /// Leaves in opposite pairs, each pair turned a right angle from the last (a nettle's), rather
  /// than one at a time on the golden angle.
  opposite: bool = false
  /// The highest leaf's place up the stem, as a share of its height: 0.1 to 0.95.
  leaf_top: f32 = 0.6
  /// The lowest leaf's length: 0.01 to 0.3 m (the upper ones down to half of it).
  leaf_length_m: f32 = 0.07 @unit(m)
  /// A leaf's width over its length: 0.1 to 1.
  leaf_width: f32 = 0.35
  /// A leaf's angle from the stem, towards its top: 20 to 100 degrees.
  leaf_angle_deg: f32 = 55.0 @unit(deg)
  /// Flowers: 0 for none, 1 a single head at the top, more a spike along the top `spike` share.
  /// 0 to 40.
  flowers: u32 = 1
  /// The share of the stem's top a spike of flowers occupies: 0 to 0.8.
  spike: f32 = 0.0
  /// Petal cards round each flower: 3 to 40.
  petals: u32 = 16
  /// A petal's length: 0.004 to 0.08 m.
  petal_length_m: f32 = 0.02 @unit(m)
  /// A petal's width over its length: 0.1 to 1.
  petal_width: f32 = 0.3
  /// A petal's angle from the flower's axis: 10 to 100 degrees (90 a flat head, 25 a bell).
  petal_angle_deg: f32 = 82.0 @unit(deg)
  /// The flower's colour, linear red, green and blue, each 0 to 1.
  flower_red: f32 = 0.85
  flower_green: f32 = 0.85
  flower_blue: f32 = 0.78
  /// The most triangles the mesh may have: 1,000 to 50,000.
  triangle_budget: u32 = 2500
  /// The kind's detail tier: a herb never collides, so any; `rich` by default.
  detail_tier: DetailTier = rich
}

/// A flora file, `<name>.flora.json`: the species and its parameters. A scene's mesh table names
/// one as it names a glTF, and `engine-content flora` builds one into a container; either way the
/// build is keyed by these values (canonicalized: the species' own parameters and the materials,
/// nothing of the species not chosen), the species and the solver's version.
struct FloraFile @version(4) {
  /// The species: "date_palm", "broadleaf", "conifer", "birch", "willow", "orchard", "ancient",
  /// "shrub", "fern", "tuft" or "herb"; the solver reads the parameters of the same name.
  species: string = "date_palm"
  palm: Palm
  broadleaf: Broadleaf @since(2)
  conifer: Conifer @since(2)
  /// The images the parts sample; absent for the flat colours.
  materials: FloraMaterials? @since(2)
  birch: Birch @since(3)
  willow: Willow @since(3)
  orchard: Orchard @since(3)
  ancient: Ancient @since(3)
  shrub: Shrub @since(4)
  fern: Fern @since(4)
  tuft: Tuft @since(4)
  herb: Herb @since(4)
}
