// The village capability's types (ADR-0007, ADR-0027; docs/subsystems/village.md, roadmap G69): the
// scene entry of the placement generator "village", a row-plan village laid out along lanes on the
// scene's ground. ENGINE_WITH_VILLAGE=OFF takes them out of the build with everything else the
// capability owns.
namespace engine.village

/// Which sides of a lane carry a row of plots. "Left" is the side of (-dz, dx) for a lane running
/// (dx, dz), as a ground edit's is (`engine.scene.TerrainEdit`). An enumerator is never renumbered.
enum Rows : u8 {
  /// A two-row street: the rows face each other across the lane.
  Both
  Left
  Right
}

/// One way: the places it passes, and which sides carry plots (village.md, "The ways").
struct Lane @version(1) {
  name: string
  /// Two or more places the way passes, in order, world metres: its ends (where it comes from and
  /// goes to) and any ford or turn it must keep. Between two the way is **found over the ground**,
  /// never ruled: the least-cost path for its slope, wandering by `irregularity`. x and z are read,
  /// y is not (the ground's). Whole millimetres.
  waypoints: worldpos[]
  rows: Rows = Both
}

/// Which way a kit piece's front looks in its mesh's own frame (y up): the side a person uses it
/// from, a cupboard's doors, a chair's seat, a bed's foot. An enumerator is never renumbered.
enum KitFront : u8 {
  PosX
  NegX
  PosZ
  NegZ
}

/// How a kit piece is placed (village.md, "A kit"): against a wall, free on the floor, on a top
/// (a table's, a chest's lid), on a bed, hung on a wall, hung from a joist, in a hearth's recess,
/// beside a hearth, in a yard. The furnisher places the pieces that stand in for its own (`replaces`)
/// and states the class of every row for whoever lays the others.
enum KitClass : u8 {
  Wall
  Free
  Top
  Bed
  Hung
  Joist
  HearthIn
  HearthBy
  Yard
}

/// Which of the furnisher's own pieces a kit piece stands in for (dwellings.md, "Kit pieces"):
/// none, a table between its benches, a settle, a bedstead with its bedding, a chest.
enum KitReplaces : u8 {
  None
  TableSet
  Settle
  Bed
  Chest
}

/// **One row of a kit** (village.md, "A kit"; the forest session's need 113 (b)): a static mesh of
/// the scene's, how it is scaled, the boxes it takes, the way it faces and how it is placed. Every
/// length is in the mesh's own units before `scale`, so a row is read off the mesh as it is.
struct KitPiece @version(1) {
  name: string
  /// The mesh (glTF, GLB or `.clusters`), relative to the scene file's directory.
  mesh: string
  /// Uniform: the mesh's units to metres. A kit piece is never stretched.
  scale: f32 = 1
  /// The mesh's full bounds, x y z, and its foot (what stands on the floor or the wall's line,
  /// x0 z0 x1 z1: a crane's tripod and not its arm); a foot of zeros is the bounds' x and z.
  bounds_min: f32[3]
  bounds_max: f32[3]
  foot: f32[4]
  front: KitFront = NegZ
  placement: KitClass = Wall
  /// The heights its foot may stand at over its floor, metres (a hung piece's rail): 0 and 0 on
  /// the floor.
  height_min_m: f32 = 0 @unit(m)
  height_max_m: f32 = 0 @unit(m)
  replaces: KitReplaces = None
}

/// **The scene generator `village`'s entry** (village.md; docs/experiments/village-plan-grounding.md
/// and village-growth-grounding.md for every default): a village that grew along its ways. The
/// ways are found over the ground between the places they pass, open into a green where they meet,
/// and plots are taken up along them nearest the green first, of uneven frontage and depth, turned
/// to the slope and the sun, with cottages squeezed in later; a house stands on each plot the ground
/// allows, on a pad benched into the ground, facing its way. At `irregularity` 0 the same rules lay
/// out a regular row plan. The treads, the pads and the paths to the doors are ground edits the
/// entry plans (`PlacementGeneratorDesc::plan_ground`) and shapes the entries after it keep off.
struct VillageLayer @version(3) {
  name: string
  /// What every plot's choices are drawn from, with the plot's place in its row.
  seed: u64 = 0
  lanes: Lane[]
  /// The most houses the village stands, 1 to 256, taken in order along the lanes, the two rows
  /// alternating. Under 6 the plan calls itself a hamlet, from 6 a village.
  houses: u32 = 8
  /// The unit plots are laid out in, metres, 4.5 to 6.1: the statute perch of 16.5 ft by default
  /// (a 15 ft, an 18 ft and a 20 ft perch are all attested).
  perch_m: f32 = 5.03 @unit(m)
  /// A plot's frontage on the street, whole perches, each drawn between the two by the seed,
  /// 1 to 12.
  frontage_min_perches: u32 = 2
  frontage_max_perches: u32 = 4
  /// A plot's depth back from the street, whole perches, 2 to 30.
  depth_perches: u32 = 8
  /// Between the fronts of two facing rows, metres, 2 to 40 (a green is a wide street), and the
  /// worn tread along its middle that is benched into the ground and kept bare, 1 to the street's
  /// width.
  street_width_m: f32 = 6.1 @unit(m)
  tread_width_m: f32 = 3 @unit(m)
  /// How far a house's front stands back from its plot's front, metres, 0 to 20.
  setback_m: f32 = 2 @unit(m)
  /// The lane's stations, metres, 0.5 to 8: where its tread's top is read off the ground.
  station_m: f32 = 2 @unit(m)
  /// How far a house's pad reaches past its walls, metres, 0 to 4, and the most the ground may
  /// differ under a house's footprint before its plot is left empty, metres, 0.1 to 10.
  pad_margin_m: f32 = 0.6 @unit(m)
  max_pad_step_m: f32 = 1.5 @unit(m)
  /// The path from a house's door to the lane's tread: its width, metres, 0 (none) to 3.
  path_width_m: f32 = 1.2 @unit(m)
  /// The bare yard before a house's door: how far the trodden ground reaches along the wall each
  /// side of the door, metres, 0 (the path alone) to 6, from the wall to the plot's front. A mask
  /// region the plan writes (village.md, "The wear"); it changes no height and no shape.
  yard_m: f32 = 1.6 @unit(m)
  /// The cut bank and the fill face of the pads, the treads and the paths, rise over run
  /// (`TerrainEdit.bank_slope`, `fill_slope`), 0.1 to 8, and how far each runs before it meets the
  /// ground (`face_m`, `fill_m`), metres, 0.1 to 10.
  bank_slope: f32 = 1
  fill_slope: f32 = 0.5
  face_m: f32 = 1 @unit(m)
  /// **The houses**: the storeys asked of a founding tenement's house, 1 or 2; a cottage's has one.
  /// What a house is beyond that is the house filler's, from the plot and a seed (village.md, "The
  /// house seam").
  storeys: u32 = 2
  /// How far the village grew rather than was laid out, 0 to 1 (village-growth-grounding.md): 0 a
  /// regular row plan (straight ways, no wander in the street's edge or the tread, whole perches
  /// back to back, the entry's depth and setback, no cottages); 1 the most grown (ways that go round
  /// what is no longer there, a tread and a street's edge that wander, frontages and depths a
  /// quarter and 30 % uneven, six tenements in ten split between two households, a gap in one in
  /// seven with a cottage in it, setbacks from 0.15 to 1.85 times the entry's).
  irregularity: f32 = 0.8 @since(2)
  /// The green where the ways meet (or at the first way's middle with one way): how wide the
  /// street opens there, metres, 0 (none) or the street's width to 80; it is a lens twice as long,
  /// the well stands at its middle, the tofts round it face onto it and the cover keeps off it.
  green_m: f32 = 24 @since(2) @unit(m)
  /// Whether a plot is reserved for the church: of the tenements taken in the outer half of the
  /// order, the one on the highest ground, 42 by 24 m.
  church: bool = true @since(2)
  /// Whether a back lane runs behind three or more built tenements of one row.
  back_lanes: bool = true @since(2)
  /// **A kit** (village.md, "A kit"): the scene's own meshes, a row a piece. A row that `replaces`
  /// one of the furnisher's pieces stands in its place in every house where it fits, at the
  /// furnisher's clearances, and that box piece is not drawn; no kit, the boxes. Every row is listed
  /// in each house's description (`engine-content village --describe`).
  kit: KitPiece[] @since(3)
}
