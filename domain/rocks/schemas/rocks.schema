// The rocks capability's own types (ADR-0007, ADR-0027; docs/subsystems/rocks.md). They live with
// the capability, so ENGINE_WITH_ROCKS=OFF takes them out of the build with everything else it
// owns: a build without the capability refuses a `.rock.json` mesh by the mesh-generator registry's
// sentence, and never needs to read one.
namespace engine.rocks

/// What the rock is made of (rocks.md, "The model by type"). The type sets what a recipe leaves to
/// it: how many extra planar facets a boulder is cut by, how round its edges weather, its bedding
/// layers, its surface noise and its colour.
enum RockType : u8 {
  /// Massive, jointed in three near-orthogonal sets: blocky, a few facets, edges weathered round,
  /// a fine granular surface, grey.
  Granite
  /// Bedded: differential retreat and granular loss, warm tan.
  Sandstone
  /// Columnar: vertical joints at sixty degrees make a prism, sharp edges, near black.
  Basalt
  /// Carbonate: solution pockets, worn edges beside fresh fractures, pale.
  Limestone
  /// Fissile sedimentary mudrock: thin, irregular beds and broken plates.
  Shale
  /// Metamorphic slaty cleavage: planar sheets, not sedimentary bedding.
  Slate
  /// Metamorphic, scaly and folded foliation.
  Schist
  /// Metamorphic compositional bands, folded but more massive than schist.
  Gneiss
  /// Massive metamorphic carbonate, susceptible to dissolution.
  Marble
  /// Volcanic glass: smooth conchoidal scars, sharp margins and low roughness.
  Obsidian
}

/// Origin, derived from RockType rather than an independently contradictory recipe field.
enum RockFamily : u8 { Igneous Sedimentary Metamorphic }

/// Offline source-mesh budget scale; runtime cluster LOD is independent.
enum RockQuality : u8 { Low Medium High }

/// Static geological history. Values are artistic process controls, not elapsed years or measured
/// material constants. Optional processes use the type's mixture; an explicit zero disables one.
struct RockGeology @version(1) {
  /// Accumulated exposure, 0 (fresh breaks) to 1 (strongly weathered).
  weathering: f32 = 0.5
  /// Irregular large scars and unequal bed retreat, 0 to 1.
  irregularity: f32 = 0.65
  /// Physical bedding/cleavage spacing, 0 (off) or 0.01 to 20 m; absent uses the type.
  bed_m: f32? @unit(m)
  /// Dip and azimuth of the fabric normal, degrees, -85 to 85 and -180 to 180.
  dip_deg: f32 = 0.0
  azimuth_deg: f32 = 0.0
  /// Fold amplitude as a fraction of the fold wavelength, 0 to 1; absent uses the type.
  fold: f32?
  /// Partial sheet removal / flake scars, 0 to 1; absent uses the type.
  flaking: f32?
  /// Solution pockets, 0 to 1; absent uses the type.
  dissolution: f32?
  /// Granular surface loss, 0 to 1; absent uses the type.
  granular: f32?
}

/// Which shape a rock file makes.
enum RockShape : u8 {
  /// One rock: `boulder`.
  Boulder
  /// A cluster of boulders grown from one bedding plane: `outcrop`.
  Outcrop
  /// A handful of small angular fragments: `scree`.
  Scree
  /// A rock face along the ground, metres to a kilometre long: `cliff` (rocks.md, "Cliffs").
  Cliff
}

/// An authored exterior coating, suppressed where the geometry exposes fresh substrate.
struct RockRind @version(1) {
  /// Coverage on old surfaces, multiplied by geology.weathering; fresh breaks suppress it.
  amount: f32 = 0.8
  /// Linear RGB 0..1; absent uses a brown coating (0.18, 0.12, 0.07).
  tint: f32[3]?
  /// Coating roughness 0.02..1. May be smoother OR rougher than the exposed rock.
  roughness: f32 = 0.9
  /// Grain normal amplitude relative to the uncoated rock, 0..2.
  grain_scale: f32 = 0.6
}

struct RockSurfaceMaps @version(2) {
  /// Total atlas side, one of 256, 512, 1024, 2048. Independent of geometry quality.
  resolution: u32 = 1024
  /// Mineral colour and roughness variation, 0 to 1.
  variation: f32 = 0.55
  /// Grain wavelength, 0.002 to 1 m. Unresolved grain fades out.
  grain_m: f32 = 0.025 @unit(m)
  /// Cross-cutting dielectric mineral veins, 0 (off) to 1.
  veins: f32 = 0.0
  vein_spacing_m: f32 = 0.45 @unit(m)
  vein_width_m: f32 = 0.012 @unit(m)
  /// Linear RGB, separate from body tint; absent uses pale quartz (0.75, 0.72, 0.65).
  vein_tint: f32[3]?
  /// Optional weathered exterior. Colour and roughness are artistic controls, not age in years.
  rind: RockRind? @since(2)
}

/// A tiled PBR set or a unique baked atlas. Image paths are relative to the rock file and
/// replace the material pack's default for `rock/<type>` (docs/subsystems/materials.md).
struct RockMaterial @version(4) {
  base_color: string?
  normal: string?
  roughness: string?
  metallic: string?
  height: string?
  /// One repeat of the set covers this many metres of surface: 0.05 to 20 m.
  tile_m: f32 = 1.0 @unit(m)
  /// How far the normal map bends the shading normal, glTF's `normalTexture.scale`: 0 to 4.
  normal_scale: f32 = 1.0 @since(2)
  /// Linear RGB tint, multiplied with base colour textures; absent uses type colour only when
  /// no base colour image is assigned. Each channel 0 to 1.
  tint: f32[3]? @since(3)
  /// Scalar roughness, 0.02 to 1. Multiplies a roughness map when one is assigned.
  roughness_factor: f32? @since(3)
  /// Optional unique baked PBR atlas, radial shapes only. Cannot combine with image paths.
  surface_maps: RockSurfaceMaps? @since(4)
}

/// Surface structure in metres, shared across an outcrop. These are authoring controls, not
/// measurements of a particular site. Unresolved features fade out with the mesh budget.
struct RockSurface @version(1) {
  /// Blend of this surface field, 0 (off) to 1 (full detail); geology is independent.
  strength: f32 = 1.0
  /// Mean separation of weathered joints, 0.05 to 20 m.
  joint_spacing_m: f32 = 0.65 @unit(m)
  /// Full width of a joint recess, 0.005 m to half the joint spacing.
  joint_width_m: f32 = 0.12 @unit(m)
  /// Maximum joint recess, 0 to 2 m; also limited by the body's radius.
  joint_depth_m: f32 = 0.12 @unit(m)
  /// Largest surface-relief wavelength, 0.02 to 10 m.
  wavelength_m: f32 = 0.4 @unit(m)
  /// Relief amplitude, 0 to 0.5 m, at most a quarter of wavelength_m.
  relief_m: f32 = 0.018 @unit(m)
}

/// A seeded cut body with bedding, physical surface detail and burial (rocks.md, "The boulder").
struct Boulder @version(3) {
  /// Everything the parameters leave to chance. Any u64.
  seed: u64 = 1
  /// The half-extents before cutting, x, y (up) and z: each 0.05 to 20 m.
  size_x: f32 = 1.2 @unit(m)
  size_y: f32 = 0.8 @unit(m)
  size_z: f32 = 1.0 @unit(m)
  type: RockType = Granite
  /// Joint sets that cut the body, each a pair of parallel planes on opposite sides: 0 to 4.
  joint_sets: u32 = 3
  /// How round the cut edges weather, 0 a sharp edge to 1 nearly a pebble; absent takes the type's.
  rounding: f32?
  /// Additional count-based grooves, 0 to 64; absent is off. Geology supplies physical bedding.
  layers: u32?
  /// The share of the body's height under the origin, where the ground is: 0 to 0.8.
  buried: f32 = 0.15
  /// The most triangles the mesh may have: 500 to 500,000. The solver takes the finest rung of
  /// its ladder that fits (rocks.md, "The budget ladder").
  triangle_budget: u32 = 80000
  surface: RockSurface @since(2)
  geology: RockGeology @since(3)
  quality: RockQuality = High @since(3)
  material: RockMaterial
}

/// An outcrop (rocks.md, "The outcrop"): `count` boulders grown from one bedding plane inside the
/// half-extents, sharing one joint set, the largest in the middle, sunk deeper than a boulder, as
/// one mesh.
struct Outcrop @version(3) {
  seed: u64 = 1
  /// The outcrop's half-extents, x, y (up) and z: each 0.2 to 50 m.
  size_x: f32 = 4.0 @unit(m)
  size_y: f32 = 2.0 @unit(m)
  size_z: f32 = 3.0 @unit(m)
  type: RockType = Basalt
  /// Boulders in it: 2 to 16.
  count: u32 = 6
  joint_sets: u32 = 2
  rounding: f32?
  layers: u32?
  /// The share of each boulder's height under the bedding plane: 0 to 0.8.
  buried: f32 = 0.3
  /// The most triangles of every boulder together: 1,000 to 1,000,000.
  triangle_budget: u32 = 240000
  surface: RockSurface @since(2)
  geology: RockGeology @since(3)
  quality: RockQuality = High @since(3)
  material: RockMaterial
}

/// Scree (rocks.md, "Scree"): `count` small angular fragments lying on the ground inside the
/// footprint's half-extents, as one mesh.
struct Scree @version(3) {
  seed: u64 = 1
  /// The footprint's half-extents, x and z: each 0.1 to 20 m.
  size_x: f32 = 1.0 @unit(m)
  size_z: f32 = 1.0 @unit(m)
  type: RockType = Granite
  /// Fragments: 2 to 64.
  count: u32 = 12
  /// The largest fragment's longest half-extent: 0.02 to 2 m; the rest are smaller.
  fragment_m: f32 = 0.2 @unit(m)
  rounding: f32?
  /// The share of each fragment's height under the ground: 0 to 0.8.
  buried: f32 = 0.2
  /// The most triangles of every fragment together: 500 to 500,000.
  triangle_budget: u32 = 24000
  surface: RockSurface @since(2)
  geology: RockGeology @since(3)
  quality: RockQuality = High @since(3)
  material: RockMaterial
}

/// One vertex of a cliff's line along the ground (rocks.md, "Cliffs"), metres from the recipe's
/// origin: `x` and `z` where the face's foot runs, `y` the ground there. `height` and `batter`
/// override the face's own at this vertex, and are interpolated between vertices.
struct CliffPoint @version(1) {
  x: f32 = 0.0 @unit(m)
  y: f32 = 0.0 @unit(m)
  z: f32 = 0.0 @unit(m)
  /// The face's top above `y`: 1 to 200 m; absent, the face's `height`.
  height: f32? @unit(m)
  /// How far the face leans back, metres across per metre up: 0 to 1.5; absent, the face's.
  batter: f32?
}

/// A cliff (rocks.md, "Cliffs"): a rock face along a line on the ground — a sheet of quads along
/// and up the line, carved into blocks by the type's joint sets (ledges where a set is near
/// horizontal, columns where it is vertical), banded by its beds, undercut where a weak bed lies
/// under a hard one, warped and grained — closed at the ends, the top and a back buried `depth`
/// behind it, with a talus skirt of the rock's own debris at its foot. Walking along `points`, the
/// face looks to the right (+z for a line along +x).
struct Cliff @version(2) {
  seed: u64 = 1
  type: RockType = Sandstone
  /// The foot of the face, in order: 2 to 4,096 vertices, a line 1 to 1,000 m long.
  points: CliffPoint[]
  /// The face's top above the ground at its foot: 1 to 200 m (a vertex's `height` overrides it).
  height: f32 = 40.0 @unit(m)
  /// How far the face leans back from vertical, metres across per metre up: 0 to 1.5.
  batter: f32 = 0.1
  /// How far the foot is sunk under the ground: 0 to 20 m.
  buried: f32 = 2.0 @unit(m)
  /// How far behind the face its buried back stands: 2 to 200 m; absent, the deepest the carving
  /// reaches plus 2 m, and never under 4 m.
  depth: f32? @unit(m)
  /// How far a joint block may stand back from the face: 0 to 20 m; absent, the type's.
  relief: f32? @unit(m)
  /// Joint sets that carve the face, in order: horizontal (ledges), vertical (columns), dipping:
  /// 0 to 3.
  joint_sets: u32 = 3
  /// How round the blocks' edges weather, 0 to 1; absent, the type's.
  rounding: f32?
  /// The beds' thickness: 0 (none) or 0.25 to 50 m; absent, the type's.
  bed_m: f32? @unit(m)
  /// How deep a weak bed is notched under the hard bed above it, a share of its thickness, and how
  /// far a block may stand out over the one below: 0 (nothing overhangs) to 1.
  undercut: f32 = 0.0
  /// The talus skirt's height against the face, a share of the face's height: 0 (none) to 0.6.
  talus: f32 = 0.2
  /// The skirt's slope, degrees: 20 to 45.
  talus_angle_deg: f32 = 35.0
  /// Fallen blocks lying on the skirt: 0 to 256.
  talus_blocks: u32 = 12
  /// The largest fallen block's longest half-extent: 0.1 to 10 m; the rest are smaller, the
  /// largest rolled furthest.
  talus_block_m: f32 = 1.5 @unit(m)
  /// The height in the recipe's frame the beds and the horizontal joints are counted from, so
  /// faces cut from one rock mass share their beds: any.
  datum_y: f32 = 0.0 @unit(m)
  /// The most triangles of the face, its skirt and its blocks together: 2,000 to 4,000,000. The
  /// solver takes the finest cell of its ladder that fits (rocks.md, "Cliffs").
  triangle_budget: u32 = 250000
  geology: RockGeology @since(2)
  quality: RockQuality = High @since(2)
  material: RockMaterial
}

/// A rock file, `<name>.rock.json`: the shape and its parameters. Only the shape's own block may
/// be given (absent is its defaults). A scene's mesh table names one as it names a glTF, and
/// `engine-content rocks` builds one into a container; either way the build is keyed by these
/// values (canonicalized) and the solver's version.
struct RockFile @version(2) {
  shape: RockShape = Boulder
  boulder: Boulder?
  outcrop: Outcrop?
  scree: Scree?
  /// A cliff's block; left out of the canonical parameters when absent, so a version-1 file's key
  /// is what it was.
  cliff: Cliff? @since(2)
}

/// A height band of a cliffs layer's rock (rocks.md, "The cliffs generator"): a face whose foot
/// stands below `below_m` (world height) is of `type`; the first band that holds it wins.
struct CliffBand @version(1) {
  below_m: f32 = 0.0 @unit(m)
  type: RockType = Sandstone
}

/// The scene generator `cliffs`' entry (rocks.md, "The cliffs generator"): the steep ground of a
/// region found from the ground's heights, its feet traced into lines and dressed with faces.
struct CliffLayer @version(1) {
  name: string
  seed: u64 = 1
  /// The region dressed, world metres, x and z: a face whose first vertex lies inside is placed.
  region_min: f64[2]
  region_max: f64[2]
  /// The heights' spacing the slope is measured at: 0.5 to 32 m.
  spacing_m: f32 = 4.0 @unit(m)
  /// The tracing grid: a line is traced inside one block of this edge, so a face is a function of
  /// the block's heights alone and the same whichever tile asks: 16 to 4,096 m, a whole number of
  /// spacings.
  block_m: f32 = 256.0 @unit(m)
  /// Steep ground: a slope above this, degrees: 30 to 85.
  min_slope_deg: f32 = 50.0
  /// A line shorter than this is left bare: 4 to 1,000 m.
  min_length_m: f32 = 24.0 @unit(m)
  /// A face lower than this, on average, is left bare: 1 to 200 m.
  min_height_m: f32 = 6.0 @unit(m)
  /// A longer line is cut into faces of at most this: 16 to 1,000 m.
  max_length_m: f32 = 300.0 @unit(m)
  /// How far in front of the steep ground's foot a face stands, so its carving stays proud of the
  /// ground: 0 to 20 m; absent, three quarters of the face's relief.
  standoff_m: f32? @unit(m)
  /// A face is not placed where it comes within this of an earlier placement's footprint: 0 to
  /// 100 m.
  clear_m: f32 = 2.0 @unit(m)
  /// The faces' parameters, all but their lines and heights, which the ground gives.
  face: Cliff
  /// The rock by the height of a face's foot; none, or none that holds it: `face.type`.
  bands: CliffBand[]
  /// Fallen boulders at the faces' feet, beside the skirt's own blocks: a recipe (`.rock.json`, a
  /// glTF) relative to the scene, and how many per 100 m of face. Empty: none.
  foot_mesh: string
  foot_per_100m: f32 = 0.0
  foot_scale_min: f32 = 0.6
  foot_scale_max: f32 = 1.4
  /// Where the faces' recipes are written: relative to the scene; empty, the host's derived-data
  /// root's `cliffs/`, else the repository's, else `cliffs` beside the scene.
  recipes: string
}
