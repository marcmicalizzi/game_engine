// The rocks capability's own types (ADR-0007, ADR-0027; docs/subsystems/rocks.md). They live with
// the capability, so ENGINE_WITH_ROCKS=OFF takes them out of the build with everything else it
// owns: a build without the capability refuses a `.rock.json` mesh by the mesh-generator registry's
// sentence, and never needs to read one.
namespace engine.rocks
import "scene.schema"

/// What the rock is made of (rocks.md, "The model by type"). The type sets what a recipe leaves to
/// it: how many extra planar facets a boulder is cut by, how round its edges weather, its bedding
/// layers, its surface noise and its colour.
enum RockType : u8 {
  /// Massive, jointed in three near-orthogonal sets: blocky, a few facets, edges weathered round,
  /// a fine granular surface, grey.
  Granite
  /// Bedded: differential retreat and granular loss, warm tan.
  Sandstone
  /// Columnar: vertical joints at sixty degrees make a prism, sharp edges, near black.
  Basalt
  /// Carbonate: solution pockets, worn edges beside fresh fractures, pale.
  Limestone
  /// Fissile sedimentary mudrock: thin, irregular beds and broken plates.
  Shale
  /// Metamorphic slaty cleavage: planar sheets, not sedimentary bedding.
  Slate
  /// Metamorphic, scaly and folded foliation.
  Schist
  /// Metamorphic compositional bands, folded but more massive than schist.
  Gneiss
  /// Massive metamorphic carbonate, susceptible to dissolution.
  Marble
  /// Volcanic glass: smooth conchoidal scars, sharp margins and low roughness.
  Obsidian
  /// Resistant metamorphic quartz-rich rock: jointed masses and relict beds.
  Quartzite
  /// Bedded carbonate: blocky ledges with localized solution weathering.
  Dolostone
}

/// Origin, derived from RockType rather than an independently contradictory recipe field.
enum RockFamily : u8 { Igneous Sedimentary Metamorphic }

/// Offline source-mesh budget scale; runtime cluster LOD is independent.
enum RockQuality : u8 { Low Medium High }

/// Static geological history. Values are artistic process controls, not elapsed years or measured
/// material constants. Optional processes use the type's mixture; an explicit zero disables one.
struct RockGeology @version(2) {
  /// Accumulated exposure, 0 (fresh breaks) to 1 (strongly weathered).
  weathering: f32 = 0.5
  /// Irregular large scars and unequal bed retreat, 0 to 1.
  irregularity: f32 = 0.65
  /// Physical bedding/cleavage spacing, 0 (off) or 0.01 to 20 m; absent uses the type.
  bed_m: f32? @unit(m)
  /// Dip and azimuth of the fabric normal, degrees, -85 to 85 and -180 to 180.
  dip_deg: f32 = 0.0
  azimuth_deg: f32 = 0.0
  /// Fold amplitude as a fraction of the fold wavelength, 0 to 1; absent uses the type.
  fold: f32?
  /// Partial sheet removal / flake scars, 0 to 1; absent uses the type.
  flaking: f32?
  /// Solution pockets, 0 to 1; absent uses the type.
  dissolution: f32?
  /// Granular surface loss, 0 to 1; absent uses the type.
  granular: f32?
  /// Where the recipe carries the scene's formation (`Cliff.formation`, W85): true (the default)
  /// takes the beds' dip, azimuth and fold from the field and counts the beds from the world
  /// position, so the face's beds are the terrain's bands; false keeps this block's own `dip_deg`,
  /// `azimuth_deg` and `fold`, an override. Read nowhere without a formation; left out of the
  /// canonical parameters while true, so no key moves for it.
  from_formation: bool = true @since(2)
}

/// Which shape a rock file makes.
enum RockShape : u8 {
  /// One rock: `boulder`.
  Boulder
  /// A cluster of boulders grown from one bedding plane: `outcrop`.
  Outcrop
  /// A handful of small angular fragments: `scree`.
  Scree
  /// A rock face along the ground, metres to a kilometre long: `cliff` (rocks.md, "Cliffs").
  Cliff
}

/// An authored exterior coating, suppressed where the geometry exposes fresh substrate.
struct RockRind @version(1) {
  /// Coverage on old surfaces, multiplied by geology.weathering; fresh breaks suppress it.
  amount: f32 = 0.8
  /// Linear RGB 0..1; absent uses a brown coating (0.18, 0.12, 0.07).
  tint: f32[3]?
  /// Coating roughness 0.02..1. May be smoother OR rougher than the exposed rock.
  roughness: f32 = 0.9
  /// Grain normal amplitude relative to the uncoated rock, 0..2.
  grain_scale: f32 = 0.6
}

struct RockSurfaceMaps @version(2) {
  /// Total atlas side, one of 256, 512, 1024, 2048. Independent of geometry quality.
  resolution: u32 = 1024
  /// Mineral colour, roughness and normal-relief variation, 0 to 1.
  variation: f32 = 0.55
  /// Grain wavelength, 0.002 to 1 m. Unresolved grain fades out.
  grain_m: f32 = 0.025 @unit(m)
  /// Cross-cutting dielectric mineral veins, 0 (off) to 1.
  veins: f32 = 0.0
  vein_spacing_m: f32 = 0.45 @unit(m)
  vein_width_m: f32 = 0.012 @unit(m)
  /// Linear RGB, separate from body tint; absent uses pale quartz (0.75, 0.72, 0.65).
  vein_tint: f32[3]?
  /// Optional weathered exterior. Colour and roughness are artistic controls, not age in years.
  rind: RockRind? @since(2)
}

/// How a tiled set's texels are placed (R131; renderer.md, "Stochastic mesh materials"). `Tiled`
/// repeats the image every `tile_m`; `Stochastic` reads three tiles of a triangle lattice in the
/// UV plane, each at its own random offset, blended so the set's mean and variance hold: no visible
/// repeat over a cliff many times the set's size.
enum RockSampling : u8 {
  Tiled
  Stochastic
}

/// A tiled PBR set or a unique baked atlas. Image paths are relative to the rock file and
/// replace the material pack's default for `rock/<type>` (docs/subsystems/materials.md).
struct RockMaterial @version(5) {
  base_color: string?
  normal: string?
  roughness: string?
  metallic: string?
  height: string?
  /// One repeat of the set covers this many metres of surface: 0.05 to 20 m.
  tile_m: f32 = 1.0 @unit(m)
  /// How far the normal map bends the shading normal, glTF's `normalTexture.scale`: 0 to 4.
  normal_scale: f32 = 1.0 @since(2)
  /// Linear RGB tint, multiplied with base colour textures; absent uses type colour only when
  /// no base colour image is assigned. Each channel 0 to 1.
  tint: f32[3]? @since(3)
  /// Scalar roughness, 0.02 to 1. Multiplies a roughness map when one is assigned.
  roughness_factor: f32? @since(3)
  /// Optional unique baked PBR atlas, radial shapes only. Cannot combine with image paths.
  surface_maps: RockSurfaceMaps? @since(4)
  /// How the set's texels are placed, the recipe's images or the pack's set alike; absent takes the
  /// set's own (a pack role's `sampling`; `Tiled` for the recipe's images), and keeps the recipe's
  /// key what it was.
  sampling: RockSampling? @since(5)
}

/// Surface structure in metres, shared across an outcrop. These are authoring controls, not
/// measurements of a particular site. Unresolved features fade out with the mesh budget.
struct RockSurface @version(1) {
  /// Blend of this surface field, 0 (off) to 1 (full detail); geology is independent.
  strength: f32 = 1.0
  /// Mean separation of weathered joints, 0.05 to 20 m.
  joint_spacing_m: f32 = 0.65 @unit(m)
  /// Full width of a joint recess, 0.005 m to half the joint spacing.
  joint_width_m: f32 = 0.12 @unit(m)
  /// Maximum joint recess, 0 to 2 m; also limited by the body's radius.
  joint_depth_m: f32 = 0.12 @unit(m)
  /// Largest surface-relief wavelength, 0.02 to 10 m.
  wavelength_m: f32 = 0.4 @unit(m)
  /// Relief amplitude, 0 to 0.5 m, at most a quarter of wavelength_m.
  relief_m: f32 = 0.018 @unit(m)
}

/// A seeded cut body with bedding, physical surface detail and burial (rocks.md, "The boulder").
struct Boulder @version(3) {
  /// Everything the parameters leave to chance. Any u64.
  seed: u64 = 1
  /// The half-extents before cutting, x, y (up) and z: each 0.05 to 20 m.
  size_x: f32 = 1.2 @unit(m)
  size_y: f32 = 0.8 @unit(m)
  size_z: f32 = 1.0 @unit(m)
  type: RockType = Granite
  /// Joint sets that cut the body, each a pair of parallel planes on opposite sides: 0 to 4.
  joint_sets: u32 = 3
  /// How round the cut edges weather, 0 a sharp edge to 1 nearly a pebble; absent takes the type's.
  rounding: f32?
  /// Additional count-based grooves, 0 to 64; absent is off. Geology supplies physical bedding.
  layers: u32?
  /// The share of the body's height under the origin, where the ground is: 0 to 0.8.
  buried: f32 = 0.15
  /// The most triangles the mesh may have: 500 to 500,000. The solver takes the finest rung of
  /// its ladder that fits (rocks.md, "The budget ladder").
  triangle_budget: u32 = 80000
  surface: RockSurface @since(2)
  geology: RockGeology @since(3)
  quality: RockQuality = High @since(3)
  material: RockMaterial
}

/// An outcrop (rocks.md, "The outcrop"): `count` boulders grown from one bedding plane inside the
/// half-extents, sharing one joint set, the largest in the middle, sunk deeper than a boulder, as
/// one mesh.
struct Outcrop @version(3) {
  seed: u64 = 1
  /// The outcrop's half-extents, x, y (up) and z: each 0.2 to 50 m.
  size_x: f32 = 4.0 @unit(m)
  size_y: f32 = 2.0 @unit(m)
  size_z: f32 = 3.0 @unit(m)
  type: RockType = Basalt
  /// Boulders in it: 2 to 16.
  count: u32 = 6
  joint_sets: u32 = 2
  rounding: f32?
  layers: u32?
  /// The share of each boulder's height under the bedding plane: 0 to 0.8.
  buried: f32 = 0.3
  /// The most triangles of every boulder together: 1,000 to 1,000,000.
  triangle_budget: u32 = 240000
  surface: RockSurface @since(2)
  geology: RockGeology @since(3)
  quality: RockQuality = High @since(3)
  material: RockMaterial
}

/// Scree (rocks.md, "Scree"): `count` small angular fragments lying on the ground inside the
/// footprint's half-extents, as one mesh.
struct Scree @version(3) {
  seed: u64 = 1
  /// The footprint's half-extents, x and z: each 0.1 to 20 m.
  size_x: f32 = 1.0 @unit(m)
  size_z: f32 = 1.0 @unit(m)
  type: RockType = Granite
  /// Fragments: 2 to 64.
  count: u32 = 12
  /// The largest fragment's longest half-extent: 0.02 to 2 m; the rest are smaller.
  fragment_m: f32 = 0.2 @unit(m)
  rounding: f32?
  /// The share of each fragment's height under the ground: 0 to 0.8.
  buried: f32 = 0.2
  /// The most triangles of every fragment together: 500 to 500,000.
  triangle_budget: u32 = 24000
  surface: RockSurface @since(2)
  geology: RockGeology @since(3)
  quality: RockQuality = High @since(3)
  material: RockMaterial
}

/// One vertex of a cliff's line along the ground (rocks.md, "Cliffs"), metres from the recipe's
/// origin: `x` and `z` where the face's foot runs, `y` the ground there. `height` and `batter`
/// override the face's own at this vertex, and are interpolated between vertices.
struct CliffPoint @version(1) {
  x: f32 = 0.0 @unit(m)
  y: f32 = 0.0 @unit(m)
  z: f32 = 0.0 @unit(m)
  /// The face's top above `y`: 1 to 200 m; absent, the face's `height`.
  height: f32? @unit(m)
  /// How far the face leans back, metres across per metre up: 0 to 1.5; absent, the face's.
  batter: f32?
}

/// Terrain heights below a cliff's debris, sampled in its local x/z frame, rows of x in z.
struct CliffGround @version(1) {
  /// Points along each axis: 2..2049, at most 1,048,576 samples total.
  width: u32 = 2
  depth: u32 = 2
  /// Grid interval in metres: 0.25..32.
  spacing_m: f32 = 1.0
  min_x_m: f32 = 0.0
  min_z_m: f32 = 0.0
  /// Exactly width * depth finite heights, metres relative to the recipe origin.
  heights: f32[]
}

/// A cliff (rocks.md, "Cliffs"): a rock face along a line on the ground — a sheet of quads along
/// and up the line, carved into blocks by the type's joint sets (ledges where a set is near
/// horizontal, columns where it is vertical), banded by its beds, undercut where a weak bed lies
/// under a hard one, warped and grained — closed at the ends, the top and a back buried `depth`
/// behind it, with a talus skirt of the rock's own debris at its foot. Walking along `points`, the
/// face looks to the right (+z for a line along +x).
struct Cliff @version(6) {
  seed: u64 = 1
  type: RockType = Sandstone
  /// The foot of the face, in order: 2 to 4,096 vertices, a line 1 to 1,000 m long.
  points: CliffPoint[]
  /// The face's top above the ground at its foot: 1 to 200 m (a vertex's `height` overrides it).
  height: f32 = 40.0 @unit(m)
  /// How far the face leans back from vertical, metres across per metre up: 0 to 1.5.
  batter: f32 = 0.1
  /// How far the foot is sunk under the ground: 0 to 20 m.
  buried: f32 = 2.0 @unit(m)
  /// How far behind the face its buried back stands: 2 to 200 m; absent, the deepest the carving
  /// reaches plus 2 m, and never under 4 m.
  depth: f32? @unit(m)
  /// How far a joint block may stand back from the face: 0 to 20 m; absent, the type's.
  relief: f32? @unit(m)
  /// Joint sets that carve the face, in order: horizontal (ledges), vertical (columns), dipping:
  /// 0 to 3.
  joint_sets: u32 = 3
  /// How round the blocks' edges weather, 0 to 1; absent, the type's.
  rounding: f32?
  /// The beds' thickness: 0 (none) or 0.25 to 50 m; absent, the type's.
  bed_m: f32? @unit(m)
  /// How deep a weak bed is notched under the hard bed above it, a share of its thickness, and how
  /// far a block may stand out over the one below: 0 (nothing overhangs) to 1.
  undercut: f32 = 0.0
  /// The talus skirt's height against the face, a share of the face's height: 0 (none) to 0.6.
  talus: f32 = 0.08
  /// The skirt's slope, degrees: 20 to 45.
  talus_angle_deg: f32 = 35.0
  /// Fallen blocks lying on the skirt: 0 to 256.
  talus_blocks: u32 = 12
  /// The largest fallen block's longest half-extent: 0.1 to 10 m; the rest are smaller, the
  /// largest rolled furthest.
  talus_block_m: f32 = 1.5 @unit(m)
  /// The height in the recipe's frame the beds and the horizontal joints are counted from, so
  /// faces cut from one rock mass share their beds: any.
  datum_y: f32 = 0.0 @unit(m)
  /// The most triangles of the face, its skirt and its blocks together: 2,000 to 4,000,000. The
  /// solver takes the finest cell of its ladder that fits (rocks.md, "Cliffs").
  triangle_budget: u32 = 250000
  geology: RockGeology @since(2)
  quality: RockQuality = High @since(2)
  /// Optional sampled terrain beneath the skirt and fallen blocks, in the recipe's frame.
  /// The cliffs placement generator fills this; standalone recipes may supply it explicitly.
  ground: CliffGround? @since(3)
  /// Share of each deposition interval occupied by debris: 0.1..1; 1 gives a continuous apron.
  talus_coverage: f32 = 0.6 @since(4)
  /// Average along-cliff interval between deposits, metres: 2..100.
  talus_patch_m: f32 = 14.0 @since(4)
  material: RockMaterial
  /// The scene's formation (`engine.scene.Formation`, W85; rocks.md, "Geology"), copied in by
  /// whoever places the face: with it (and `geology.from_formation`), the beds are the field's,
  /// evaluated at `world_origin` plus the recipe's point. Absent: the face-local beds, as before;
  /// left out of the canonical parameters then, with `world_origin`.
  formation: engine.scene.Formation? @since(5)
  /// Where the recipe's origin stands in the world, metres: read only with `formation`.
  world_origin: worldpos @since(5)
  /// No back and no bottom (rocks.md, "Faces in the slope"): a face that stands in a slope shows
  /// neither, and a closed box spends over half its triangles on them. The front, the top and the
  /// ends remain and share their borders. The cliffs generator sets it; false is the closed box a
  /// face on open ground needs.
  open: bool = false @since(6)
}

/// A rock file, `<name>.rock.json`: the shape and its parameters. Only the shape's own block may
/// be given (absent is its defaults). A scene's mesh table names one as it names a glTF, and
/// `engine-content rocks` builds one into a container; either way the build is keyed by these
/// values (canonicalized) and the solver's version.
struct RockFile @version(2) {
  shape: RockShape = Boulder
  boulder: Boulder?
  outcrop: Outcrop?
  scree: Scree?
  /// A cliff's block; left out of the canonical parameters when absent, so a version-1 file's key
  /// is what it was.
  cliff: Cliff? @since(2)
}

/// A height band of a cliffs layer's rock (rocks.md, "The cliffs generator"): a face whose foot
/// stands below `below_m` (world height) is of `type`; the first band that holds it wins.
struct CliffBand @version(1) {
  below_m: f32 = 0.0 @unit(m)
  type: RockType = Sandstone
}

/// The scene generator `cliffs`' entry (rocks.md, "The cliffs generator"): the steep ground of a
/// region found from the ground's heights, its feet traced into lines and dressed with faces.
struct CliffLayer @version(2) {
  name: string
  seed: u64 = 1
  /// The region dressed, world metres, x and z: a face whose first vertex lies inside is placed.
  region_min: f64[2]
  region_max: f64[2]
  /// The heights' spacing the slope is measured at: 0.5 to 32 m.
  spacing_m: f32 = 4.0 @unit(m)
  /// The tracing grid: a line is traced inside one block of this edge, so a face is a function of
  /// the block's heights alone and the same whichever tile asks: 16 to 4,096 m, a whole number of
  /// spacings.
  block_m: f32 = 256.0 @unit(m)
  /// Steep ground: a slope above this, degrees: 30 to 85.
  min_slope_deg: f32 = 50.0
  /// A line shorter than this is left bare: 4 to 1,000 m.
  min_length_m: f32 = 24.0 @unit(m)
  /// A face lower than this, on average, is left bare: 1 to 200 m.
  min_height_m: f32 = 6.0 @unit(m)
  /// A longer line is cut into faces of at most this: 16 to 1,000 m.
  max_length_m: f32 = 300.0 @unit(m)
  /// How far in front of the steep ground's foot a face stands, so its carving stays proud of the
  /// ground: 0 to 20 m; absent, three quarters of the face's relief.
  standoff_m: f32? @unit(m)
  /// A face is not placed where it comes within this of an earlier placement's footprint: 0 to
  /// 100 m.
  clear_m: f32 = 2.0 @unit(m)
  /// The faces' parameters, all but their lines and heights, which the ground gives.
  face: Cliff
  /// The rock by the height of a face's foot; none, or none that holds it: `face.type`.
  bands: CliffBand[]
  /// Fallen boulders at the faces' feet, beside the skirt's own blocks: a recipe (`.rock.json`, a
  /// glTF) relative to the scene, and how many per 100 m of face. Empty: none.
  foot_mesh: string
  foot_per_100m: f32 = 0.0
  foot_scale_min: f32 = 0.6
  foot_scale_max: f32 = 1.4
  /// Where the faces' recipes are written: relative to the scene; empty, the host's derived-data
  /// root's `cliffs/`, else the repository's, else `cliffs` beside the scene.
  recipes: string
  /// The scene's formation (`engine.scene.Formation`, W85), repeated here because a placement
  /// generator is handed its own entry and the ground, not the scene (rocks.md, "The cliffs
  /// generator"): with it every face's recipe carries the field and its own world origin, so the
  /// faces' beds are the terrain's bands. Absent: the faces keep their own bedding, as before.
  formation: engine.scene.Formation? @since(2)
  /// Faces that sit in the slope (G142; rocks.md, "Faces in the slope"): a face's ends are sunk
  /// into the ground over this many metres of its line, so it ends with the steep ground instead
  /// of in a capped wall: 0 (the ends stand) to 100 m.
  taper_m: f32 = 16.0 @since(2) @unit(m)
  /// A face in tiers (rocks.md, "A face in tiers"): a steep band taller than this is cut into
  /// tiers about this high, each following its own part of the slope's profile with its top in
  /// the ground behind it, so a convex slope is covered and no top stands proud: 3 to 200 m. A
  /// break is a bedding plane of `formation` where a resistant bed's top is within a third of
  /// this, else a level.
  tier_m: f32 = 12.0 @since(2) @unit(m)
}

/// Where bedrock shows through a soil mantle (G142; rocks.md, "Exposed bedrock (G142)"; the grounding,
/// docs/experiments/exposed-bedrock.md). The ground's slope and convexity are measured by central
/// differences `scale_m` either side of a point, from heights in whole millimetres.
struct ExposureRule @version(1) {
  /// Under this slope the soil mantle is whole and nothing crops out, degrees: 5 to 60 (30:
  /// DiBiase, Heimsath and Whipple 2012, little rock below a 30 degree mean slope).
  soil_slope_deg: f32 = 30.0 @unit(deg)
  /// Past this slope no soil is held and a resistant bed stands to its full thickness, degrees:
  /// above `soil_slope_deg`, to 80 (45: the same source, no soil-covered slope steeper).
  rock_slope_deg: f32 = 45.0 @unit(deg)
  /// The convexity (minus the Laplacian of the height, 1/m) at which a nose's soil thins to
  /// nothing: 0.002 to 1 (0.03: Heimsath et al. 1997's production function and diffusivity).
  critical_curvature: f32 = 0.03
  /// The differences' arm, metres: 1 to 32, a whole number of the patch's cells.
  scale_m: f32 = 4.0 @unit(m)
  /// A bed stands as a ledge only at or above this resistance: 0 to 1.
  min_resistance: f32 = 0.5
  /// The soil's patches, metres: 0 (none: a resistant bed past the soil slope shows along its
  /// whole trace) or 2 to 200. Rock shows where the exposure fraction is above a seeded field of
  /// this size, so the fraction is the share of the ground that is rock (DiBiase's index).
  patch_m: f32 = 12.0 @unit(m)
  /// Outcrops, not stripes (rocks.md, "Outcrops, not stripes"): a second, longer scale of cover
  /// drawn for each member on its own, so a member's beds crop out together as a crag about this
  /// long and stay under the soil between crags, metres: 0 (none) or 8 to 2,000 (32: well under
  /// the 100 m few continuous outcrops pass, Marshall and Roering 2014).
  stretch_m: f32 = 32.0 @unit(m)
  /// The share of a member's trace where it may crop out: 0.05 to 1.
  stretch_share: f32 = 0.4
  /// Members: resistant beds stand only inside a cliff-forming member. Where the formation has
  /// `macro_beds` the member is the macro bed at the bed's coordinate, by its resistance; where
  /// it has none the rule groups the sequence itself, a seeded field along the bed coordinate this
  /// many metres across: 0 (none: every resistant bed may crop out) or 2 to 500.
  member_m: f32 = 12.0 @unit(m)
  /// The share of the sequence that is cliff-forming, when the grouping is the rule's own: 0.05
  /// to 1.
  member_share: f32 = 0.5
}

/// One tile's ledges at one form, written by the `ledges` generator as
/// `ledge-<hash>.ledge.json` (rocks.md, "Exposed bedrock (G142)"): the ground's heights over the tile and
/// an apron, the formation and the rule, from which the mesh is a pure function.
struct LedgePatch @version(1) {
  seed: u64 = 1
  type: RockType = Sandstone
  formation: engine.scene.Formation
  rule: ExposureRule
  /// The patch's corner, whole millimetres of the world: the mesh's origin, and what the heights
  /// are counted from.
  x_mm: i64 = 0
  y_mm: i64 = 0
  z_mm: i64 = 0
  /// The lattice's spacing, whole millimetres: 250 to 16,000.
  cell_mm: u32 = 1000
  /// Cells a side: 1 to 256.
  cells: u32 = 64
  /// Lattice points of apron round the cells, `rule.scale_m` over the spacing: 1 to 64.
  apron: u32 = 4
  /// `(cells + 1 + 2 apron)^2` heights in whole millimetres above `y_mm`, rows of x in order of z.
  heights_mm: i32[]
  /// The far form: one face a step, no joint blocks, no bed rows.
  far: bool = false
  /// A unit's thickness over its joint spacing: 0.5 to 4 (1.3: Narr and Suppe 1991).
  joint_ratio: f32 = 1.3
  /// The tallest step, metres: 0.2 to 30; a thicker unit's front stands this high.
  max_step_m: f32 = 4.0 @unit(m)
  /// A step lower than this is left under the soil, metres: 0.02 to 5.
  min_step_m: f32 = 0.15 @unit(m)
  /// How far a front goes on under the ground at its foot, metres: 0.05 to 5.
  bury_m: f32 = 0.5 @unit(m)
  /// How far a row's edge may stand back under the row above it, metres: 0 to 2.
  relief_m: f32 = 0.25 @unit(m)
  /// Ground at or past this slope is left to the `cliffs` generator's faces, degrees: 0 (none)
  /// or 30 to 85.
  cliff_slope_deg: f32 = 0.0 @unit(deg)
  material: RockMaterial
  /// What a tread carries to its lip (rocks.md, "Treads"): soil, drawn in this linear colour,
  /// each channel 0 to 1; absent, a dark turf. The fronts and the worn edges are the rock.
  tread_tint: f32[3]?
}

/// The scene generator `ledges`' entry (G142; rocks.md, "Exposed bedrock (G142)"): the resistant beds of
/// a formation standing out of a soil-mantled slope as ledges, a merged mesh a tile and form.
struct LedgeLayer @version(1) {
  name: string
  seed: u64 = 1
  /// The region dressed, world metres, x and z; a tile is dressed when its corner lies inside.
  region_min: f64[2]
  region_max: f64[2]
  type: RockType = Sandstone
  /// The scene's formation, repeated (as `CliffLayer.formation`): required.
  formation: engine.scene.Formation?
  rule: ExposureRule
  /// The near form's lattice, metres: 0.25 to 8, dividing the world's tile and `rule.scale_m`.
  cell_m: f32 = 1.0 @unit(m)
  /// The far form's: `cell_m` to 16, dividing the tile; `rule.scale_m` is a whole number of it or
  /// it is the scale itself.
  far_cell_m: f32 = 4.0 @unit(m)
  /// How many of the world's rings, innermost first, draw the near form: 0 to 8.
  near_rings: u32 = 1
  /// How many draw either form; further rings draw nothing (the terrain's bands carry the beds):
  /// `near_rings` to 8.
  far_rings: u32 = 3
  /// The far form leaves out a step lower than this, metres: 0.02 to 30.
  far_min_step_m: f32 = 0.8 @unit(m)
  joint_ratio: f32 = 1.3
  max_step_m: f32 = 4.0 @unit(m)
  min_step_m: f32 = 0.15 @unit(m)
  bury_m: f32 = 0.5 @unit(m)
  relief_m: f32 = 0.25 @unit(m)
  /// Ground at or past this slope is left to the `cliffs` generator's faces (its
  /// `min_slope_deg`), degrees: 0 (none) or 30 to 85.
  cliff_slope_deg: f32 = 0.0 @unit(deg)
  material: RockMaterial
  /// What a tread carries to its lip: `LedgePatch.tread_tint`.
  tread_tint: f32[3]?
  /// Where the patches' recipes are written: relative to the scene; empty, the host's
  /// derived-data root's `ledges/`, else the repository's, else `ledges` beside the scene.
  recipes: string
}

/// One fallen block of a deposit patch (G143; rocks.md, "What a face sheds"): a block shed
/// from the face above, or one of a cone's largest, as geometry of the patch's own mesh, never an
/// instance. Local metres from the patch's corner; `y_m` is the ground under its centre.
struct DepositBlock @version(1) {
  x_m: f32 = 0.0 @unit(m)
  y_m: f32 = 0.0 @unit(m)
  z_m: f32 = 0.0 @unit(m)
  /// Half-extents, 0.02..4 m: x and z across, y the thickness (across the bedding it broke along).
  half: f32[3]
  yaw: f32 = 0.0
  /// The share of its height under the ground, 0..0.9 (its age: fresh blocks sit high).
  buried: f32 = 0.3
  /// The ground's gradient under it (rise over run in x and z), what it is sheared to rest on.
  slope: f32[2]
  seed: u64 = 1
}

/// A terrain-fitted sediment patch, written by deposits as <hash>.deposit.json.
/// Heights and depths are sampled at vertices; all lengths are local metres.
struct DepositPatch @version(2) {
  seed: u64 = 1
  type: RockType = Granite
  /// Grid points per axis, 2..65, with exactly width*depth values in each array.
  width: u32 = 2
  depth: u32 = 2
  /// Metres between samples, 0.25..8; patch span must not exceed 32 m.
  spacing_m: f32 = 1.0 @unit(m)
  ground: f32[]
  /// Nonnegative deposit thickness, 0..20 m. Zero denotes bare substrate.
  thickness: f32[]
  /// Coarse rockfall share, 0..1; zero is channel sediment and gravel.
  coarse: f32[]
  /// Number of visible representative fragments, 0..4096 (not a grain inventory).
  fragments: u32 = 96
  /// Largest fragment half-length, 0.02..2 m, no larger than half spacing_m.
  fragment_m: f32 = 0.4 @unit(m)
  /// Whole patch surface plus all fragments, 500..1,000,000 triangles.
  triangle_budget: u32 = 32000
  material: RockMaterial
  /// G143: the fallen blocks whose centres stand in this patch, 0..1024; empty is none and is left
  /// out of the canonical bytes, so a patch without them keeps the key it had.
  blocks: DepositBlock[] @since(2)
  /// Triangles each block is built at, 192..12288: the finest cube-grid rung that fits.
  block_triangles: u32 = 432 @since(2)
  /// G143: per sample, 0..2 m, how far a bare sample's bed top stands below the ground: the plan's
  /// signed edge field past the outline, and a bare rim on steep ground. Empty: none.
  sink: f32[] @since(2)
  /// G143: per sample, the bed top's gradient (rise over run in x, then z) from the plan, so a
  /// patch's normals are its neighbours' at a shared border. Empty: from the patch's own samples.
  slope: f32[] @since(2)
}

/// A formation bed's rock (G143): a bed of the deposit layer's `formation` named `bed` sheds `type`.
/// A bed no row names sheds the rock its name spells (`Limestone`, any case), else `patch.type`.
struct DepositLithology @version(1) {
  bed: string
  type: RockType = Granite
}

/// Static deposition authoring over a finite terrain window; not a hazard or fluid simulation.
/// Version 2 (G143) replaces version 1's capped apron (`talus_depth_m`, removed; a migration drops
/// it, and a layer that set it to zero asked for no talus, `supply_m` 0) with one supply rule: what
/// lies at a face's foot is what the face shed, a cone under a gully and a sheet under a planar
/// face; and adds the blocks shed below the faces and the formation's lithology.
struct DepositLayer @version(2) {
  seed: u64 = 1
  /// World metres, finite within +/-1e8; max exceeds min, aligned to spacing_m.
  region_min: f64[2]
  region_max: f64[2]
  /// Terrain sample interval, 0.25..8 m; no more than max_samples grid vertices.
  spacing_m: f32 = 1.0 @unit(m)
  /// Patch edge, 1..32 m, at least spacing_m; divides the world tile and is a whole number of spacings.
  patch_m: f32 = 8.0 @unit(m)
  /// Explicit working-grid budget, 4..1,048,576 vertices. Excess is refused.
  max_samples: u32 = 262144
  /// Rockfall-source slope, 40..85 degrees, above repose_deg.
  source_deg: f32 = 50.0
  /// A deposit's upper slope, 25..40 degrees (Francou and Mante's talus, 34-36).
  repose_deg: f32 = 35.0
  /// Maximum travel of a deposit's surface from its apex, 1..1000 m.
  runout_m: f32 = 40.0 @unit(m)
  /// Catchment area required for channel deposits, 1..1e6 square metres.
  channel_area_m2: f32 = 24.0
  /// Channel deposition permitted below this slope, 1..30 degrees.
  channel_deg: f32 = 12.0
  /// Maximum fine-sediment thickness, 0..2 m; zero disables channel deposits.
  sediment_depth_m: f32 = 0.12 @unit(m)
  /// Respect earlier placement footprints. Disable explicitly when earlier entries are source cliffs.
  avoid_earlier: bool = true
  /// Clearance beyond earlier footprints, 0..100 m; overlapping patches are omitted.
  clear_m: f32 = 0.0 @unit(m)
  /// Patch geometry and material defaults; sampled arrays and dimensions are replaced.
  patch: DepositPatch
  /// G143: the rock wall's retreat since the ice left, 0..50 m: a foot's deposit holds the face
  /// area routed to it times this (rocks.md, "What a face sheds"). 3.5 m is Mohadjer et al.'s
  /// (2020) 0.27-0.38 mm a year from talus volumes over 11,000 years; zero, no rockfall deposit.
  supply_m: f32 = 3.5 @unit(m) @since(2)
  /// A deposit's lower profile eases from `repose_deg` to this, 20..repose_deg (the 31-34 degree
  /// concave toe).
  toe_deg: f32 = 31.0 @since(2)
  /// The run-out of shed blocks: none past the line `shadow_deg` (15..45; Evans and Hungr's
  /// minimum shadow angle, 27.5) below the top of the talus beneath its face.
  shadow_deg: f32 = 27.5 @since(2)
  /// Shed blocks per 100 square metres at the talus' top, 0..400 (authored against the reels: no
  /// published density was found). The count falls as exp(-d / `block_decay_m`) (1..500 m) with
  /// the distance past the talus' top.
  blocks_per_100m2: f32 = 20.0 @since(2)
  block_decay_m: f32 = 12.0 @unit(m) @since(2)
  /// The source's joint spacing, the mean edge of a block, 0.1..6 m; the largest travel farthest.
  block_m: f32 = 1.0 @unit(m) @since(2)
  /// The buried share of a block's height by its age, 0..0.9, min at most max.
  buried_min: f32 = 0.15 @since(2)
  buried_max: f32 = 0.5 @since(2)
  /// The world's formation, when the deposits read it: a deposit sheds the rock of the bed at the
  /// face above it (`lithology`), and a block is no thicker than that bed.
  formation: engine.scene.Formation? @since(2)
  lithology: DepositLithology[] @since(2)
}
