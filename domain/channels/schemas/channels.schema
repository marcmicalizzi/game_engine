// The channels capability's types (ADR-0007, ADR-0027; docs/subsystems/channels.md): the scene
// entry of the placement generator "channels" and the recipe of one placed piece, which the mesh
// generator "channel" builds. ENGINE_WITH_CHANNELS=OFF takes them out of the build with everything
// else the capability owns.
namespace engine.channels

/// What a piece's mesh dresses: the bed's gravel skin, the bars of finer sediment on it, or the
/// cut-soil banks along its edges (channels.md, "What it places").
enum ChannelPart : u8 {
  Bed
  Bar
  Bank
  /// A step's boulders (W90): a row of domes across the bed at a step-pool or cascade reach's crest.
  Boulder
}

/// **A reach's morphology** (Montgomery & Buffington 1997; channels.md, "Reaches"; W90), from the
/// bed's smoothed slope: the code each `WaterChannel` point's `reach` carries (0 to 6, in this order).
/// Bars on dune-ripple and pool-riffle reaches; boulder steps on step-pool and cascade; nothing laid
/// on bedrock and colluvial reaches, where the cut's faces alone are the channel.
enum ChannelReach : u8 {
  DuneRipple
  PoolRiffle
  PlaneBed
  StepPool
  Cascade
  Bedrock
  Colluvial
}

/// How a part's set places its texels (R131): repeated every `tile_m`, or read at three tiles of
/// the hex lattice so no repeat shows.
enum ChannelSampling : u8 {
  Tiled
  Stochastic
}

/// One part's look: the material pack's role it samples, the size of a repeat, and the flat
/// colour and roughness it draws with where the pack has no set for the role.
struct ChannelSurface @version(1) {
  /// The pack's role (`rock/granite`). Empty: the part's own list of roles, the first the pack
  /// has (channels.md, "Materials").
  role: string
  /// One repeat covers this many metres: 0.05 to 20 m; absent, the part's own (the bed 0.35 m, so a
  /// rock set reads at a gravel's scale; the bars 0.8 m; the banks 1.5 m).
  tile_m: f32? @unit(m)
  sampling: ChannelSampling = Stochastic
  /// Linear base colour, each channel 0 to 1; absent, the part's own.
  color: f32[3]?
  /// 0.02 to 1.
  roughness: f32 = 0.9
  /// Linear RGB the pack's set is multiplied by, each channel 0 to 1; absent, the part's own (the
  /// bed 0.62, 0.60, 0.56, a rock set darkened toward wet-worn gravel; the banks 0.8, 0.75, 0.7;
  /// the bars none).
  tint: f32[3]?
}

/// The scene generator `channels`' entry (channels.md, "The network"): the drainage of a region's
/// ground found on a lattice, its channels traced from their heads down, and their beds, bars and
/// banks laid along the trough the ground already holds. Every number's source and range is in
/// docs/experiments/channels.md. Version 2 (W89): the ground is cut (`bank_slope`; the terrain's
/// `cuts`, written by `engine-content channels`), the bed and bars lie in the cut, and no bank
/// piece is placed: the banks are the cut's faces.
/// Version 4 (W91): steps on step-pool reaches alone with risers at `riser_angle_deg`, boulder
/// clusters on cascades, knickpoints on the ground's profile, the chute's steepest fall, and every
/// point of the line held in its trough.
struct ChannelLayer @version(4) {
  name: string
  seed: u64 = 1
  /// The region drained, world metres, x and z, each a whole number of spacings.
  region_min: f64[2]
  region_max: f64[2]
  /// The lattice the flow is routed on: 1 to 32 m, whole millimetres.
  spacing_m: f32 = 4.0 @unit(m)
  /// The most lattice points the region may hold: 4 to 16,777,216.
  max_samples: u32 = 4194304
  /// A channel begins where contributing area times slope to `head_slope_exponent` reaches this
  /// (Montgomery & Dietrich 1988): 10 to 1,000,000 m².
  head_threshold_m2: f32 = 1500.0
  /// The slope's exponent in that product: 0 (area alone) to 3.
  head_slope_exponent: f32 = 1.0
  /// And never with less contributing area than this, whatever the slope: 0 to 1,000,000 m².
  min_head_area_m2: f32 = 3000.0
  /// Bankfull width `a (A / 1 km²)^b` (Leopold & Maddock 1953; Dunne & Leopold 1978): a 0.1 to
  /// 100 m, b 0.1 to 0.8.
  width_at_km2_m: f32 = 3.0 @unit(m)
  width_exponent: f32 = 0.4
  /// Bankfull depth `c (A / 1 km²)^f`: c 0.02 to 10 m, f 0.1 to 0.8.
  depth_at_km2_m: f32 = 0.3 @unit(m)
  depth_exponent: f32 = 0.3
  /// The traced line is low-passed with a Gaussian of sigma `max(smooth_min_m, smooth_widths w)`:
  /// 0 to 100 m and 0 to 10 widths.
  smooth_min_m: f32 = 6.0 @unit(m)
  smooth_widths: f32 = 2.0
  /// Meander wavelength `wavelength_widths w^1.01` and full amplitude `amplitude_coeff w^1.1`
  /// (Leopold, Wolman & Miller 1964): 4 to 30, and 0 to 10 (0: no meanders).
  meander_wavelength_widths: f32 = 10.9
  meander_amplitude_coeff: f32 = 2.7
  /// Meanders fade from full below `meander_slope_min` to none above `meander_slope_max`
  /// (Montgomery & Buffington 1997): 0 to 0.5, min below max.
  meander_slope_min: f32 = 0.01
  meander_slope_max: f32 = 0.04
  /// The bed's rhythm along the line: pool to pool in widths, 2 to 20 (Leopold et al. 1964), and
  /// the riffle's rise over the pool as a fraction of the depth, 0 to 1.
  pool_riffle_widths: f32 = 6.0
  riffle_rise: f32 = 0.2
  /// Above `meander_slope_max` the rhythm is step to step, in widths: 1 to 10 (Montgomery &
  /// Buffington 1997).
  step_pool_widths: f32 = 2.5
  /// The bankfull Shields number the bed's median grain is set by, `D50 = h S / (1.65 tau)`
  /// (Parker et al. 2007): 0.01 to 0.2.
  shields_bankfull: f32 = 0.049
  /// Bars: the narrowest bed that has them (0 to 100 m), how far their crown rises above the bed as
  /// a fraction of the depth (0 to 1), and their width and length in bed widths.
  bar_min_width_m: f32 = 1.0 @unit(m)
  bar_rise: f32 = 0.4
  bar_width_widths: f32 = 0.35
  bar_length_widths: f32 = 3.0
  /// W86's bank pieces, read and range-checked so a scene naming them still reads, and placed no
  /// more since W89: the banks are the cut's faces (channels.md, "The cut"). The two widths are
  /// still the reach the placements leave bare beyond the water (scene_gen.md, "Exclusion"), handed
  /// over on the water's description (`WaterChannel`) where they are not the defaults (T78).
  bank_min_width_m: f32 = 1.5 @unit(m)
  bank_height: f32 = 0.6
  bank_width_widths: f32 = 0.25
  bank_width_m: f32 = 0.4 @unit(m)
  /// The line's resampling step along its length: 0.1 to 4 m.
  step_m: f32 = 0.5 @unit(m)
  /// A link is placed in pieces of at most this length: 4 to 256 m.
  piece_m: f32 = 32.0 @unit(m)
  /// The cut's banks, rise over run (0.25 to 8; 1, 45 degrees): the cross-section the bed is laid
  /// in and the terrain's cuts are written with (channels.md, "The cut"; the source in
  /// docs/experiments/channels.md).
  bank_slope: f32 = 1 @since(2)
  /// **Reaches** (W90; channels.md, "Reaches"; the bounds and their sources in
  /// docs/experiments/channels.md): a point's reach is read from the ground's fall per metre along
  /// the line over a window centred on it, `reach_window_widths` bankfull widths long and at least
  /// `reach_window_min_m` (5 to 50 widths; 0 to 200 m). The bounds between the classes, each a fall
  /// per metre, ascending: dune-ripple below `slope_pool_riffle`, pool-riffle below
  /// `slope_plane_bed`, plane-bed below `slope_step_pool`, step-pool below `slope_cascade`, cascade
  /// below `slope_steep`, and above it bedrock — colluvial on a link that begins at a channel head.
  reach_window_widths: f32 = 20 @since(3)
  reach_window_min_m: f32 = 20 @since(3) @unit(m)
  slope_pool_riffle: f32 = 0.001 @since(3)
  slope_plane_bed: f32 = 0.015 @since(3)
  slope_step_pool: f32 = 0.03 @since(3)
  slope_cascade: f32 = 0.065 @since(3)
  slope_steep: f32 = 0.2 @since(3)
  /// A step's height over its spacing, divided by the slope (Abrahams, Li & Atkinson 1995: 1 to 2,
  /// the steps of maximum flow resistance near 1.5): 1 to 2.
  step_height_ratio: f32 = 1.5 @since(3)
  /// A knickpoint (W91; channels.md, "Reaches") is a fall only where the ground drops at least this
  /// over it, and the chute between knickpoints spreads a smaller drop by cutting up to half this
  /// deeper above it: 0.2 to 10 m. (W90 used it for a step dropped in one stretch; since W91 no
  /// step does.)
  fall_min_m: f32 = 1.0 @since(3) @unit(m)
  /// **A step's riser** (W91) stands at this angle from the horizontal, degrees: a boulder step's
  /// face at the angle of repose of its clasts, 35 to 40 degrees for coarse angular debris (the
  /// grounding page). 20 to 44, below the 45 degrees at which the water leaves its bed and falls.
  riser_angle_deg: f32 = 38 @since(4)
  /// **A cascade's boulders** (W91): clusters at an exponential spacing of this mean, in bankfull
  /// widths, at least half a width (Montgomery & Buffington's cascade has no regular sequence):
  /// 0.5 to 10.
  cascade_boulder_widths: f32 = 1.5 @since(4)
  /// **Knickpoints** (W91; channels.md, "Reaches"): the window the ground's fall is read over, in
  /// bankfull widths (1 to 20) and at least `knick_window_min_m` (0.5 to 50 m): a knickpoint is a
  /// run of points where the ground below each falls at least 1 per metre (45 degrees) over the
  /// window, dropping at least `fall_min_m`.
  knick_window_widths: f32 = 3 @since(4)
  knick_window_min_m: f32 = 2 @since(4) @unit(m)
  /// **The chute** (W91): away from a knickpoint the cut's bed falls no steeper than this per metre
  /// (0.2 to 1; 0.9 is 42 degrees), so the water draws no fall where the ground has none.
  chute_gradient_max: f32 = 0.9 @since(4)
  /// **Mouths** (W90): a link that reaches a water body ends at its shoreline, its cut opening over
  /// the last `fan_widths` bankfull widths (1 to 20) into a fan whose width grows by `fan_spread`
  /// of itself (0 to 4) at the shore, its bed grading to the body's level.
  fan_widths: f32 = 3 @since(3)
  fan_spread: f32 = 1 @since(3)
  /// **Confluences** (W90): a tributary's bed and water are lowered to the trunk's over its last
  /// `confluence_widths` of its own widths (1 to 20).
  confluence_widths: f32 = 3 @since(3)
  /// **The planform's irregularity** (W90): each meander's wavelength and amplitude vary along the
  /// line by up to these shares of themselves (0 to 0.5, 0 to 0.8), from a noise of the link's own.
  meander_wavelength_variation: f32 = 0.25 @since(3)
  meander_amplitude_variation: f32 = 0.5 @since(3)
  bed: ChannelSurface
  bars: ChannelSurface
  banks: ChannelSurface
}

/// One slab of a piece: a grid of `rows` cross-sections of `columns` points, row-major, each with
/// its place in the piece's frame (metres from the piece's origin) and the heights of its top and
/// bottom there. Closed by its four edges.
struct ChannelSlab @version(1) {
  rows: u32 = 2
  columns: u32 = 2
  x: f32[]
  z: f32[]
  top: f32[]
  bottom: f32[]
}

/// A placed piece's recipe, written by the generator as `<hash>.channel.json` and built by the mesh
/// generator "channel": the part it is, its slabs with every height already decided, and its look.
struct ChannelPiece @version(1) {
  part: ChannelPart = Bed
  /// The piece origin's place in its UV frame, metres (the world's x and z modulo 1,024 m), so the
  /// texels run on across the joins between pieces.
  uv_origin: f32[2]
  surface: ChannelSurface
  slabs: ChannelSlab[]
}
