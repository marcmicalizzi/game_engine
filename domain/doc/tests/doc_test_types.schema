// Object types the doc tests place in a world. They exist for one reason: to be the
// schema-registry side of how a type opts into a partitioned layer (docs/plan/03-data-model.md
// §3.7) — a partition that names no property tiles a record by its type's `position` or
// `transform` field.
namespace engine.doc.test

/// Something standing somewhere in the world.
struct Placement @version(1) @kind(record) {
  name: string
  /// World position. Its presence is what opts the type into tile partitioning. A `worldpos`, so
  /// validation holds it to f64 and to the cells' range (ADR-0053).
  position: worldpos @unit(m)
}

/// The same, opting in through a transform: a whole placement matrix or a
/// translation/rotation/scale object, which the partition reads the position out of.
struct Fixture @version(1) @kind(record) {
  name: string
  transform: json
}

/// How brightly a marker glows: `strength` was `power` (roadmap D28), a field renamed inside a struct
/// a record holds.
struct Glow @version(1) {
  strength: f32 = 1 @alias("power")
}

/// A type renamed, with a field of its own renamed (roadmap D28, plan 03 §3.8: "rename is an alias,
/// never delete-and-add"): it was `engine.doc.test.Beacon`, and its `label` was `title`. The
/// migration corpus's `documents/renamed/` holds a document written before the rename
/// (content/migration-corpus/README.md, "The documents").
struct Marker @version(1) @kind(record) @alias("Beacon") {
  label: string @alias("title")
  position: worldpos @unit(m)
  glow: Glow?
}

/// A type with neither: it has no place on the grid, so its records go to `untiled.json`.
struct Fact @version(1) @kind(record) {
  claim: string
}
