// The landform capability's types (ADR-0007, ADR-0027; docs/subsystems/landform.md): the region
// sketch the solver reads and the header of the fields it writes beside the heightfield.
// ENGINE_WITH_LANDFORM=OFF takes them out of the build with everything else the capability owns.
namespace engine.landform

import "scene.schema"

/// What a side of the region is (landform.md, "The borders").
enum EdgeKind : u8 {
  /// Its points are held at the base level and are outlets: rivers leave across it.
  Open
  /// Nothing crosses it: a divide another region shares.
  Closed
  /// The sea lies along it: its points are held at the sea bed's depth and are outlets.
  Sea
}

/// The four sides. West is -x, east +x, north -z, south +z (the engine's north is -z).
struct Edges @version(1) {
  west: EdgeKind = Open
  east: EdgeKind = Open
  north: EdgeKind = Open
  south: EdgeKind = Open
}

/// The sea: a level rivers cut to and no lower, and a bed that is ground like any other (it
/// diffuses and holds the critical slope). With no starting heightfield the bed falls from the
/// level, `shelf_m` in from a sea edge, to `depth_m` below it at the edge.
struct Sea @version(2) {
  level_m: f64 = 0
  /// 0 to 1,000,000 m.
  shelf_m: f64 = 2000
  /// 0 to 11,000 m.
  depth_m: f64 = 200
  /// The depth below the level to which the sea's bed may be built by what the rivers bring
  /// (docs/experiments/coast.md, "The long run: the sea fills to its wave base and no higher"):
  /// above it the bed is the waves' to move, and nothing a river carries settles there in the
  /// long run. 0 to 200 m. Absent: Hallermeier's outer limit of the coast's wave climate where
  /// the sketch has one, else 20 m (authored). 0 lets the sea fill to its level, as a lake does.
  wave_base_m: f64? @since(2) @unit(m)
  /// The spring tidal range, 0 to 15 m: high water stands half of it above the level. A water
  /// body's own `tide_m` is an amplitude, half of this; the two are set together.
  tide_m: f64 = 0 @since(2) @unit(m)
}

/// A point in the world's frame, metres.
struct Point @version(1) {
  x: f64 @unit(m)
  z: f64 @unit(m)
}

/// One entry of the wave climate that arrives from the open sea (docs/experiments/coast.md,
/// "Inputs"): deep-water waves from a direction for a share of the year. It reaches a shore only
/// through a `Sea` edge.
struct Wave @version(1) {
  /// The direction the waves come from, degrees clockwise from north (-z): 0 to 360. Quantized
  /// to the stand's 32 azimuths.
  from_deg: f64
  /// The deep-water significant height, 0 to 30 m.
  height_m: f64 @unit(m)
  /// The period, 1 to 30 s.
  period_s: f64 @unit(s)
  /// The share of the year, 0 to 1; the entries' shares sum to 1 or less.
  share: f64 = 1
}

/// A closed polyline of land (docs/experiments/coast.md, "Inputs"): the plan of an island or a
/// coast. Three points or more; the last joins the first.
struct Outline @version(1) {
  points: Point[]
}

/// The coast (docs/experiments/coast.md): an outline of land the uplift and the starting bed are
/// made from, and the stand of the sea after the last step, in which each shore takes the wave
/// climate that reaches it and its sand comes to rest in an equilibrium section.
struct Coast @version(1) {
  /// The land's plan. Uplift rises from nothing at a line to the sketch's rate `outline_reach_m`
  /// inside it and is nothing outside; with no starting ground, the bed outside is the
  /// equilibrium shoreface of `grain_mm` down to the wave base and a shelf beyond, falling to
  /// the sea's `depth_m` over its `shelf_m`.
  outline: Outline[]
  /// 0 to 1,000 km. Absent: the sketch's border reach.
  outline_reach_m: f64? @unit(m)
  /// The waves that arrive from the open sea, through `Sea` edges. None: the stand has no
  /// climate and does not run.
  waves: Wave[]
  /// The beach's sediment, its median diameter: 0.15 to 64 mm (sand under 2 mm, shingle above).
  grain_mm: f64 = 0.3
  /// The height exceeded twelve hours a year over the climate's significant height, for the
  /// closure depth: 1 to 6. 3 is what Hallermeier's and Houston's closure depths agree at.
  storm: f64 = 3
  /// How far the berm runs landward of the beach face's top, 0 to 1,000 m (authored).
  berm_width_m: f64 = 30 @unit(m)
  /// The stand's years after the last step, 0 (no stand) to 20,000, and its step: 1 to the
  /// stand. Stage B places the sand at equilibrium once; nothing retreats until stage C.
  stand_yr: i64 = 6000
  step_yr: i64 = 100
}

/// A point held at a level, anywhere in the lattice: a lake's sill, a river leaving through a
/// closed edge. The nearest lattice point is the one held.
struct Outlet @version(1) {
  at: Point
  level_m: f64 @unit(m)
}

/// Uplift along a line: `rate_mm_per_yr` on the line, falling to nothing `reach_m` from it as
/// (1 - (r / reach)^2)^2. Where ridges overlap the largest counts.
struct Ridge @version(2) {
  /// Two points or more.
  points: Point[]
  /// 0 to 100 mm/yr.
  rate_mm_per_yr: f64 = 1
  /// 1 m to 1,000 km.
  reach_m: f64 = 4000
  /// The rate varies along the line by this fraction either way, seeded: 0 (uniform) to 0.9.
  /// A range raised evenly along its length has valleys evenly spaced; no real one is
  /// (landform.md, "Uplift along a ridge").
  variation: f64 = 0.35 @since(2)
  /// The variation's longest wavelength, metres along the line: 10 to 1,000,000. Three more
  /// octaves follow it down, each half the wavelength and 1 / sqrt(2) the amplitude.
  variation_length_m: f64 = 6000 @since(2) @unit(m)
}

/// Uplift as a coarse grid over the region, corner to corner, read bilinearly: `width` by `height`
/// rates, rows of x in order of z.
struct UpliftRaster @version(1) {
  /// 2 to 4,096 each.
  width: u32
  height: u32
  /// `width * height` rates, each 0 to 100 mm/yr.
  rates_mm_per_yr: f64[]
}

/// What raises the ground: the regional rate, plus the ridges' largest kernel, plus the raster,
/// all times the seeded unevenness.
struct Uplift @version(2) {
  /// 0 to 100 mm/yr.
  regional_mm_per_yr: f64 = 0
  ridges: Ridge[]
  raster: UpliftRaster?
  /// The rate varies over the plan by this fraction either way, seeded: 0 (even) to 0.9. A
  /// range raised by a kernel that depends only on the distance to its line is a pair of ramps,
  /// and the rivers of a ramp run straight down it side by side; what breaks that comb is a
  /// rate that is uneven across the range as well as along it (landform.md, "Valleys that are
  /// not a comb", has the count).
  /// It is a fraction of the rate about the point: the regional rate and the raster's, and a
  /// ridge's own rate falling off as the square root of its kernel, so a flank is as uneven as
  /// the crest; the sum is never below nothing.
  variation: f64 = 0.7 @since(2)
  /// The unevenness's longest wavelength, metres: 10 to 1,000,000. Three more octaves follow it
  /// down, each half the wavelength and 1 / sqrt(2) the amplitude.
  variation_length_m: f64 = 3000 @since(2) @unit(m)
}

/// How hard the ground is: uniform, or the beds of a formation (landform.md, "Structure").
struct Rock @version(2) {
  /// The resistance where the sketch has no formation: 0 (the sketch's erodibility) to 1 (the
  /// erodibility over the contrast, the resistant critical slope).
  resistance: f64 = 0
  /// The erodibility at resistance 0 over the erodibility at resistance 1: 1 to 1,000. The
  /// default is inside what is published for a range's own rocks, 1.2 to 2.8
  /// (docs/experiments/landform.md, "Structure: the sources"); it was 10 before stage C.
  contrast: f64 = 2
  /// Seeded variation of the erodibility, as a fraction either way: 0 to 0.9.
  variation: f64 = 0.25
  /// The variation's wavelength, cells: 2 to 1,024.
  variation_cells: u32 = 16
  /// The world formation (the scene's own `engine.scene.Formation`, copied here): the resistance
  /// at a point is its bed's, read in the rock's frame, so the beds rise with the rock as it is
  /// uplifted and the surface lowers through them. The macro beds where it has them, else the
  /// beds. Version 2: it replaced the table of resistance by elevation band (`bands`), which a
  /// sketch may no longer carry.
  formation: engine.scene.Formation? @since(2)
}
/// A stand of the ice (landform.md, "Ice"): from `from_yr` the equilibrium line is at `ela_m`,
/// until the next stand or the ice age's end. A glacier's snout is still while its line is, and
/// a snout that is still builds a moraine: an ice age's stands are where its ridges are.
struct IceStand @version(1) {
  /// The year of the run the line moves: after the ice's own `from_yr`, each stand later than
  /// the one before it.
  from_yr: i64
  /// -11,000 to 9,000 m.
  ela_m: f64 @unit(m)
}

/// An ice age (landform.md, "Ice"): valley glaciers by Hergarten 2021's stream-power form. Snow
/// becomes ice above the equilibrium line and ice melts below it; the ice a point passes on is
/// what its catchment made less what melted on the way; a glacier is as wide and as thick as its
/// flux makes it, and wears its bed over that width. What it carries it leaves as a moraine
/// where its snout stands, and as a thin sheet of lodged till under itself.
struct Ice @version(3) {
  /// The equilibrium line's altitude, metres: -11,000 to 9,000. Read on the ice's own surface.
  /// The first stand's: `stands` move it.
  ela_m: f64 @unit(m)
  /// The height above the line at which all of a point's snowfall becomes ice (below the line
  /// the same slope is the melt): 10 to 5,000 m. Hergarten's H_f - H_e, 500 m in his example.
  full_m: f64 = 500 @unit(m)
  /// The depth below the line at which a glacier loses, over its own width, as much ice as
  /// full snowfall would make: 10 to 5,000 m. Half of `full_m` by default: ice melts about
  /// twice as fast with depth below the line as it gathers with height above it.
  melt_m: f64 = 250 @unit(m)
  /// The ice's erodibility over the rivers': 0 to 100. Hergarten's examples use 1 and 2.
  erodibility: f64 = 2
  /// A glacier's width where its flux is that of one square kilometre making ice in full,
  /// metres: 10 to 10,000. The width goes with the flux to the power 0.3 (Bahr 1997's width to
  /// length and the catchment's length to area, as Hergarten combines them).
  width_m: f64 = 500 @unit(m)
  /// The ice's thickness over its width: 0.01 to 1. Hergarten's example is 0.25.
  thickness_ratio: f64 = 0.25
  /// The ice's coupling length over its thickness: 0 to 10 (landform.md, "Basins the ice
  /// digs"). Along a glacier's own line the slope its erosion reads is its surface's over twice
  /// this many thicknesses down the line, so it goes on wearing a bed that rises under it: a
  /// basin. Kamb and Echelmeyer 1986 give one to three thicknesses for valley glaciers. 0 reads
  /// the slope to the next point, and digs only where the ice thins.
  coupling: f64 = 2 @since(2)
  /// The adverse slope of the bed, over the ice surface's slope, at which the ice stops
  /// wearing it: 0.5 to 11. The published supercooling threshold is 1.2 to 1.7.
  adverse_slope: f64 = 1.5 @since(2)
  /// The share of the sediment reaching a glacier's snout that the ice itself carried there,
  /// and leaves as a moraine: 0 to 1 (landform.md, "Moraines"). The rest came with the water
  /// under the ice and goes on with it, the rivers' to lay down as outwash. Measured at three
  /// glaciers the ice's share of the whole yield is 0.014 to 0.164 (Hunter, Powell and Lawson
  /// 1996).
  carried: f64 = 0.1 @since(3)
  /// A moraine's crest stands no higher than this above the floor it was laid on, metres: 0 to
  /// 300 (and never higher than the glacier that built it was thick). The tallest ridge
  /// measured in what was read is 60 m (Small 1983). What a ridge has no room for goes on with
  /// the meltwater. 0 builds no ridge.
  moraine_height_m: f64 = 60 @since(3) @unit(m)
  /// Lodged till under the ice, over the ice's thickness: 0 to 0.1. A point under a glacier
  /// keeps this much of what passes it and no more: 0.5 m under 100 m of ice, the thick end of
  /// the layer measured under Storglaciaren (Hooke et al. 1997).
  lodged: f64 = 0.005 @since(3)
  /// The line's later heights, in order of time (landform.md, "Ice"): none keeps the line at
  /// `ela_m` for the whole ice age.
  stands: IceStand[] @since(3)
  /// The years of the run the ice stands in: from `from_yr` until `until_yr`, or the run's end.
  from_yr: i64 = 0
  until_yr: i64?
}

/// The region sketch `engine-content landform` reads (landform.md, "The sketch"). Every range is
/// checked, and a sketch outside one is refused with a sentence naming the field.
struct Sketch @version(4) {
  /// Points a row (x) and rows (z), each 8 to 16,384.
  width: u32
  height: u32
  /// Between points, whole millimetres, 100 to 1,000,000.
  spacing_mm: i64 = 16000
  /// Point (0, 0), millimetres from the world's origin, x and z: a whole number of spacings, so
  /// the lattice is a window of the world's at its spacing, as the heightfield's is.
  origin_mm: i64[2]
  edges: Edges
  /// What an open edge's points are held at; with a starting heightfield and no level, its own
  /// heights there.
  base_level_m: f64? @unit(m)
  sea: Sea?
  outlets: Outlet[]
  /// Uplift is tapered to nothing over this distance from every open or sea edge, so the ground
  /// meets the edge at its level and with no slope. Absent: 16 cells. 0 to 1,000 km.
  border_reach_m: f64? @unit(m)
  uplift: Uplift
  rock: Rock
  /// K of the stream-power law at m = 1/2 and n = 1, per year: 1e-8 to 1e-2
  /// (experiments/landform.md has the published ranges).
  erodibility_per_yr: f64 = 0.000005
  /// The drainage area a channel begins at, m2: 0 to 1e9. A point draining less is hillslope,
  /// lowered by diffusion and the critical slope alone. 0, the default, lets the rivers cut at
  /// every point, which is what cuts gullies into a slope at the critical angle; a threshold
  /// leaves such slopes smooth planes (landform.md, "The sketch").
  channel_area_m2: f64 = 0
  /// Hillslope diffusivity, m2/yr: 0 to 1.
  diffusivity_m2_per_yr: f64 = 0.005
  /// The gradient no slope stands above (rise over run): 0.2 to 4. The default is 38.7 degrees
  /// (docs/experiments/landform.md, "Slopes and steepness: the sources").
  critical_slope: f64 = 0.8
  /// The same for rock of resistance 1: `critical_slope` to 4.
  critical_slope_resistant: f64 = 1.6
  /// The deposition coefficient G of Yuan et al. 2019 (Davy and Lague 2009's theta): a river lays
  /// down G / N of the sediment that reaches a point draining N cells. 0 is the detachment-limited
  /// law, with nothing laid down by a river; 1 is the published reference; 0 to 10
  /// (landform.md, "Deposition").
  deposition: f64 = 1 @since(2)
  /// The erodibility of sediment over the sketch's `erodibility_per_yr`: 1 to 100.
  sediment_erodibility: f64 = 2 @since(2)
  /// The share of the sediment reaching standing water in a lake that settles at the river's
  /// mouth, up to the water's level (a delta); the rest levels the lake's floor. 0 to 1.
  delta_share: f64 = 0.5 @since(2)
  /// Where the steepest fall from a point is under this (rise over run) its flow divides among
  /// all its lower neighbours, in proportion to each one's slope times the contour it crosses
  /// (Quinn et al. 1991); at this and above it all goes to the steepest. 0 never divides; 0 to
  /// 1. The default is the slope at which Qin et al. 2007's exponent for the same rule passes 2
  /// (landform.md, "Flow that divides").
  divide_below_slope: f64 = 0.1 @since(3)
  /// Lateral erosion: the erodibility of a river's bank over that of its bed (Langston and
  /// Tucker 2018's K_l / K_v). 0 is none; 0 to 10 (landform.md, "Lateral erosion").
  lateral_erosion: f64 = 1 @since(3)
  /// A channel's width where it drains one square kilometre, metres: the width written to the
  /// field file is this times the square root of the discharge in square kilometres (the
  /// downstream hydraulic geometry's exponent of one half). 0.1 to 1,000.
  channel_width_m: f64 = 5 @since(3) @unit(m)
  /// An ice age, or none.
  ice: Ice? @since(3)
  /// A coast, or none (docs/experiments/coast.md). It needs a sea.
  coast: Coast? @since(4)
  seed: u64 = 1
  /// The starting plane's roughness, metres either way: 0 to 100.
  roughness_m: f64 = 1
  /// Whole years: the run is `duration_yr / step_yr` steps (rounded down), 0 to 100,000 of them.
  /// No steps writes the starting ground's own fields.
  duration_yr: i64 = 1000000
  /// 1 to 10,000,000 years.
  step_yr: i64 = 5000
  /// An `engine.terrain.heightfield/1` header, relative to the sketch: the ground the run starts
  /// from and refines. It must cover the lattice; it is read bilinearly, so it may be coarser.
  start: string?
}

/// One field of the field file.
struct FieldEntry @version(1) {
  /// `drainage_area`, `receiver`, `slope`, `erosion_rate`, `fill`, `sediment`, `resistance`,
  /// `discharge`, `channel_width`, `ice`, `till`, `ice_max`, `moraine`, `moraine_crest`,
  /// `lakebed`, `rock_floor`, and the coast's `shore_distance`, `substrate`, `grain`,
  /// `exposure`, `wave_direction`, `beach_slope`, `berm`.
  name: string
  /// The raw grid, relative to the header: little-endian, rows of x in order of z, the
  /// heightfield's own lattice.
  file: string
  /// `u8`, `u16`, `u32` or `i32`.
  type: string
  /// What one unit is, in words (landform.md, "The field file").
  unit: string
  /// `hash_bytes` over the grid's bytes, 16 lower-case hex digits.
  hash: string
}

/// The header of an `engine.terrain.heightfield/1` grid, field for field what
/// `engine.tileset.HeightfieldHeader` is (docs/subsystems/tileset.md, "The source"): the solver
/// writes one and reads a starting ground from one, and a capability may not depend on another
/// (ADR-0027), so it carries the header's shape rather than the tile set's type. The tile set's
/// own reader is what checks the two agree (`engine-content landform` reads its output back
/// through it).
struct TerrainHeightfield @version(1) {
  format: string
  version: u32 = 1
  width: u32
  height: u32
  spacing_mm: i64 = 1000
  origin_mm: i64[2]
  vertical_mm_per_unit: f64 = 1000
  data: string
  data_hash: string
}

/// The header of the fields written beside a solved heightfield (landform.md, "The field file"):
/// `engine.landform.fields/5`. Every field is on the heightfield's lattice, point for point.
struct Fields @version(2) {
  /// "engine.landform.fields".
  format: string
  version: u32 = 5
  width: u32
  height: u32
  spacing_mm: i64
  origin_mm: i64[2]
  /// The sea's level, whole millimetres; absent, the region has no sea.
  sea_level_mm: i64?
  /// The sea's spring tidal range, whole millimetres; absent with no sea.
  tide_mm: i64? @since(2)
  /// The heightfield's header, relative to this one.
  heightfield: string
  /// `hash_bytes` over the sketch's canonical JSON, 16 hex digits, and the solver's version: what
  /// the fields were solved from.
  sketch_hash: string
  solver_version: u32
  /// What `landform::route` takes to find the receivers again from the heights (the sketch's
  /// seed, salted): the diagonal weights of the routing are hashed from it and the cell.
  route_seed: u64
  steps: u32
  step_yr: i64
  fields: FieldEntry[]
}
