// Engine protocol (docs/plan/06-agent-tooling.md §6.2, ADR-0001): JSON-RPC 2.0 framing and the
// typed parameters and results of the day-one methods. Every method's params and result are
// schema structs, so one set of descriptors produces the C++ types, the JSON Schema, and the
// method catalogue that `engine.methods` returns to agents.
namespace engine.protocol
import "doc.schema"
import "gfx.schema"
import "scene.schema"

/// JSON-RPC 2.0 error object. Codes -32700..-32600 are the standard ones; engine codes are
/// positive (domain/protocol/rpc.h).
struct RpcError @version(1) {
  code: i32 = 0
  message: string
  /// Structured detail: for invalid params, an array of {path, message} diagnostics.
  data: json
}

/// A JSON-RPC request. `id` is absent for notifications, which receive no response.
struct Request @version(1) {
  jsonrpc: string = "2.0"
  id: json
  method: string
  params: json
}

/// A JSON-RPC response; exactly one of `result` and `error` is present on the wire.
struct Response @version(1) {
  jsonrpc: string = "2.0"
  id: json
  result: json
  error: RpcError?
}

/// One problem found by validation or command application.
struct Diagnostic @version(1) {
  path: string
  message: string
}

/// Result of `engine.info`.
struct EngineInfo @version(1) {
  name: string
  version: string
  /// "debug" or "release".
  build: string
  pid: u32 = 0
  schema_types: u32 = 0
  methods: u32 = 0
}

/// One entry of the method catalogue (`engine.methods`).
struct MethodInfo @version(1) {
  name: string
  doc: string
  /// Qualified schema type of `params`; empty when the method takes none.
  params_type: string
  /// Qualified schema type of `result`.
  result_type: string
}

struct MethodsResult @version(1) {
  methods: MethodInfo[]
}

/// Result of `engine.ping`: the host is alive and answering. The method reads a clock and nothing
/// else, so it costs nothing and can never itself be the call that hangs; a client uses it to
/// tell a live host from one that has stopped answering. There is no generation here: a host does
/// not know how many hosts came before it. The client that starts hosts counts them (engine-mcp's
/// `host_info` reports its count), and compares `pid` to know whether it is still talking to the
/// same process.
struct PingResult @version(1) {
  pid: u32 = 0
  /// Seconds since the host started.
  uptime_seconds: f64 = 0
}

/// Parameters of `session.open`.
struct SessionOpenParams @version(1) {
  /// Directory holding manifest.json, layers/, and journal.jsonl (native or mounted path).
  path: string
  /// Create the document with one base layer when the directory holds none.
  create: bool = false
  /// Name for a created document; defaults to the directory name.
  name: string
}

struct LayerInfo @version(2) {
  name: string
  role: engine.doc.LayerRole = Base
  records: u32 = 0
  is_edit: bool = false
  /// How the layer is stored: present when it is a set of tile files under
  /// `layers/<name>/`, absent when it is the single file `layers/<name>.json`
  /// (docs/plan/03-data-model.md §3.7).
  partition: engine.doc.LayerPartition? @since(2)
  /// Occupied tiles; zero for a layer stored as one file.
  tiles: u32 = 0 @since(2)
}

struct SessionInfo @version(1) {
  session: string
  path: string
  name: string
  layers: LayerInfo[]
  journal_length: u32 = 0
  undo_position: u32 = 0
}

struct SessionRef @version(1) {
  session: string
}

struct SessionsResult @version(1) {
  sessions: SessionInfo[]
}

/// Parameters of `doc.apply`: one transaction.
struct ApplyParams @version(1) {
  session: string
  commands: engine.doc.Command[]
  attribution: engine.doc.Attribution
  /// Roll the whole transaction back when any command fails, instead of committing what
  /// succeeded.
  atomic: bool = true
}

struct ApplyResult @version(1) {
  committed: bool = false
  /// Index of the committed patch in the journal.
  patch_index: u32 = 0
  applied: u32 = 0
  diagnostics: Diagnostic[]
}

/// Parameters of `doc.objects`.
struct ObjectsParams @version(1) {
  session: string
  /// Restrict to this qualified type; empty for every type.
  type: string
  /// Restrict to children of this parent (the null id means roots); absent for every object.
  parent: id128?
  offset: u32 = 0
  limit: u32 = 1000
}

/// The composed view of one live object.
struct ObjectView @version(1) {
  id: id128
  type: string
  /// Null id = root.
  parent: id128
  defining_layer: string
  properties: map<string, json>
}

struct ObjectsResult @version(1) {
  objects: ObjectView[]
  /// Objects matching the filter before offset and limit.
  total: u32 = 0
}

struct GetParams @version(1) {
  session: string
  id: id128
}

struct DiffParams @version(1) {
  session: string
  from_layer: string
  to_layer: string
}

struct DiffResult @version(1) {
  commands: engine.doc.Command[]
}

/// Which side `doc.merge` resolves a conflict toward (domain/doc/merge.h).
enum MergePrefer : u8 {
  /// Conflicting properties keep ours; an object both sides created keeps ours.
  Ours = 0
  /// The same, resolved toward theirs.
  Theirs = 1
  /// Conflicting properties keep base's value, and an object both sides created differently is
  /// left out.
  Neither = 2
}

/// How the two sides disagreed (domain/doc/merge.h).
enum MergeConflictKind : u8 {
  /// The same property (or "$type", or "$parent") changed to different values on both sides.
  PropertyBothChanged = 0
  /// One side deleted the object, the other modified it; the object is kept, modified.
  DeletedAndModified = 1
  /// Both sides created the object under the same id, with different content.
  CreatedBothDifferent = 2
  /// Taking the reparent would close a cycle; base's parent is kept.
  ParentCycle = 3
}

/// Parameters of `doc.merge`: three layers of the open document, and the layer the merge is
/// written to.
struct MergeParams @version(1) {
  session: string
  /// The common ancestor the other two diverged from.
  base_layer: string
  ours_layer: string
  theirs_layer: string
  /// Layer the merged records go into: appended to the stack when it does not exist yet, and
  /// otherwise replaced. May be one of the three inputs.
  output_layer: string
  prefer: MergePrefer = Ours
}

/// One conflict `doc.merge` found.
struct MergeConflictInfo @version(1) {
  object: id128
  /// A property of the object, "$type" or "$parent" for the record's own fields, empty for a
  /// conflict about the whole record.
  property: string
  kind: MergeConflictKind = PropertyBothChanged
  /// The three values, with null for absent.
  base: json
  ours: json
  theirs: json
}

struct MergeResult @version(1) {
  /// Changes taken from each side: one per property set or cleared, one each for a changed
  /// type, parent, or deletion flag, and one for a record added or removed whole.
  applied_ours: u32 = 0
  applied_theirs: u32 = 0
  conflicts: MergeConflictInfo[]
  /// Index of the committed patch in the journal; the merge is undoable like any transaction.
  patch_index: u32 = 0
  /// False when the merge changed nothing, and nothing was journaled.
  committed: bool = false
}

/// Parameters of `doc.undo` and `doc.redo`.
struct StepParams @version(1) {
  session: string
  steps: u32 = 1
}

struct StepResult @version(1) {
  /// Journal patches applied after the operation.
  position: u32 = 0
  stepped: u32 = 0
}

struct ValidateResult @version(1) {
  ok: bool = false
  diagnostics: Diagnostic[]
}

struct LayersResult @version(1) {
  layers: LayerInfo[]
}

struct AddLayerParams @version(2) {
  session: string
  name: string
  role: engine.doc.LayerRole = Feature
  /// Make the new layer the edit layer.
  edit: bool = true
  /// Store the layer as tile files rather than one file: the property holding each record's
  /// world position (empty to take it from each record type's `position` or `transform` field)
  /// and the tile edge length, which must be greater than zero.
  partition: engine.doc.LayerPartition? @since(2)
}

/// Parameters of `doc.set_partition`: converts one layer between the two storage forms and
/// rewrites its files. No record changes, so the journal, undo, and redo are untouched.
struct SetPartitionParams @version(1) {
  session: string
  layer: string
  /// Absent, or a tile_size of zero, stores the layer as one file again.
  partition: engine.doc.LayerPartition?
}

struct SetEditLayerParams @version(1) {
  session: string
  layer: string
}

struct JournalParams @version(1) {
  session: string
  offset: u32 = 0
  limit: u32 = 100
}

struct JournalResult @version(1) {
  patches: engine.doc.Patch[]
  total: u32 = 0
  position: u32 = 0
}

struct TunableSetParams @version(1) {
  name: string
  value: json
}

/// `tunables.list` returns every description; `tunables.set` the one that changed.
struct TunablesResult @version(1) {
  tunables: json
}

struct LogTailParams @version(1) {
  /// First sequence number to return.
  since: u64 = 0
  limit: u32 = 200
}

struct LogTailResult @version(1) {
  /// Array of records: {seq, t, wall, level, cat, thread, msg, fields}.
  records: json
  /// Sequence to pass as `since` next time.
  next: u64 = 0
}

struct SchemaTypesResult @version(1) {
  types: string[]
}

struct SchemaDescribeParams @version(1) {
  type: string
}

struct SchemaDescribeResult @version(1) {
  /// {name, ns, kind, version, tag, doc, fields: [{name, type, since, transient, deprecated,
  /// doc, default}], values: [{name, value, doc}]}. `default` is what the field becomes when a
  /// caller leaves it out, in the form a caller would send it; a transient field has none.
  description: json
}

/// Result of `gpu.adapters`: every Vulkan physical device the loader exposes.
struct AdaptersResult @version(1) {
  /// False when no Vulkan loader or no 1.3 instance is available; `error` says why.
  available: bool = false
  error: string
  adapters: engine.gfx.AdapterInfo[]
}

// ---- render.* ---------------------------------------------------------------------------------
// The renderer over the protocol (docs/subsystems/renderer.md, docs/plan/04-renderer.md §4.8,
// 06 §6.9): load a scene once, then capture it, benchmark it, and compare the pictures. Every
// string here is spelled the way engine-view's flags spell it, because both hosts parse them
// with the same functions in systems/renderer/settings.h.

/// Every knob the renderer has. Absent fields keep the defaults, which are engine-view's.
struct RenderSettings @version(6) {
  /// direct, hw, vertex, sw, auto, or rt. `hw` and `direct` fall back to `vertex` on a device
  /// without mesh shaders; the result says which one ran.
  raster: string = "hw"
  /// off, rt, csm, or auto. rt: every light's shadow is a ray query against the frame's own
  /// acceleration structures. csm: the sun's shadow is filtered out of cascaded shadow maps the
  /// cull pass and the picture's rasterizer draw from the light (hw and vertex paths; the point
  /// lights are unshadowed). auto: rt wherever the device has cluster acceleration structures and
  /// ray queries, csm where it has not (docs/subsystems/renderer.md, "Shadows").
  shadows: string = "auto"
  /// id, tri, depth, shaded, normals, uv, or shadow (the sun's shadow alone: white where it
  /// reaches the surface, black where a shadow ray is blocked, grey where the surface faces away).
  view: string = "shaded"
  /// Screen-space error threshold in pixels for LOD selection.
  lod_px: f32 = 1
  /// `auto` raster: clusters narrower than this go to the software rasterizer.
  sw_px: f32 = 32
  cull: bool = true
  occlusion: bool = true
  cone: bool = true
  /// The two orbiting point lights beside the sun.
  lights: bool = true
  /// none, identity, wave, or lattice: the per-frame deformed-vertex pool.
  deform: string = "none"
  deform_amplitude: f32 = 0.02
  /// Instantiate prebuilt cluster templates instead of rebuilding the structures every frame.
  rt_templates: bool = false
  /// How the target is divided into views (04 §4.6): single, surround3, or panini.
  views: string = "single" @since(2)
  /// surround3: degrees the side monitors are turned inward. 0 is a flat arrangement, whose
  /// three off-axis frusta are the three thirds of one wide rectilinear frustum.
  side_yaw_deg: f32 = 0 @since(2)
  /// panini: 0 is the ordinary rectilinear picture, 1 the classic Pannini. Larger d compresses
  /// the periphery harder and needs a wider rectilinear source, which the result reports.
  panini_d: f32 = 1 @since(2)
  /// Multiply the LOD pixel threshold of the views outside the attention region — surround3's
  /// side monitors — by this. At least 1.
  peripheral_lod: f32 = 1 @since(2)
  /// Geometry streaming (04 §4.9): the device holds a budgeted subset of the scene's cluster
  /// pages, the cull pass draws what is resident and asks for the rest, and the picture
  /// converges. It needs a scene that was **loaded** with a page table, which is what
  /// `RenderLoadParams.settings.stream` asks for; asking here for a scene that has none turns
  /// streaming off with a log line rather than failing the call.
  stream: bool = false @since(3)
  /// The residency budget in **mebibytes** over the scene's page bytes; 0 is every page, which
  /// is streaming with nothing to evict. MiB rather than bytes because that is the scale a
  /// budget is chosen at, and it is the unit `engine-view --page-budget` takes.
  page_budget_mib: u32 = 0 @since(3)
  /// Page payload one frame may copy into the pool, in **kibibytes**; 0 is the renderer's own
  /// default (256 KiB), and a value under the largest page is raised to it, because a budget no
  /// page fits in would never converge. KiB because an upload is a fraction of a frame, and it
  /// is the unit `engine-view --upload-budget` takes.
  upload_budget_kib: u32 = 0 @since(3)
  /// With ray-traced shadows, the clusters the normal-cone test keeps out of the picture still
  /// cast: the cull pass hands them to the frame's acceleration structures at the picture's LOD
  /// (docs/subsystems/renderer.md, "Shadows"). False is the old behaviour, in which a card seen
  /// from behind throws no shadow; it is `engine-view --no-shadow-casters`.
  shadow_casters: bool = true @since(4)
  /// The most device memory the per-frame cluster acceleration structures may take, in
  /// **mebibytes**; 0 is the `renderer.rt.budget_mib` tunable (1024). They are sized by what the
  /// frames build, a step above it, and a frame that wants more than the budget holds drops whole
  /// instances' structures, shadow casters first (docs/subsystems/renderer.md, "The ray tracing
  /// chain's memory"). It is `engine-view --rt-budget-mib`.
  rt_budget_mib: u32 = 0 @since(5)
  /// csm: how many cascades (1..4), how many texels a side each (64..4096, rounded up to a power
  /// of two), and how far from the camera they reach (0: the far side of the scene's bounds).
  /// `engine-view --shadow-cascades`, `--shadow-map`, `--shadow-distance`.
  shadow_cascades: u32 = 4 @since(6)
  shadow_map: u32 = 2048 @since(6)
  shadow_distance: f32 = 0 @since(6)
}

/// The ray tracing chain's memory over a run, mirroring `renderer::RtStats`: the capacity of the
/// per-frame structures in clusters now and at most, the budget as a capacity, what they would be
/// sized for if they were sized by the scene (`views * pairs`), their bytes now and at most, the
/// last frame's built and wanted counts, the resizes, and the frames that wanted more than the
/// capacity held and so dropped whole instances' structures. All zero without the chain. The keys
/// are engine-view's `rt` summary object's, so one reader serves both hosts.
struct RenderRtStats @version(1) {
  capacity: u32 = 0
  peak_capacity: u32 = 0
  limit: u32 = 0
  union_clusters: u32 = 0
  bytes: u64 = 0
  peak_bytes: u64 = 0
  built_last: u32 = 0
  wanted_last: u32 = 0
  peak_wanted: u32 = 0
  grows: u32 = 0
  shrinks: u32 = 0
  overflow_frames: u64 = 0
  dropped_instances: u64 = 0
  dropped_caster_instances: u64 = 0
}

/// What a run of geometry streaming did (04 §4.9, docs/subsystems/renderer.md "Geometry
/// streaming"), mirroring `renderer::StreamStats`. The counters are cumulative over the run;
/// `pages_resident`, `pending` and `loads_in_flight` are the latest frame's. Every field is named
/// as engine-view's `streaming` summary object names it, so one shape reads out of both hosts.
/// `pages_total` is 0 when nothing streamed, which is how a reader tells a whole-scene upload
/// from a streamed one without testing for the block.
struct RenderStreamStats @version(2) {
  /// Pages in the scene's table, how many the device holds, and how many of those are roots
  /// (`geometry::k_page_root`: resident from the start, never evicted).
  pages_total: u32 = 0
  pages_resident: u32 = 0
  pages_pinned: u32 = 0
  /// The page pool's fixed-size slots, and the requests queued in the manager but not admitted.
  page_slots: u32 = 0
  pending: u32 = 0
  /// Request entries the cull passes wrote, summed over the run.
  requests: u64 = 0
  /// Pages copied into the pool and the payload bytes that cost.
  uploads: u64 = 0
  uploads_bytes: u64 = 0
  evictions: u64 = 0
  /// Requests dropped because the page that asked has been evicted since.
  stale: u64 = 0
  /// Frames whose request buffer was full; those pages come back next frame.
  overflows: u64 = 0
  /// Frames from the first with work outstanding to the first with none. A camera jump starts a
  /// new interval, so it is how long the last convergence took and not a total.
  frames_to_converge: u32 = 0
  resident_bytes: u64 = 0
  /// Every page of the scene — what streaming is a fraction of — and the manager's budget.
  page_bytes: u64 = 0
  budget_bytes: u64 = 0
  /// Where the payloads came from: "file" (the meshes' `.clusters` containers, read by range on
  /// the job system) or "host" (out of the loaded scene, which is all the procedural heightfield
  /// and a `"cache":false` glTF can do). The three counters below are zero for "host".
  source: string = "host"
  file_reads: u64 = 0
  file_bytes: u64 = 0
  /// What releasing the merged host streams saved, which only a file-backed source can do.
  host_bytes_freed: u64 = 0
  /// Frames in which a page was wanted and its reads had not landed yet: the read latency made
  /// visible. Many against few uploads is a run waiting on the disk.
  load_waits: u64 = 0
  /// Page loads outstanding right now. engine-view's summary line leaves this one out because it
  /// is a momentary value rather than a count of the run; it is here because the block is the
  /// whole of `renderer::StreamStats` and a caller polling a benchmark can use it.
  loads_in_flight: u32 = 0
  /// The pages the **pool** holds — what the cull pass can draw out of — beside the manager's
  /// `pages_resident`, which counts a page from its admission, before its bytes land.
  pool_pages: u32 = 0 @since(2)
  /// Loads given up so that the page at the head of the pool's walk could start its own read
  /// (docs/subsystems/renderer.md, "Admission never waits on a read it cannot start").
  steals: u64 = 0 @since(2)
}

/// What one view of a `ViewSet` costs, beside the totals in `RenderStats` (04 §4.6). The
/// milliseconds are per frame, as the totals are. A single-view run reports one entry whose
/// numbers are the totals.
struct RenderViewStats @version(2) {
  /// The view's rectangle of the color target.
  x: u32 = 0
  y: u32 = 0
  width: u32 = 0
  height: u32 = 0
  /// What the rasterizers ran at; wider than `width` for a Panini view.
  source_width: u32 = 0
  source_height: u32 = 0
  /// The multiplier this view's LOD threshold carries, and its shading rate, which is recorded
  /// and not yet consumed.
  lod_scale: f32 = 1
  shading_rate: u32 = 1
  visible_hw: u32 = 0
  visible_pass2: u32 = 0
  visible_sw: u32 = 0
  visible_pairs: u32 = 0
  /// Pairs the cone test kept out of this view's picture and the frame built into its
  /// acceleration structures so that they cast shadows. Not in `visible_pairs`: nothing draws them.
  shadow_casters: u32 = 0 @since(2)
  /// GPU milliseconds a frame, this view alone. The acceleration structure chain is not in it:
  /// it is built once from the union of the views' cuts and belongs to no single view.
  cull_ms: f64 = 0
  hw_ms: f64 = 0
  sw_ms: f64 = 0
  hiz_ms: f64 = 0
  resolve_ms: f64 = 0
  deform_ms: f64 = 0
  trace_ms: f64 = 0
  total_ms: f64 = 0
}

/// Parameters of `render.load`. Exactly one of `mesh` and `scene` is given.
struct RenderLoadParams @version(4) {
  /// A glTF 2.0, GLB, or .clusters file. Empty with an empty `scene` loads a **procedural**
  /// scene, which is what needs no content at all; `procedural` says which one.
  mesh: string
  /// A scene file: {"meshes":[{"path":"..."}],"instances":[{"mesh":0,"translation":[x,y,z],
  /// "rotation":[x,y,z,w],"scale":[x,y,z]}]}, with paths relative to the file.
  scene: string
  settings: RenderSettings
  /// n: place the one mesh n x n times with varied rotation and scale.
  grid_instances: u32 = 0
  /// Heightfield resolution, n x n vertices, when no mesh is named.
  grid: u32 = 257
  /// Derived-data root; empty walks up from the executable to the directory holding AGENTS.md.
  ddc: string
  /// Read and write <ddc>/clusters/<key>.clusters.
  cache: bool = true
  /// Index into the sorted `gpu.adapters` list; used by the first render call of the process.
  adapter: u32 = 0
  /// The streaming page byte target, for the **procedural heightfield only** (0 is the default
  /// target, 131072). A glTF's and a container's page layout is fixed, because the target is part
  /// of the derived-data cache key and two targets are two different containers; the heightfield
  /// has no cache entry, so a caller that wants many small pages — a test, or a measurement of
  /// what a budget does — may say so. It is a *load* parameter and not a `RenderSettings` field
  /// because it changes what loading produces: the page layout renumbers the scene's clusters,
  /// and a `SceneData` outlives a settings change in this host. `settings.stream` is what turns
  /// the page table on; this only sizes it.
  page_bytes: u32 = 0 @since(2)
  /// Which procedural scene an empty `mesh` and `scene` build: "" or "heightfield" is the
  /// dunes-and-ridges grid, "shredded-atlas" is the UV-atlas stress fixture of
  /// docs/subsystems/geometry.md ("The shredded atlas") — a torus whose atlas is hundreds of
  /// small islands, with a probe texture whose colour encodes atlas position, so a LOD collapse
  /// that crosses an island edge shows as the wrong colour rather than as nothing. It is
  /// procedural so the scene corpus can guard that defect on a fresh clone with no asset.
  procedural: string @since(3)
  /// A landmark overlay manifest (`engine.scene.Overlay`) for a `scene` file: its entries replace
  /// the scene's meshes that name their content hashes. Empty: none.
  overlay: string @since(4)
}

/// A loaded scene: the id later calls name it by, and what loading found.
struct RenderSceneInfo @version(1) {
  scene: string
  adapter: string
  meshes: u32 = 0
  instances: u32 = 0
  /// The (instance, cluster) prefix sum the cull dispatch covers.
  pairs: u32 = 0
  clusters: u32 = 0
  leaf_clusters: u32 = 0
  triangles: u32 = 0
  lod_levels: u32 = 0
  /// glTF primitives merged into the first mesh; 0 for a container or the heightfield.
  mesh_primitives: u32 = 0
  /// "miss" built from the source, "hit" read from the cache, "file" a container named
  /// outright, "none" the heightfield or no cache.
  mesh_cache: string
  build_ms: f64 = 0
  /// The scene's bounding sphere: what a camera frames and what every distance scales with.
  center: vec3
  radius: f32 = 0
  /// The settings as the device and the scene resolved them, which is what will actually run.
  raster: string
  shadows: string
  cull: bool = false
  occlusion: bool = false
  deform: string
  rt_templates: bool = false
}

/// An explicit camera. `znear` of zero is a hundredth of the scene radius, as engine-view uses.
struct RenderCamera @version(1) {
  position: vec3
  target: vec3
  fov_deg: f32 = 55
  znear: f32 = 0
}

/// A camera on the orbit engine-view uses, in the scene's own scale: `distance` is in tenths of
/// the scene radius (0 is the rest distance, 22), `yaw_deg` turns around the scene's up axis,
/// and `pitch_deg` is the elevation above the orbit circle. The default pitch is engine-view's
/// fixed height factor, so `{distance: 22}` is `engine-view --orbit 22` at frame 0.
struct RenderOrbit @version(1) {
  distance: f32 = 0
  yaw_deg: f32 = 0
  pitch_deg: f32 = 24.2277
}

/// What a reference render is asked for (docs/plan/04-renderer.md §4.8,
/// docs/subsystems/renderer.md "Reference renderer"). The reference traces the acceleration
/// structures the real-time frame builds, so the scene's settings have to build them —
/// `"shadows":"rt"` or `"raster":"rt"`, which `"auto"` gives on a device that can.
struct RenderReference @version(1) {
  /// Total samples per pixel. The noise floor per scene is in docs/subsystems/renderer.md.
  spp: u32 = 256
  /// Scattering events after the primary hit. 1 is direct lighting plus one bounce, which is
  /// what the real-time resolve approximates with its hemisphere ambient.
  bounces: u32 = 3
  /// Build the structures from the finest clusters (LOD threshold 0) instead of from the frame's
  /// own cut, so the picture is a reference for the source geometry rather than for the geometry
  /// LOD selection chose.
  finest: bool = false
  /// The same seed and the same batch size give the same bytes.
  seed: u32 = 1
  /// Samples per dispatch: progress granularity, and how long one submission runs.
  batch: u32 = 8
}

/// Parameters of `render.capture`. With neither `camera` nor `orbit` the default orbit frames
/// the scene.
struct RenderCaptureParams @version(2) {
  scene: string
  camera: RenderCamera?
  orbit: RenderOrbit?
  width: u32 = 1280
  height: u32 = 720
  /// Any of "color", "ids", "depth", "normals"; empty means ["color"]. `ids` and `depth` come
  /// out of the visibility buffer, which `"raster":"direct"` does not write.
  channels: string[]
  /// Directory the files go in, created when absent.
  out_dir: string
  /// Base name; the color channel is <name>.png and the others <name>.<channel>.<ext>.
  name: string = "capture"
  /// Frame number, which drives the orbiting lights and the deformation phase.
  frame: u64 = 0
  /// "realtime" (the default, and what every caller before this field got) or "reference": the
  /// converged path trace of the same frame, written to the same files. A reference capture has
  /// only a color channel — a path tracer writes no visibility buffer, so there are no ids, no
  /// depth and no normals to read back.
  integrator: string = "realtime" @since(2)
  /// The reference settings, read only when `integrator` is "reference".
  reference: RenderReference @since(2)
}

/// GPU milliseconds per pass, averaged over the frames whose timestamps came back (`frames`,
/// which is short of the frames rendered by the frames in flight, because a timestamp pool is
/// read when its slot is reused). `rt` is the whole acceleration structure chain and `clas` the
/// cluster structure build inside it.
struct RenderGpuMs @version(2) {
  cull: f64 = 0
  hw: f64 = 0
  sw: f64 = 0
  hiz: f64 = 0
  resolve: f64 = 0
  rt: f64 = 0
  clas: f64 = 0
  deform: f64 = 0
  trace: f64 = 0
  /// The cascaded shadow maps' passes (light-view culls, the cascades' pool and index passes, the
  /// depth raster) and the culls' share of them; their filtering is in `resolve`.
  shadow: f64 = 0 @since(2)
  shadow_cull: f64 = 0 @since(2)
  total: f64 = 0
  frames: u64 = 0
}

/// Device-local memory around a measurement (`gfx::MemoryBudget`, VK_EXT_memory_budget).
/// `device_local_total_mib - budget_mib` is a lower bound on the share other processes hold —
/// the Vulkan budget under-reports a CUDA tenant — and `used_mib` is this process's own. Read
/// `machine_state.gpu_memory_used_mib` beside it. All zero without the extension.
struct RenderGpuMemory @version(1) {
  budget_mib: u64 = 0
  used_mib: u64 = 0
  device_local_total_mib: u64 = 0
}

/// What else the machine was doing while a measurement was taken (docs/subsystems/bench.md,
/// "Measuring on a shared machine"). Every field is null where the platform could not answer,
/// so a reader can tell "quiet" from "not measured". No process names are ever reported.
struct MachineState @version(1) {
  /// Percentages of the whole machine: 100 is every logical CPU busy. "others" is total minus
  /// this process's own.
  cpu_total_pct: f64?
  cpu_own_pct: f64?
  cpu_others_pct: f64?
  gpu_util_pct: f64?
  gpu_memory_used_mib: u64?
  gpu_memory_total_mib: u64?
  /// Windows only: a lock screen is up. Null anywhere else, never false by assumption.
  session_locked: bool?
}

/// The machine's state at both ends of a run.
struct MachineStateSpan @version(1) {
  start: MachineState
  end: MachineState
}

struct RenderStats @version(8) {
  /// Frames submitted.
  frames: u64 = 0
  /// The last frame's surviving (instance, cluster) pairs, by the draw that produced them.
  visible_hw: u32 = 0
  visible_pass2: u32 = 0
  visible_sw: u32 = 0
  visible_pairs: u32 = 0
  visible_min: u32 = 0
  visible_max: u32 = 0
  /// The last frame's shadow casters: pairs the cone test kept out of the picture and the frame
  /// built into its acceleration structures anyway (`RenderSettings.shadow_casters`). Not in
  /// `visible_pairs`, because nothing draws them.
  shadow_casters: u32 = 0 @since(5)
  /// Wall time inside the renderer's own submit, per frame.
  cpu_ms_per_frame: f64 = 0
  gpu_ms: RenderGpuMs
  gpu_memory: RenderGpuMemory @since(2)
  /// One entry per view of the layout the frame was drawn with, in target order.
  views: RenderViewStats[] @since(3)
  /// The layout the frame was drawn with, and how much wider a Panini view's rectilinear source
  /// had to be than its picture (1 for every other layout).
  view_layout: string = "single" @since(3)
  oversample: f32 = 1 @since(3)
  /// Geometry residency over the run. Present on every result so a script never has to test for
  /// it; `stream.pages_total` is 0 when the scene was uploaded whole.
  stream: RenderStreamStats @since(4)
  /// The vertex path's indexed draw in the last frame, both hardware passes and every view: the
  /// triangles the cut's clusters hold, which is what it draws (three indices each), and how many
  /// of those clusters its index budget had no room for, which the capacity draw drew instead at
  /// one vertex invocation per corner of the cluster's whole capacity. Both 0 on every other draw.
  triangles_hw: u64 = 0 @since(6)
  vertex_fallback: u32 = 0 @since(6)
  /// The ray tracing chain's memory and what it built (see `RenderRtStats`).
  rt: RenderRtStats @since(7)
  /// The last frame's cascaded shadow maps: the pairs every cascade's light-view cull drew into
  /// the atlas, summed over the cascades, and on the vertex path's indexed draw the cascades'
  /// survivors its index budget sent to the capacity draw. Not in `visible_pairs`.
  shadow_pairs: u32 = 0 @since(8)
  shadow_fallback: u32 = 0 @since(8)
}

struct RenderCaptureResult @version(2) {
  width: u32 = 0
  height: u32 = 0
  /// Pixels the scene covered. Zero for a reference capture, which has no visibility buffer to
  /// count them from.
  covered: u32 = 0
  /// The covered depth range the depth PNG is normalized over (reversed-Z clip depth).
  depth_min: f32 = 0
  depth_max: f32 = 0
  /// Channel name to file URI: "color", "ids", "ids_header", "depth", "normals".
  files: map<string, string>
  /// The id buffer's header, so a client that has the bytes needs no second read.
  ids_header: string
  stats: RenderStats
  /// Which integrator drew it, echoed back so a caller that asked for "reference" and got a
  /// picture knows it did.
  integrator: string = "realtime" @since(2)
  /// Reference captures only: the samples per pixel that accumulated, the integrator's own GPU
  /// milliseconds, and the wall time the render took.
  samples: u32 = 0 @since(2)
  trace_ms: f64 = 0 @since(2)
  seconds: f64 = 0 @since(2)
}

/// Parameters of `render.benchmark`. Without `camera_path` the camera is held still for every
/// frame, so the LOD cut is the same one each time; the frame number still advances, so the
/// lights orbit and a deformed scene deforms. With one, the run is a flythrough
/// (docs/plan/09-testing-profiling.md §9.4): the path is flown `repeats` times after `warmup`
/// frames at its first camera, `frames` is ignored, and the result's `flythrough` carries the
/// median, p95 and p99 per pass over the path's frames — the same summary `engine-view
/// --benchmark` ends its `.jsonl` with, minus the per-frame lines.
struct RenderBenchmarkParams @version(2) {
  scene: string
  width: u32 = 1280
  height: u32 = 720
  frames: u32 = 60
  camera: RenderCamera?
  orbit: RenderOrbit?
  /// Render with these instead of the ones the scene was loaded with; the scene itself is not
  /// reloaded, only its GPU buffers and pipelines are rebuilt.
  settings: RenderSettings?
  /// A camera path file (`engine.scene.CameraPath`), resolved against the loaded scene's terrain.
  camera_path: string @since(2)
  /// Frames to sample the path at; 0 is its own frame count.
  path_frames: u32 = 0 @since(2)
  repeats: u32 = 1 @since(2)
  warmup: u32 = 0 @since(2)
  /// And at least this many seconds of warm-up frames: a fast card needs time, not frames, to
  /// bring its clocks up.
  warmup_seconds: f64 = 0 @since(2)
}

struct RenderBenchmarkResult @version(3) {
  width: u32 = 0
  height: u32 = 0
  raster: string
  shadows: string
  /// Wall time of the whole run, including the wait for the last frame.
  seconds: f64 = 0
  stats: RenderStats
  /// Sampled around the run, not inside it, so the frame times are not the sampler's. A run
  /// whose numbers were taken beside another process's work is an upper bound, and the host
  /// says so on stderr as well.
  machine_state: MachineStateSpan @since(2)
  /// A flythrough's summary, when the parameters named a camera path.
  flythrough: engine.scene.FlythroughSummary? @since(3)
}

/// Parameters of `render.compare` (docs/plan/04-renderer.md §4.8): the accept-or-reject gate of
/// the optimization loop, beside `render.capture` which produces what it measures.
struct RenderCompareParams @version(1) {
  a: string
  b: string
  /// "none", or "center" to pool the per-pixel error under a Gaussian attention region, so a
  /// regression in the corner of a 48:9 frame weighs less than one in the middle.
  weights: string = "none"
  /// Pixels per degree of visual angle the contrast-sensitivity filter is evaluated at.
  ppd: f32 = 67.0206
  /// Write the per-pixel FLIP error as a heat map here.
  flip_out: string
}

struct RenderCompareResult @version(1) {
  width: u32 = 0
  height: u32 = 0
  /// Null for two identical images, where the value is infinite and a large number would read
  /// like "nearly identical"; `identical` says which.
  psnr: f64?
  identical: bool = false
  ssim: f64 = 0
  flip_mean: f64 = 0
  flip_p95: f64 = 0
  flip_max: f64 = 0
  flip_weighted_mean: f64 = 0
  /// File URI of the heat map, when one was asked for.
  flip_image: string
  /// Wall time of the metrics themselves.
  ms: f64 = 0
}

// ---- render.evaluate ---------------------------------------------------------------------------
// Plan 04 §4.8's optimization loop as one call (06 §6.9, "exposed to agents as a single tool"):
// render the same frame twice, once through the real-time path and once through the reference,
// compare them, write the two pictures and the FLIP heat map, and return the numbers and the
// times. Everything it does can be done with render.capture twice and render.compare once; the
// point of the method is that a change is accepted or rejected on **one** answer, taken under one
// camera, one frame number and one set of lights, which is what makes the loop mechanical.

/// One pair's metrics, the same numbers `render.compare` returns for two files.
struct RenderMetrics @version(1) {
  /// Null for two identical images, where the value is infinite.
  psnr: f64?
  identical: bool = false
  ssim: f64 = 0
  flip_mean: f64 = 0
  flip_p95: f64 = 0
  flip_max: f64 = 0
  flip_weighted_mean: f64 = 0
}

struct RenderEvaluateParams @version(1) {
  scene: string
  camera: RenderCamera?
  orbit: RenderOrbit?
  width: u32 = 1280
  height: u32 = 720
  /// Frame number: both pictures use it, so both get the same lights.
  frame: u64 = 0
  /// Render the real-time picture with these instead of the ones the scene was loaded with.
  settings: RenderSettings?
  reference: RenderReference
  /// Also render the reference at one bounce and compare against that too, which says how much
  /// of the difference is **indirect** light the real-time path does not have. It costs a second
  /// reference render, so a caller measuring a hot loop turns it off.
  direct_only: bool = true
  /// "none", or "center" to pool the per-pixel error under a Gaussian attention region.
  weights: string = "none"
  ppd: f32 = 67.0206
  /// Directory the three or five files go in, created when absent.
  out_dir: string
  name: string = "evaluate"
}

struct RenderEvaluateResult @version(1) {
  width: u32 = 0
  height: u32 = 0
  /// "realtime", "reference", "flip", and — with `direct_only` — "reference_direct" and
  /// "flip_direct", each a file URI.
  files: map<string, string>
  /// The real-time picture against the full reference: the gate.
  full: RenderMetrics
  /// The real-time picture against the reference at one bounce. The difference between this and
  /// `full` is the indirect light the real-time path does not have, which is why a threshold on
  /// a scene with interiors is large and one on an open scene is not.
  direct: RenderMetrics?
  /// The real-time frame's statistics, so a caller has the picture, the error, and the cost from
  /// one call.
  stats: RenderStats
  /// Samples per pixel that accumulated, the integrator's own GPU milliseconds, and the wall
  /// time of each render.
  samples: u32 = 0
  reference_trace_ms: f64 = 0
  reference_seconds: f64 = 0
  realtime_seconds: f64 = 0
  metrics_ms: f64 = 0
  /// Sampled around the run, not inside it. A number taken beside another process's work is an
  /// upper bound, and the host says so on stderr as well.
  machine_state: MachineStateSpan
}

// ---- render.unload and render.scenes -----------------------------------------------------------
// A scene is the host's, not a session's (docs/subsystems/protocol.md): `render.load` makes one and
// it lives until `render.unload` releases it or the host exits. A client that loads many distinct
// scenes over a long session — an agent comparing assets through engine-mcp, whose host lives as
// long as the agent's client does — would otherwise hold every one of them, GPU buffers and all,
// and a client that can release scenes has to be able to see which it holds.

/// Parameters of `render.unload`.
struct RenderUnloadParams @version(1) {
  /// The id `render.load` returned.
  scene: string
}

/// What `render.unload` released. The id names nothing afterwards: every render method that is
/// given it answers 1003 NotFound, the answer for an id that never existed, with a message that
/// says it was unloaded. Ids are never reused.
struct RenderUnloadResult @version(1) {
  scene: string
  /// What the scene held, as `render.load` counted it.
  meshes: u32 = 0
  instances: u32 = 0
  clusters: u32 = 0
  triangles: u32 = 0
  /// Whether it had a GPU scene and renderer to release. `render.load` builds neither — the first
  /// capture, benchmark or evaluate does — so a scene loaded and never drawn held host memory
  /// only. And whether it had the reference path tracer too, which a reference capture or an
  /// evaluate makes and keeps.
  gpu_scene: bool = false
  reference: bool = false
  /// The material textures its GPU scene had on the device — built from the content build's
  /// `.tex` files or decoded from their images — and the device bytes of every texture it
  /// uploaded, the procedural heightfield's own included, which no material names.
  textures: u32 = 0
  texture_bytes: u64 = 0
  /// The engine allocator's heap bytes before and after (`engine.budgets`' `memory.heap`): the
  /// difference is the scene's host arrays — clusters, the LOD graph, instances, materials.
  host_heap_bytes_before: u64 = 0
  host_heap_bytes_after: u64 = 0
  /// Device-local memory this process was using before and after, as the driver reports it
  /// (VK_EXT_memory_budget); null without the extension or without a device. The driver counts
  /// the allocator's blocks, not its allocations: a scene whose buffers fit in blocks another
  /// scene opened moves it by nothing either way, and the allocator may keep an emptied block for
  /// its next allocation (docs/subsystems/apps.md, "Scenes").
  gpu_used_bytes_before: u64?
  gpu_used_bytes_after: u64?
  /// Scenes the host still holds.
  scenes_left: u32 = 0
}

/// One scene the host holds, in `render.scenes`.
struct RenderLoadedScene @version(1) {
  scene: string
  /// "mesh", "scene" (a scene file) or "procedural", and the path it was loaded from or the
  /// procedural scene's name.
  kind: string
  source: string
  meshes: u32 = 0
  instances: u32 = 0
  /// The (instance, cluster) pairs the cull dispatch covers.
  pairs: u32 = 0
  clusters: u32 = 0
  triangles: u32 = 0
  /// Whether its GPU scene and renderer exist — the first capture, benchmark or evaluate builds
  /// them — with the frame size and the resolved settings they were last built for, and whether a
  /// reference path tracer is kept beside them.
  built: bool = false
  width: u32 = 0
  height: u32 = 0
  raster: string
  shadows: string
  reference: bool = false
  /// The material textures on the device and the bytes of every texture uploaded (as in
  /// `RenderUnloadResult`); the ray tracing chain's device bytes now (`engine.budgets`'
  /// `renderer.rt`), 0 when the frame builds none. All 0 until built.
  textures: u32 = 0
  texture_bytes: u64 = 0
  rt_bytes: u64 = 0
}

/// Result of `render.scenes`: every scene the host holds, in load order.
struct RenderScenesResult @version(1) {
  scenes: RenderLoadedScene[]
  /// The device the render methods opened, and what this process uses of its device-local memory
  /// and may use (VK_EXT_memory_budget). Empty and null until a render call has opened one;
  /// asking opens nothing.
  adapter: string
  gpu_used_bytes: u64?
  gpu_budget_bytes: u64?
  /// The engine allocator's heap bytes (`memory.heap`), of which the scenes' host arrays are part.
  host_heap_bytes: u64 = 0
}

// ---- content.build -----------------------------------------------------------------------------
// The content build over the protocol (docs/plan/07-content-pipeline.md §7.3, 06 §6.9's
// `build_content`): what `engine-content build` and `build-all` do, run in the host's own process
// through `domain/content_build` — the same code, so the same bytes, the same cache keys and the
// same skip. Paths are the host's native paths.

/// The build options of one mesh: `engine-content build`'s flags. The defaults are the build's own
/// (`content_build::MeshOptions`), and that module's test holds the two together.
struct ContentBuildOptions @version(1) {
  /// Triangles a cluster, 4..256.
  max_triangles: u32 = 124
  /// Vertices a cluster, 1..255.
  max_vertices: u32 = 64
  /// The streaming page target in bytes; 0 writes no page table. It is part of the cache key.
  page_bytes: u32 = 131072
  /// Weld the file's duplicate vertices; every per-vertex stream is part of the weld key.
  weld: bool = true
  /// Keep the source's morph targets. False is `--no-morph`, which moves the build key.
  morph: bool = true
  /// What a LOD collapse may do at a UV atlas island edge: "none", "protect" or "lock".
  uv_seams: string = "protect"
  /// The same at a hard shading edge.
  normal_seams: string = "none"
  /// The UV term's weight in the simplifier's error metric; 0 removes it.
  uv_weight: f32 = 0.5
  /// The normal term's weight (0.5 costs two to four times the triangles).
  normal_weight: f32 = 0
  /// "keep" the source's UV atlas, or "repack": re-chart the mesh and rebake its textures
  /// (docs/subsystems/atlas.md). A repack moves the build key.
  atlas: string = "keep"
  /// A repack's tangent-space normal maps: "convert" through object space, or "resample" as
  /// stored.
  atlas_normal_maps: string = "convert"
  /// Triangles of the simplified copy a repack's charts are cut on; 0 charts the mesh itself.
  atlas_proxy: u32 = 2000
  /// How far xatlas lets a chart grow, in thousandths of its maxCost; positive.
  atlas_chart_cost: u32 = 2000
  /// 1, 2 or 4: the atlas and every rebaked image at this multiple of the source texture's side.
  atlas_supersample: u32 = 1
}

/// Parameters of `content.build`: one source mesh (`engine-content build`) or a manifest of them
/// (`engine-content build-all`), not both.
struct ContentBuildParams @version(1) {
  /// A glTF or GLB file to build.
  source: string
  /// Where `source`'s container is written. Empty with `cache` is the derived-data cache entry
  /// the source and the options address.
  output: string
  /// A manifest, `{"meshes":[{"source","output","options"}]}`, its paths relative to itself; an
  /// entry's `options` (max_triangles, max_vertices, page_bytes, weld, atlas) override `options`.
  manifest: string
  /// The build options of `source`, and the defaults of a manifest's entries.
  options: ContentBuildOptions
  /// Outputs that name no path go to the derived-data cache.
  cache: bool = false
  /// The cache root. Empty is `<repo>/ddc`, found by walking up from the host executable to the
  /// directory holding AGENTS.md.
  ddc: string
  /// Performance-pool workers for this call; 0 is one per performance CPU. The bytes a build
  /// writes do not depend on it.
  jobs: u32 = 0
  /// Treat validation warnings as errors.
  strict: bool = false
  /// Rebuild an output that already records this source's hash and this build key. Without it
  /// such an output is skipped, as `build-all` skips it; `engine-content build` always rebuilds.
  force: bool = false
  /// Compute every built or skipped output's content-build metrics into its `stats`.
  stats: bool = true
  /// Build every image the meshes' materials sample into `<ddc>/textures/<key>.tex`
  /// (docs/subsystems/texture.md) — when the call has a derived-data root, `cache` or a named
  /// `ddc`, as engine-content does. False is `--no-textures`; the containers record the keys
  /// either way.
  textures: bool = true
}

/// One output of `content.build`: a line of `engine-content build-all`, plus its metrics.
struct ContentBuildOutput @version(1) {
  source: string
  path: string
  /// "built", "skipped" (the container there already recorded this source and these options), or
  /// "failed".
  status: string
  /// The output is the derived-data cache's entry.
  cached: bool = false
  /// The source's content hash and the build key over it and the options: what the container
  /// records, and what addresses its cache entry.
  source_hash: u64 = 0
  build_key: u64 = 0
  /// The container's size on disk.
  bytes: u64 = 0
  /// Import, validation, clustering and the write; 0 for a skip.
  build_ms: f64 = 0
  clusters: u32 = 0
  leaf_clusters: u32 = 0
  triangles: u32 = 0
  lod_levels: u32 = 0
  vertices: u32 = 0
  pages: u32 = 0
  materials: u32 = 0
  images: u32 = 0
  embedded_images: u32 = 0
  /// The container's content hash.
  hash: u64 = 0
  /// Validation warnings: `path` is the rule id (`geometry.uv_range`, `material.missing_image`),
  /// `message` the sentence.
  warnings: Diagnostic[]
  /// What the build repaired and what its atlas step did, exactly as engine-content's JSON line
  /// carries them.
  repairs: json
  atlas: json
  /// A failure's rule id and sentence.
  rule: string
  error: string
  /// The container's content-build metrics — the object `engine-content stats` prints — for a
  /// built or skipped output when `stats` was asked for; null otherwise.
  stats: json
  /// This mesh's share of the texture step, as engine-content's `textures` object with a row per
  /// image: built, skipped, shared, missing, failed or unreadable, the key, the format and the
  /// time. `enabled` false when the call had no derived-data root or asked for no textures.
  textures: json
}

struct ContentBuildResult @version(1) {
  /// In the manifest's order, whatever order the jobs finished in.
  outputs: ContentBuildOutput[]
  built: u32 = 0
  skipped: u32 = 0
  failed: u32 = 0
  /// Wall time of the whole call.
  seconds: f64 = 0
  /// The derived-data root the call used; empty when it had none.
  ddc: string
  /// The texture step's totals over every mesh: a texture two meshes share is built once, for the
  /// first. A failed texture write is counted here and does not fail the call.
  textures: json
}

// ---- session.events ----------------------------------------------------------------------------
// 06 §6.6's `events(since, filter)`: what has happened to a document, a page at a time. The
// journal is always there; the persistent world's event log (docs/plan/03-data-model.md §3.5,
// foundation/store) is read when the store capability is built and the document has one.

/// Parameters of `session.events`. Read-only.
struct SessionEventsParams @version(1) {
  session: string
  /// Which log: "journal" (the document's committed transactions), "store" (the world's event
  /// log), or empty for both, the journal's events first.
  source: string
  /// The `next` a previous call returned: continue after what it saw. Empty starts at `since`.
  cursor: string
  /// Where a read with no cursor starts: the journal's first patch index, and the event log's
  /// first simulation tick.
  since: u64 = 0
  /// Only events of this kind: "commit" for the journal, a store event's schema type id in
  /// decimal. Empty keeps every kind.
  kind: string
  /// Only events by this actor: a commit's attribution actor, or a store event's origin
  /// ("deterministic", "player", "agent", "llm", "debug"). Empty keeps every actor.
  actor: string
  /// The event log to read. Empty is the document directory's `world.db`, when there is one.
  store: string
  /// Events a page holds, 1..10000.
  limit: u32 = 100
}

/// One event of `session.events`.
struct SessionEvent @version(1) {
  /// "journal" or "store".
  source: string
  /// Journal: the patch's index. Store: the event's sequence within its tile.
  sequence: u64 = 0
  /// Store: the tile the event happened in.
  tile: u64 = 0
  /// Store: the simulation tick and game time it happened at. A journal patch has neither: an
  /// edit to the document happens outside any simulation.
  tick: u64 = 0
  game_time_us: i64 = 0
  /// Journal: "commit". Store: the event's schema type id, in decimal.
  kind: string
  /// Journal: the attribution's actor. Store: the event's origin.
  actor: string
  /// Journal: who made the change, in what role, for what task, why, and when.
  attribution: engine.doc.Attribution?
  /// Journal: the layer the patch edited and how many commands it holds.
  layer: string
  commands: u32 = 0
  /// Journal: false for a patch that has been undone and sits in the redo tail.
  applied: bool = false
  /// Store: what the event happened to, its causal parent's sequence in the same tile (0 for
  /// none), the causal chain's length, and the size of its payload.
  subject: id128
  cause: u64 = 0
  depth: u32 = 0
  payload_bytes: u32 = 0
}

struct SessionEventsResult @version(1) {
  events: SessionEvent[]
  /// Pass back as `cursor` to read what comes after. It moves only past what was returned, so it
  /// is also what to poll with.
  next: string
  /// More events matched the filter when the page filled.
  more: bool = false
  /// The journal's length and how many of its patches are applied.
  journal_total: u32 = 0
  journal_position: u32 = 0
  /// "read"; "absent" when the document has no event log; "not built" when this host was built
  /// without the store capability; "not asked" when `source` was "journal".
  store_status: string
  /// The event log's path, when there is one.
  store_path: string
}

// ---- engine.budgets ----------------------------------------------------------------------------
// 06 §6.9's `get_budgets`: the budgets the engine knows and what is using them, so a client learns
// what a budget is called before it is exceeded (ADR-0017: a limit is stated, never hidden).

struct BudgetsParams @version(1) {
  /// Only budgets whose scope starts with this: "process", "scene", "session", "adapter". Empty
  /// is every one.
  scope: string
}

/// One budget.
struct Budget @version(1) {
  /// Stable and dotted: `renderer.deform_pool`, `renderer.page_budget`, `renderer.upload_budget`,
  /// `renderer.rt`, `audio.clips`, `audio.voices`, `memory.allocations`, `memory.heap`,
  /// `gpu.memory`.
  name: string
  /// What it bounds, in a sentence.
  doc: string
  /// The limit, in `unit`. Null when the quantity is counted but nothing bounds it.
  limit: f64?
  /// What is using it now, in `unit`. Null when nothing in this host is using it yet — no scene
  /// rendered, no runtime world — which is not the same as 0.
  used: f64?
  /// The most it has used, where its owner keeps that.
  peak: f64?
  /// "bytes", "bytes/frame", "voices" or "allocations".
  unit: string
  /// Where the limit comes from: "tunable", "setting" (a render setting or a flag), "default" (a
  /// compile-time constant a setting overrides), "device", or "counter".
  source: string
  /// The tunable's name, the setting that sets it, or the device's name.
  key: string
  /// "process"; "scene:<id>" for a loaded scene; "session:<id>" for a session's runtime world;
  /// "adapter:<index>" for a GPU.
  scope: string
}

struct BudgetsResult @version(1) {
  budgets: Budget[]
}

// ---- session.materialize -----------------------------------------------------------------------
// The document into the session's runtime world (docs/plan/03-data-model.md §3.4): the mapping
// table schemac compiled, the driver's walk, and what it did. `session.run_headless` materializes
// too; this is the same pass on its own, with the report in full.

/// Parameters of `session.materialize`.
struct MaterializeParams @version(1) {
  session: string
  /// "whole" (every live record), "tile" (the records of tile `tile_x`, `tile_y` of the partitioned
  /// layers that define them), or "untiled" (every record in no tile).
  scope: string = "whole"
  tile_x: i32 = 0
  tile_y: i32 = 0
}

/// One record type a materialization met.
struct MaterializeTypeReport @version(1) {
  /// The qualified type name.
  type: string
  /// The type has a `materialize` declaration in this build.
  mapped: bool = false
  /// Live records of the type in scope that the pass looked at.
  records: u32 = 0
  /// Of those, the ones with an entity after the pass.
  materialized: u32 = 0
  skipped: u32 = 0
  /// Why the first skipped record was skipped: "no mapping" (document-only by design), "unknown
  /// type" (not in this build's schema registry), "tier", "missing component" (with the
  /// component in `detail`), "no entity store" (a build without the ECS), or "no hook".
  reason: string
  detail: string
}

/// One skipped record, by id.
struct MaterializeSkip @version(1) {
  id: id128
  type: string
  reason: string
}

/// One row of a mapping: a component field and the record property it comes from.
struct MaterializeFieldInfo @version(1) {
  component: string
  field: string
  property: string
  /// component = property × scale + offset when the two sides declare different `@unit`s.
  scale: f64 = 1
  offset: f64 = 0
  converted: bool = false
  /// The world writes this field back to the record at `Persist`.
  write_back: bool = false
}

/// A record type's mapping, as the build compiled it.
struct MaterializeMapping @version(1) {
  record: string
  components: string[]
  fields: MaterializeFieldInfo[]
  /// "ChildOf" or "none": what the document's parent becomes.
  parent: string
  /// The LOD tiers the type materializes at.
  tiers: u8[]
}

/// Result of `session.materialize`, and the pass `session.run_headless` reports.
struct MaterializeResult @version(1) {
  /// A full pass compared every live record in scope; otherwise the pass followed the document's
  /// change feed and looked only at what changed.
  full: bool = false
  /// The document revision the world now reflects.
  revision: u64 = 0
  visited: u32 = 0
  created: u32 = 0
  updated: u32 = 0
  /// Looked at and left alone: already in sync.
  unchanged: u32 = 0
  dematerialized: u32 = 0
  /// Held records materialized again because their parent now has an entity.
  relinked: u32 = 0
  skipped: u32 = 0
  /// Entities materialized from the document after the pass.
  live: u32 = 0
  /// Held records whose document parent has no entity.
  orphans: u32 = 0
  /// Wall time of the pass.
  ms: f64 = 0
  /// The tier records are materialized at.
  tier: u8 = 0
  /// By type name.
  types: MaterializeTypeReport[]
  /// The first skipped records, in walk order; the counts above are complete.
  skips: MaterializeSkip[]
  /// Every mapping this build has, whether or not the document uses it.
  mappings: MaterializeMapping[]
}

// ---- session.run_headless ----------------------------------------------------------------------
// 06 §6.9's `run_headless(seconds | until predicate)`: step the session's runtime world at the
// fixed step with no rendering (06 §6.11's headless `sim` mode). The world is the host's, one per
// session, made on the first call and kept while the host runs, so a second call continues where
// the first stopped. Every call first materializes the document into it (all of it on the first
// call, what changed since on later ones), and what systems change in the writable fields comes
// back as commits attributed to `system` (docs/subsystems/protocol.md, "session.run_headless").

/// Parameters of `session.run_headless`.
struct RunHeadlessParams @version(2) {
  session: string
  /// Game seconds to advance at the fixed step; with `until`, the most to advance before giving
  /// up. 0..3600.
  seconds: f64 = 0
  /// Stop as soon as this holds; it is tested before the first tick and after every one. Terms:
  /// `{"object": "<id>", "property": "<name>", <test>}` (a live document object's composed
  /// property), `{"object": "<id>", "component": "<type>", "field": "<name>", <test>}` (a field of
  /// a live entity's component, the entity being the object's materialization), where `<test>` is
  /// `"equals": <value>`, `"at_least": <number>` or `"at_most": <number>` and a name may end in
  /// `[i]` to take one element of an array; `{"object": "<id>", "exists": true|false}`;
  /// `{"ticks_at_least": n}` and `{"seconds_at_least": s}` (this call's own ticks and game
  /// seconds); and `{"all": [...]}`, `{"any": [...]}`, `{"not": term}` over them. Null runs the
  /// whole `seconds`.
  until: json
  /// How often, in ticks, what systems changed in the writable fields is committed to the document
  /// (one transaction attributed to `system`, and an event in the store's log when the document
  /// has one). 0 commits only when the call returns, which it always does with whatever is left.
  write_back_every: u32 = 60 @since(2)
}

struct RunHeadlessResult @version(2) {
  /// Ticks this call ran, and the game time they advanced.
  ticks: u64 = 0
  game_seconds: f64 = 0
  /// Wall time of the ticks, which says how much faster than real time the world runs.
  wall_ms: f64 = 0
  /// The predicate's value when the call returned; null without `until`.
  predicate: bool?
  /// "seconds" (the time ran out) or "predicate" (`until` held).
  stopped: string
  /// The world's own tick and game time after the call: they count across calls.
  tick: u64 = 0
  game_time_us: i64 = 0
  /// The fixed step's rate.
  hz: u32 = 0
  /// "ecs" (a flecs world, its systems run inside the scheduler's phases), or "scheduler"
  /// (`sim::SimScheduler` alone, in a build without the ECS capability, which materializes nothing).
  world: string
  /// The systems the world ticks, by name: the flecs systems in registration order, then the
  /// scheduler's own table (`sim.write_back`).
  systems: string[]
  /// Entities with a persistent identity (an `Id128`) in the world; always 0 in the scheduler's.
  entities: u32 = 0
  /// Entities materialized from the document and held by the driver after the call.
  materialized: u32 = 0
  /// What owns the tick: "scheduler" — `sim::SimScheduler`, with flecs' systems run inside each of
  /// its phases (ADR-0038, proposed).
  executor: string @since(2)
  /// The materialization this call made before its first tick.
  materialize: MaterializeResult? @since(2)
  /// Write-back commits this call made, and the fields they wrote.
  write_backs: u32 = 0 @since(2)
  written_fields: u32 = 0 @since(2)
}

// ---- engine.run_tests --------------------------------------------------------------------------
// 06 §6.9's `run_tests`: the engine's own checks that are safe to run inside a host — the document
// validators, the tissue validators and the content validators — as one structured report. It
// never spawns a process (ctest and the test executables are CI's) and never opens a socket.

/// Parameters of `engine.run_tests`. Every input is optional; an empty call checks nothing.
struct RunTestsParams @version(1) {
  /// A session whose document to check: `doc.validate` and the composed index's own check.
  session: string
  /// A tissue definition, a `.tissue` container or an interchange `.json`, to run the tissue
  /// validators over.
  tissue: string
  /// Also transfer every tissue binding under the other two normal modes and compare them.
  tissue_modes: bool = true
  /// Built `.clusters` containers to run the content checks over.
  containers: string[]
}

/// One check of `engine.run_tests`.
struct TestCheck @version(1) {
  /// "document", "tissue" or "content".
  suite: string
  /// The check's stable id: `doc.schema`, `doc.index`, `content.read`, `content.lod`,
  /// `content.pages`, `content.identity`, `content.images`, `content.cluster_budget`, or a tissue
  /// validator row's own id.
  id: string
  /// What it ran on: the session, the file, or a tissue row's subject.
  subject: string
  /// "error", "warning" or "info".
  severity: string
  /// "pass", "fail", "skipped" or "info".
  verdict: string
  /// What was checked and, when it failed, what was found.
  message: string
  /// Pathed findings: the document validator's `<layer>/<id>/<property>` paths.
  diagnostics: Diagnostic[]
  /// A tissue row's measured value; null elsewhere.
  value: json
}

struct RunTestsResult @version(1) {
  /// No error-severity check failed.
  ok: bool = false
  checks: TestCheck[]
  passed: u32 = 0
  /// Checks whose verdict is "fail": `errors` of them error-severity, `warnings` warning-severity.
  failed: u32 = 0
  errors: u32 = 0
  warnings: u32 = 0
  skipped: u32 = 0
}
