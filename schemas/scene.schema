// Scene descriptions, camera paths and flythrough records (docs/plan/09-testing-profiling.md §9.4,
// docs/subsystems/renderer.md "Scenes, camera paths and flythroughs"). A scene file is what
// `engine-view --scene` and `render.load`'s `scene` read; a camera path is what
// `engine-view --camera-path` and `render.benchmark`'s `camera_path` fly; the records are what a
// flythrough benchmark writes, one per frame, and the summary it ends with.
//
// **Why a JSON file keyed to schema types, and not a document layer.** The plan says a world is a
// `doc::Document` (03 §3.2), and a benchmark scene will become a layer export once placements are
// document objects with a transform property. It is not one yet for three reasons: the renderer
// reads scenes and must not depend on the document model's journal, undo and ids to do it; a
// corpus scene is a fixture whose identity is its bytes, so one committed file that diffs as text
// and hashes as a unit is the honest unit; and the types below are chosen to map one-to-one onto
// the placement objects a layer will hold (`Instance` is a placement, `Scatter` a generator of
// them), so the move is an export, not a redesign.
namespace engine.scene

/// How a mesh is scaled and placed in its own space before any instance transform applies. A
/// fitted mesh occupies the same volume whichever file stands in for it, which is what lets a
/// substitute and the owner's landmark share one set of placements.
struct Fit @version(1) {
  /// Scale uniformly so the mesh's bounding box is this many metres tall. 0: no height fit.
  height: f32 = 0
  /// Scale uniformly so the longest side of the box is this many metres. Used when `height` is 0.
  extent: f32 = 0
  /// Move the box's bottom centre to the mesh's origin, so an instance placed on a point stands
  /// on it. False centres the box on the origin instead.
  ground: bool = true
}

/// One mesh a scene draws.
struct Mesh @version(1) {
  /// What the README, the overlay and a run's summary call it.
  name: string
  /// A glTF, GLB or .clusters file, relative to the scene file.
  path: string
  /// `assets::source_mesh_hash` of `path`, as 16 lower-case hex digits. A load whose file hashes
  /// differently fails, because a number measured on other bytes would carry this scene's name.
  /// Empty: not checked.
  hash: string
  /// The content hash of the mesh an overlay manifest may put in this one's place, in the same
  /// form as `hash`. The scene names the replacement only by its bytes; where it lives is the
  /// manifest's business, which is what keeps a paid-plan asset out of the repository.
  overlay: string
  fit: Fit?
}

/// A skinned instance's clip, carried for the host and never read by the renderer.
struct Animation @version(1) {
  /// The clip's name; empty is the skin's first clip.
  clip: string
  speed: f32 = 1
  /// Seconds added to the starting playhead.
  phase: f32 = 0
}

// ---- Ruins assembled from a kit (docs/subsystems/ruins.md, plan 07 §7.6) -----------------------
//
// A ruined building is a kit's wall members placed at right angles by a seeded assembler, never
// one asset. The kit is data: what each member is, where its neighbours join it and which side is
// outside, and the parameters of the profile's grammar and ruin rule. The real kits live outside
// the repository beside their meshes; the tests generate a kit of boxes.

/// Which slot of the assembler's grammar a kit member can fill.
enum RuinPieceKind : u8 {
  /// A straight run of wall between two sockets, a whole number of the kit's module long.
  Section = 0
  /// An outside (convex) right-angle corner: the quoins where two walls meet.
  Corner = 1
  /// A straight member with a doorway through it, lintel included.
  Doorway = 2
  /// A straight member with a window: an opening with a sill, lintel included.
  Window = 3
  /// A loose block the collapse leaves on the ground. No sockets.
  Debris = 4
  /// An inside (reflex) corner. Optional: without one, an outside corner turned half round
  /// stands in for it.
  InsideCorner = 5
}

/// Where a neighbour joins a kit member: a point on the wall's centre line at ground level, in
/// the member's frame (after `offset` and `yaw_deg`).
struct RuinSocket @version(1) {
  position: vec3
  /// The wall's direction of travel through the socket, going round the footprint with the
  /// building's inside on the left seen from above: into the member at its first socket, out of
  /// it at its second.
  direction: vec3
  /// Which side is outside: the wall's outward normal at the socket.
  outside: vec3
}

/// One member of a kit.
struct RuinMember @version(2) {
  name: string
  kind: RuinPieceKind = Section
  /// A glTF, GLB or .clusters file, relative to the kit file.
  mesh: string
  /// `assets::source_mesh_hash` of `mesh`, 16 lower-case hex digits; empty: not checked.
  hash: string
  /// Brings the mesh into the member's frame: translate by `offset`, then turn by `yaw_deg`
  /// about +y (a multiple of 22.5). The frame has the wall's first socket at the origin and the
  /// wall running along +x with the building's inside toward -z.
  offset: vec3
  yaw_deg: f32 = 0
  /// Metres from the ground to the member's top line. Members of one length and kind that differ
  /// only in this are the ruin rule's height variants.
  height: f32 = 2.4
  /// A section, doorway or window has two (its start and its end); a corner has two (where the
  /// incoming wall joins it and where the outgoing wall leaves it); debris has none.
  sockets: RuinSocket[]
  /// An opening's span along the member from its first socket, and its sill and head heights,
  /// metres. Doorways and windows only.
  opening_start: f32 = 0
  opening_end: f32 = 0
  sill: f32 = 0
  head: f32 = 0
  /// A debris piece's footprint radius on the ground, metres.
  radius: f32 = 0.3
  /// Relative weight among the members that could fill the same slot. A kit's debris pieces are
  /// weighted inversely by volume (E33), so that every pick brings about the same stone.
  weight: u32 = 1
  /// A debris piece's volume, cubic metres: what the rubble rule counts it as when it heaps pieces
  /// to the profile's block on a rubble site (docs/subsystems/ruins.md, "The rubble rule"). Zero:
  /// estimated as the square prism of its height inscribed in its radius, 2 r^2 h, which is more
  /// than a broken stone fills.
  volume: f32 = 0 @since(2)
}

/// A profile's grammar and ruin rule. Fractions are of the intact wall's height; lengths are
/// metres. Every seeded decision the rule makes is integer arithmetic on these, converted once.
struct RuinRules @version(1) {
  /// Relative weights of the four footprints. A shape the kit's corners cannot close falls back
  /// to a rectangle.
  rectangle: u32 = 4
  l_shape: u32 = 2
  u_shape: u32 = 1
  courtyard: u32 = 1
  /// A wall's fill between its corners, in modules.
  min_fill: u32 = 1
  max_fill: u32 = 5
  /// Orientations a building may take: 1, 2, 4, 8 or 16 over the full turn.
  yaw_steps: u32 = 16
  /// The chance a wall is collapsed to a height fraction, and breached (a gap, standing either
  /// side), and what facing the wind adds to both.
  collapse: f32 = 0.3
  breach: f32 = 0.25
  windward: f32 = 0.2
  /// The height fraction a collapsed wall stands to.
  collapse_min: f32 = 0.15
  collapse_max: f32 = 0.6
  /// A breach's width, metres.
  breach_min: f32 = 1.5
  breach_max: f32 = 4
  /// What an exposed (outside) corner loses beyond its walls, as a height fraction, and how far
  /// along the walls the loss reaches, metres.
  corner_drop: f32 = 0.2
  corner_reach: f32 = 3
  /// A section asked to stand lower than this fraction is left out.
  min_height: f32 = 0.12
  /// How much of its own height a member may sink into the ground to stand lower than it is.
  max_sink: f32 = 0.5
  /// The chance a wall still standing gets an opening.
  opening: f32 = 0.6
  /// The rubble rule, which both representations of a building lay (docs/subsystems/ruins.md,
  /// "The rubble rule"): how much of a wall that came down lies beside it — rubble per module of
  /// wall fully brought down, counted in the profile's blocks (`block_length` x `course_height` x
  /// `thickness`), the rest being under the sand — how far past the wall face it spreads
  /// (metres), and the share that falls outward.
  debris_per_module: f32 = 3
  debris_spread: f32 = 1.5
  debris_outward: f32 = 0.6
  /// The sand drift a wall asks of the terrain: its height against a windward face and a lee
  /// face, metres, and how far it reaches from the face.
  drift_windward: f32 = 0.34
  drift_lee: f32 = 0.22
  drift_reach: f32 = 1.6
  /// How far every piece is set into the ground, metres, so that nothing floats on a slope.
  embed: f32 = 0.05
}

/// A kit: one profile's members and the rules its buildings are assembled by.
struct RuinKit @version(1) {
  /// "engine.ruin-kit.v1".
  format: string
  name: string
  /// "ashlar", "brick": the generator's parameter set the members were made with.
  profile: string
  /// Every straight member is a whole number of modules long, metres.
  module: f32 = 2
  /// The wall's thickness and its intact height, metres.
  thickness: f32 = 0.64
  wall_height: f32 = 2.4
  /// The profile's course height and block length, metres: with the thickness, the block the
  /// rubble rule counts in — one rubble site is a block's worth of fallen wall, whether a block
  /// kit lays a fallen block on it or the assembler a heap of debris members.
  course_height: f32 = 0.3
  block_length: f32 = 0.6
  members: RuinMember[]
  rules: RuinRules
}

// ---- The block-by-block representation (ruins.md, "The block layer") -----------------------------
//
// The same building laid block by block: every block of every course an instance of one of a
// block kit's dozen meshes, courses in running bond along each wall's centre line, quoins taking
// the corners in turn, openings spanned by lintels, the ruin rule's line deciding which blocks
// stand, and the fallen ones lying beside the wall. The footprint, the ruin states and the
// openings are the section assembler's, so the two representations are of one building.

/// A block's part in a wall.
enum RuinBlockRole : u8 {
  /// A course's block, its long face on the wall's face: every straight run is laid in these.
  Stretcher = 0
  /// A short block that closes a run too short for a stretcher.
  Half = 1
  /// A corner block: it lies along one wall with its end on the other's face, and the two walls
  /// take the corner in turn, course by course, so they interlock.
  Quoin = 2
  /// The block over an opening, bearing on both jambs.
  Lintel = 3
  /// The block under a window's opening.
  Sill = 4
}

/// One block mesh of a block kit. Its frame: the block's start end at the origin and its bottom
/// at y = 0, running along +x, centred on the wall's centre line in z, the outside at +z — after
/// `offset` and `yaw_deg`, as for a kit member.
struct RuinBlock @version(1) {
  name: string
  role: RuinBlockRole = Stretcher
  /// A glTF, GLB or .clusters file, relative to the block kit file.
  mesh: string
  /// `assets::source_mesh_hash` of `mesh`, 16 lower-case hex digits; empty: not checked.
  hash: string
  offset: vec3
  yaw_deg: f32 = 0
  /// Its size, metres: along the wall, up, and through it. A quoin's length is the wall's
  /// thickness and the bond's offset; a lintel's spans the opening and its bearings.
  length: f32 = 0.6
  height: f32 = 0.3
  depth: f32 = 0.64
  /// Weathered: what an exposed place (the broken top, a corner, a fallen block) asks for more
  /// often than a sheltered one.
  eroded: bool = false
  /// Relative weight among the blocks of one role, length and weathering.
  weight: u32 = 1
}

/// How a building's ruin reads block by block. Fractions and lengths as in `RuinRules`.
struct RuinBlockRules @version(1) {
  /// How far either side of the ruin rule's line the broken top reaches, as a fraction of a
  /// course: a block whose top is within it stands or falls by its own draw.
  top_drop: f32 = 0.5
  /// The chance a block takes an eroded variant in an exposed place (the top of what stands, a
  /// quoin, a fallen block), and anywhere else.
  eroded_exposed: f32 = 0.75
  eroded: f32 = 0.2
  /// The share of a block's length the course under it must carry for it to stand.
  support: f32 = 0.5
  /// The least a lintel bears on each jamb, metres.
  lintel_bearing: f32 = 0.2
  /// Not read. It was the share of the fallen blocks that lie beside the wall, a rule of the block
  /// kit's own; the rubble a building keeps is now its section kit's rule
  /// (`RuinRules.debris_per_module`), which both representations lay on the same sites, so that a
  /// handover between them does not change what lies on the ground.
  debris_kept: f32 = 1 @deprecated
}

/// A block kit: a dozen block meshes and the rules a wall is laid and ruined by. The footprint,
/// the wall's height and the openings come from the section kit the scatter names.
struct RuinBlockKit @version(1) {
  /// "engine.ruin-block-kit.v1".
  format: string
  name: string
  /// "ashlar": the generator's parameter set the blocks were made with.
  profile: string
  /// The course height and the wall's thickness, metres. The thickness should be the section
  /// kit's, whose footprint the blocks are laid on.
  course_height: f32 = 0.3
  thickness: f32 = 0.64
  /// The bond: "running", the one there is.
  bond: string = "running"
  blocks: RuinBlock[]
  rules: RuinBlockRules
}

/// How a scatter's buildings are drawn.
enum RuinRepresentation : u8 {
  /// Kit members, each with its own LOD DAG: few instances, many pairs.
  Sections = 0
  /// Every block an instance of one of a block kit's meshes: many instances, few pairs each.
  Blocks = 1
}

/// Ruined buildings over a square of the endless desert's tiles: a building on each of the
/// `count` tiles the world seed ranks first (or on every tile the `density` admits), each one
/// assembled from the kit by the seed and its tile. The expansion is a function of the fields and
/// the kit alone, so the same file places the same ruins on every machine.
struct RuinScatter @version(2) {
  name: string
  /// The kit (`RuinKit`), relative to the scene file.
  kit: string
  /// The world seed. With a tile's coordinates it is the only input a building is drawn from.
  seed: u64 = 1
  /// A tile's edge, metres: a building, its debris and its drift fit inside its tile.
  tile_size: f32 = 32
  /// The tiles, both corners included: tile (x, z) covers [x, x + 1) * tile_size in x and z.
  tile_min: i32[2]
  tile_max: i32[2]
  /// How many buildings: the tiles of the square whose rank under the seed is lowest. Zero uses
  /// `density` instead.
  count: u32 = 0
  /// The share of tiles that hold a building, the endless desert's rule.
  density: f32 = 0.05
  /// The direction the prevailing wind blows from, degrees about +y from +x.
  wind_deg: f32 = 0
  /// Sections (the kit's members) or blocks (the block kit's, laid on the same footprint).
  representation: RuinRepresentation = Sections @since(2)
  /// With `Blocks`: the block kit (`RuinBlockKit`), relative to the scene file.
  block_kit: string @since(2)
}

/// Where a block stands in its wall, or fell from.
struct RuinBlockTag @version(1) {
  role: RuinBlockRole = Stretcher
  /// Its course, counted from the ground.
  course: u32 = 0
  /// Lying beside the wall rather than standing in it.
  fallen: bool = false
  eroded: bool = false
}

/// What the assembler said about one placed piece.
struct RuinTag @version(2) {
  /// Which building of the file, which wall of it, and which slot along the wall (a block's
  /// place along its course, or among its wall's fallen blocks).
  building: u32 = 0
  wall: u32 = 0
  slot: u32 = 0
  /// A block standing in a wall is a `Section`'s stone, and a fallen one `Debris`.
  kind: RuinPieceKind = Section
  /// The height the ruin rule asked of the piece, as a fraction of the intact wall; a block's is
  /// the top of its course, and a fallen one's 0.
  height: f32 = 1
  /// Set when the building was laid block by block.
  block: RuinBlockTag? @since(2)
}

/// One building the assembler placed.
struct RuinSite @version(1) {
  /// The building's own seed, from the world seed and the tile: 16 lower-case hex digits.
  seed: string
  tile: i32[2]
  /// "rectangle", "l", "u" or "courtyard".
  shape: string
  /// The footprint's origin on the ground and its yaw about +y.
  origin: vec3
  yaw_deg: f32 = 0
  walls: u32 = 0
  instances: u32 = 0
}

/// The sand a wall asks the terrain to drift against it (plan 05 §5.13): a declaration for the
/// deformable-surface system, not sand. The drift stands `height` against the face and falls to
/// nothing `reach` metres out from it.
struct SandDrift @version(1) {
  building: u32 = 0
  wall: u32 = 0
  /// The wall face's ends, x and z, metres.
  from: vec2
  to: vec2
  /// The face's outward normal, x and z.
  normal: vec2
  height: f32 = 0.3
  reach: f32 = 1.6
  windward: bool = false
}

/// Instances of one mesh scattered over an annulus, from a seed: the oasis's palms are one of
/// these. The expansion is a function of the fields alone, so the same file places the same
/// instances on every machine.
struct Scatter @version(1) {
  mesh: u32 = 0
  name: string
  /// The annulus's centre, x and z.
  center: vec2
  radius_min: f32 = 0
  radius_max: f32 = 10
  count: u32 = 0
  seed: u32 = 1
  /// A uniform scale per instance, drawn between these two.
  scale_min: f32 = 1
  scale_max: f32 = 1
  /// Stand each instance on the terrain's surface, `y` metres above it (negative sinks it).
  ground: bool = true
  y: f32 = 0
}

/// One placement of one mesh.
struct Instance @version(2) {
  /// Index into the scene's `meshes`.
  mesh: u32 = 0
  name: string
  translation: vec3
  rotation: quat
  /// Degrees about +y, applied after `rotation`: the spelling a placement on a map wants.
  yaw_deg: f32 = 0
  /// Absent: 1, 1, 1.
  scale: vec3?
  /// `translation.y` is metres above the terrain's surface at (x, z) rather than absolute.
  ground: bool = false
  animation: Animation?
  /// What the ruin assembler said about this piece, when it placed it: carried for the host and
  /// never read by the renderer.
  ruin: RuinTag? @since(2)
}

/// A rock ridge: a raised band along a segment, full height on the segment and falling to nothing
/// `width` metres from it with a cosine profile, roughened by a seeded noise.
struct Ridge @version(1) {
  /// The segment's ends, x and z.
  from: vec2
  to: vec2
  height: f32 = 50
  width: f32 = 100
  /// The noise's amplitude as a fraction of `height`.
  roughness: f32 = 0.15
}

/// A bowl: `depth` metres at the centre, a smooth rim at `radius`, and the dunes flattened inside.
struct Basin @version(1) {
  center: vec2
  radius: f32 = 100
  depth: f32 = 5
}

/// Which dune field a terrain draws.
enum TerrainGenerator : u8 {
  /// A handful of seeded transverse waves round one prevailing wind: the field every terrain drew
  /// before the generator existed, and the default.
  Waves = 0
  /// The terrain capability's generator (docs/subsystems/terrain.md): parametric dunes the seeded
  /// wind has carried to `time`, flowing round the ridges and basins. A build without the
  /// capability refuses it with a sentence.
  Dunes = 1
}

/// The procedural terrain: seeded dunes, plus ridges and basins placed by hand so that a camera
/// path can be laid out against them. It is built into a cluster LOD DAG like any mesh, and its
/// derived-data cache entry is keyed by these fields, so it is content-addressed like a file.
/// Version 2 added the generator; a version 1 terrain reads as the waves it always drew.
struct Terrain @version(2) {
  /// Vertices a side. 2 to 4097.
  size: u32 = 1025
  /// Half the side, in metres: the terrain spans [-extent, extent] in x and z.
  extent: f32 = 1000
  seed: u32 = 1
  /// Amplitude of the dune field, metres.
  dune_height: f32 = 3
  /// Typical crest-to-crest distance, metres.
  dune_wavelength: f32 = 90
  ridges: Ridge[]
  basins: Basin[]
  /// Which dune field: the waves, or the terrain capability's generator.
  generator: TerrainGenerator = Waves @since(2)
  /// With the generator: the game time the dunes are drawn at, seconds since the world's epoch. The
  /// dunes migrate with it; the ridges, the basins and what ruins stand on do not.
  time: f64 = 0 @since(2) @unit(s)
  /// With the generator: the wind's mean sand flux, square metres a year (volume per metre of
  /// width). 200 is a strong trade-wind desert, where a 1 m barchan moves 200 m a year.
  sand_flux: f32 = 200 @since(2)
}

/// What a ruins entry is drawn as in one ring of a streamed world (docs/subsystems/world.md).
enum RingRuins : u8 {
  /// Laid block by block from the entry's block kit (sections when it names none).
  Blocks = 0
  /// The kit's members, with their debris.
  Sections = 1
  /// The kit's members without their debris: `ruins::Detail::walls`.
  Walls = 2
}

/// One ring of a streamed world: a radius, and what the ruins are drawn as inside it.
struct WorldRing @version(1) {
  /// Tiles, from an observer to a tile's centre; each ring's is larger than the one inside it.
  radius: f32 = 0
  ruins: RingRuins = Sections
}

/// A scene streamed tile by tile around its observers (the world capability, docs/subsystems/
/// world.md): its `ruins` entries are not assembled when the scene is read but a tile at a time as
/// the ring around the camera activates it, and dropped when it deactivates. Every field has the
/// capability's default, so `"world": {}` is a streamed scene with the default rings.
struct WorldRings @version(1) {
  /// A tile's edge, metres; the ruins entries' own `tile_size` must be the same.
  tile_size: f32 = 32
  /// Innermost first. Empty: 1.5 tiles in blocks, 8 in sections, 24 in walls only.
  rings: WorldRing[]
  /// A tile leaves a ring only this fraction past its radius.
  hysteresis: f32 = 0.15
  /// How many of the rings, innermost first, the simulation runs in: the document is materialized
  /// and the store reconciled there, and nowhere else.
  simulated: u32 = 2
}

/// A scene: meshes, placements of them, and an optional terrain.
struct Scene @version(4) {
  /// "engine.scene.v1". Empty is accepted, for the files written before the field existed.
  format: string
  name: string
  description: string
  meshes: Mesh[]
  instances: Instance[]
  scatters: Scatter[]
  terrain: Terrain?
  /// The camera path this scene is flown along, relative to the scene file: where a camera nobody
  /// scripted starts. `engine-view --interactive` without `--camera-path` or `--start` begins at
  /// its first frame rather than at the orbit, which frames the whole scene's bounds and for a
  /// 5 km desert is 9 km away. Empty: the orbit.
  camera_path: string @since(2)
  /// Ruined buildings assembled from kits when the scene is read, standing on the terrain.
  ruins: RuinScatter[] @since(3)
  /// What a scene fragment written by the assembler (`engine-content ruins`) says about its
  /// buildings and the sand their walls ask for: carried, never read by the renderer.
  ruin_sites: RuinSite[] @since(3)
  sand_drifts: SandDrift[] @since(3)
  /// Stream the scene tile by tile instead of reading it whole: its ruins entries are assembled
  /// per tile as the ring round the camera activates them. Null: everything is read at once.
  world: WorldRings? @since(4)
}

/// Where the owner's replacements for a scene's placeholders are: a local file, never committed.
struct OverlayEntry @version(1) {
  /// `assets::source_mesh_hash` of the file, 16 lower-case hex digits: the key a scene's
  /// `Mesh.overlay` names. The file is hashed on load and refused when it disagrees.
  hash: string
  /// Absolute, or relative to the manifest.
  path: string
  name: string
}

struct Overlay @version(1) {
  /// "engine.scene-overlay.v1".
  format: string
  description: string
  entries: OverlayEntry[]
}

enum Interpolation : u8 {
  /// Straight segments between keys.
  Linear = 0
  /// A cubic through every key, with tangents from its neighbours (Catmull-Rom on the key times).
  Smooth = 1
}

/// One keyframe of a camera path.
struct CameraKey @version(1) {
  /// Seconds from the path's start. Keys are in increasing time.
  time: f64 = 0
  position: vec3
  /// The point looked at. When absent, `rotation` says where the camera faces instead.
  target: vec3?
  /// -z forward, +y up. Turned into a point 100 m ahead so that both forms interpolate alike.
  rotation: quat?
  /// Vertical field of view in degrees.
  fov_deg: f32 = 55
  /// `position.y` is metres above the terrain's surface at (x, z).
  ground: bool = false
  /// `target.y` is metres above the terrain's surface at its (x, z).
  target_ground: bool = false
}

/// A named frame of a path: the frames a README tells a reader to look at.
struct CameraMarker @version(1) {
  /// At the path's own `fps`.
  frame: u32 = 0
  name: string
  note: string
}

/// A camera path: keyframes and how to get between them.
struct CameraPath @version(1) {
  /// "engine.camera-path.v1".
  format: string
  name: string
  description: string
  interpolation: Interpolation = Smooth
  /// Frames per second of path time: frame f is at time f / fps.
  fps: f32 = 60
  /// Near plane, metres. Reversed-Z, so there is no far plane.
  znear: f32 = 0.1
  keys: CameraKey[]
  markers: CameraMarker[]
}

/// GPU milliseconds of one frame, pass by pass, from `gfx::GpuTimer` (`renderer::Stats` names).
struct PassMs @version(4) {
  cull: f64 = 0
  hw: f64 = 0
  sw: f64 = 0
  hiz: f64 = 0
  resolve: f64 = 0
  /// The whole acceleration structure chain; `clas` is the cluster build inside it.
  rt: f64 = 0
  clas: f64 = 0
  deform: f64 = 0
  deform_alloc: f64 = 0
  trace: f64 = 0
  /// The sun's cascaded shadow maps: every pass that draws them (the light-view culls, the
  /// cascades' pool and index passes, the depth raster), and the culls' share of that. The
  /// filtering is in `resolve`, where it runs.
  shadow: f64 = 0 @since(3)
  shadow_cull: f64 = 0 @since(3)
  /// The sum of the timed zones: what the frame's passes cost, not its wall time.
  total: f64 = 0
  /// The bottom-level build inside `rt`: every instance's cluster structure in one command.
  blas: f64 = 0 @since(2)
  /// A streamed world's table update, on a frame that flipped to a table set behind a change:
  /// the changed instance slots copied in and their pairs expanded (pair_expand.slang). Zero on
  /// every other frame and for a scene read whole.
  tables: f64 = 0 @since(4)
}

/// One frame of a flythrough benchmark, or of an interactive session measured with
/// `engine-view --interactive --benchmark`. One line of the `.jsonl` a run writes.
struct FrameRecord @version(6) {
  /// Which pass over the path, from 0.
  repeat: u32 = 0
  /// The path frame, from 0; an interactive session's frame, from 0.
  frame: u32 = 0
  /// Path time, seconds; an interactive session's simulated time (its tick over the tick rate).
  time: f64 = 0
  /// The CPU's own milliseconds for the frame: everything from the top of the loop to the
  /// submission returning, less the waits for a free frame slot and a swapchain image — input, the
  /// camera's ticks, and recording the frame.
  cpu_ms: f64 = 0 @since(4)
  /// Wall milliseconds from the previous frame's start to this one's: the frame time a player
  /// sees, and what the window title's p99 is over. With vsync it is the display's cadence.
  frame_ms: f64 = 0 @since(4)
  /// The fixed camera ticks this frame consumed (engine-view --interactive): 0 when the frame
  /// came faster than a tick, several after a slow one. Zero on a flythrough.
  ticks: u32 = 0 @since(4)
  /// A windowed frame's waits, CPU milliseconds each, which `cpu_ms` leaves out: for the frame
  /// slot to come free (`wait_ms`, the renderer's `begin_frame`: the GPU finishing the frame that
  /// last used the slot), for a swapchain image (`acquire_ms`), and in the present call
  /// (`present_ms`); and the pacer's own wait before the frame sampled its input (`pace_ms`, zero
  /// unless `--pace` asked for one). Where the frame time goes when it is not the engine's
  /// (docs/experiments/second-interactive-session-2026-09-25.md). Zero offscreen.
  wait_ms: f64 = 0 @since(6)
  acquire_ms: f64 = 0 @since(6)
  present_ms: f64 = 0 @since(6)
  pace_ms: f64 = 0 @since(6)
  /// How far back the pacer waited before this frame: 1 (for the last present to be shown), 2
  /// (the one before it), 0 without a pacer (`docs/subsystems/apps.md`, "Pacing").
  pace_depth: u32 = 0 @since(6)
  /// The part of `cpu_ms` spent in the renderer's `submit_frame`: recording the frame and handing
  /// it to the queue. It is not all the CPU's own: a driver that presents a window through the
  /// compositor can block inside the queue submission until the swapchain image it waits on is
  /// free, which is a presentation wait wearing the CPU's name.
  submit_ms: f64 = 0 @since(6)
  /// When the frame reached the display, where the swapchain can say (VK_EXT_present_timing's
  /// first pixel out): milliseconds after the previous presented frame's (`shown_ms`, the
  /// cadence the viewer sees, 0 when unknown), and after this frame sampled its input
  /// (`latency_ms`, 0 when unknown). The second rests on the driver's clock agreeing with ours,
  /// which on the RTX 5090's it does not (it reads at least 5 ms early), so compare it between
  /// runs rather than read it as a number (`docs/subsystems/apps.md`, "Pacing").
  shown_ms: f64 = 0 @since(6)
  latency_ms: f64 = 0 @since(6)
  /// The camera the frame was drawn with (engine-view --interactive, in the window): its
  /// position, yaw and pitch (radians, the camera path's conventions), and the simulated time it
  /// stands for, seconds — `FlySession::camera_at`'s fraction of a tick past the tick before the
  /// last. Presented one after another, frames should show `pose_time` advancing by a refresh
  /// each; a frame that advanced by much less shows nearly the pose before it, which is what a
  /// viewer reads as a frame in its previous position. Zero on a flythrough.
  pose_position: vec3 @since(6)
  pose_yaw: f32 = 0 @since(6)
  pose_pitch: f32 = 0 @since(6)
  pose_time: f64 = 0 @since(6)
  /// Surviving (instance, cluster) pairs, by the draw that produced them.
  visible_pairs: u32 = 0
  visible_hw: u32 = 0
  visible_pass2: u32 = 0
  visible_sw: u32 = 0
  /// Pairs the cone test kept out of the picture that the frame still built into its
  /// acceleration structures so they cast shadows (`renderer::Stats::shadow_casters`); zero
  /// without ray-traced shadows. Not visible pairs.
  shadow_casters: u32 = 0
  /// Pairs the cascaded shadow maps' light-view culls drew into the atlas, summed over the
  /// cascades (`renderer::Stats::shadow_pairs`); zero without maps. Not visible pairs.
  shadow_pairs: u32 = 0 @since(3)
  gpu_ms: PassMs
  /// Geometry streaming during this frame: pages copied into the pool and their bytes, pages
  /// evicted, requests written, and the pages resident after it. Zero when nothing streams.
  uploads: u32 = 0
  upload_bytes: u64 = 0
  evictions: u32 = 0
  requests: u32 = 0
  pages_resident: u32 = 0
  /// Streaming's state after the frame: requests queued and not admitted, page loads outstanding,
  /// and the pages the **pool** holds — what the cull pass can draw out of, which lags the
  /// manager's `pages_resident` by the upload budget and the read latency.
  pending: u32 = 0 @since(2)
  loads_in_flight: u32 = 0 @since(2)
  pool_pages: u32 = 0 @since(2)
  /// The ray tracing chain: the cluster structures the frame built, the ones it wanted (its cut
  /// plus its shadow casters), and the capacity it built them into. `rt_wanted > rt_built` is a
  /// frame that dropped whole instances' structures (docs/subsystems/renderer.md, "The ray
  /// tracing chain's memory"). Zero without the chain.
  rt_built: u32 = 0 @since(2)
  rt_wanted: u32 = 0 @since(2)
  rt_capacity: u32 = 0 @since(2)
  /// The scene the frame culled: its instances and its (instance, cluster) pairs, one cull thread
  /// each. Constant for a scene read whole; a streamed world's tiles move both between frames.
  instances: u32 = 0 @since(5)
  pairs: u32 = 0 @since(5)
  /// A streamed world: the instance slots this frame copied into the table set it flipped to, the
  /// pairs the GPU expanded for them (zero on a frame with no change behind it), and the pairs of
  /// the dispatch no instance holds — tiles' slack and freed blocks, which the cull rejects after
  /// its search (docs/subsystems/renderer.md, "Instances that come and go").
  table_slots: u32 = 0 @since(6)
  table_pairs: u32 = 0 @since(6)
  hole_pairs: u32 = 0 @since(6)
  /// The census, when the run took one: visible pairs by DAG level (0 is the source geometry)
  /// and by scene mesh, read back from this frame's visible list in a second, untimed pass.
  levels: u32[]
  meshes: u32[]
  /// With `--census-pixels`: pixels of the picture each scene mesh covers, from the id channel.
  /// A mesh that comes into view is the frame this goes above zero.
  pixels: u32[]
}

/// A distribution over a path's frames.
struct Percentiles @version(1) {
  median: f64 = 0
  p95: f64 = 0
  p99: f64 = 0
  max: f64 = 0
  mean: f64 = 0
}

struct PassPercentiles @version(4) {
  cull: Percentiles
  hw: Percentiles
  sw: Percentiles
  hiz: Percentiles
  resolve: Percentiles
  rt: Percentiles
  deform: Percentiles
  trace: Percentiles
  shadow: Percentiles @since(3)
  total: Percentiles
  /// Inside `rt`: the cluster build and the bottom-level build.
  clas: Percentiles @since(2)
  blas: Percentiles @since(2)
  /// A streamed world's table updates, over every frame (most are zero; FrameRecord.table_slots
  /// says which were not).
  tables: Percentiles @since(4)
}

/// One mesh as a run loaded it: what a number was measured on.
struct MeshIdentity @version(1) {
  name: string
  path: string
  /// The source hash the load computed, 16 hex digits; the terrain's is over its fields.
  hash: string
  /// "scene" (the committed file), "overlay" (the manifest's replacement), or "terrain".
  source: string
  clusters: u32 = 0
  triangles: u32 = 0
}

/// A marker frame's numbers, so a table can be read against the scene's README.
struct MarkerRecord @version(1) {
  frame: u32 = 0
  name: string
  total_ms: f64 = 0
  visible_pairs: u32 = 0
  /// Visible pairs by scene mesh, when the run took a census, and the pixels each covers when it
  /// took them too.
  meshes: u32[]
  pixels: u32[]
}

/// One frame where occlusion culling changed the picture, and how.
struct OcclusionFrame @version(1) {
  frame: u32 = 0
  /// Pixels whose (instance, cluster) differ, and colour bytes that differ.
  surface: u32 = 0
  colour: u32 = 0
  /// Of the differing pixels: where the frame without occlusion culling had a nearer surface
  /// (something visible was culled), where the depths tie exactly (two surfaces at one depth, and
  /// the visibility buffer's tie-break is the visible entry's index, which culling renumbers), and
  /// where the frame with it is nearer.
  lost_nearer: u32 = 0
  tied: u32 = 0
  gained_nearer: u32 = 0
  /// By scene mesh: what the frame without occlusion culling drew at the differing pixels.
  lost: u32[]
}

/// Whether occlusion culling changed the picture anywhere on the path
/// (`engine-view --verify-occlusion`): every frame drawn twice, with and without it, and the
/// (instance, cluster) under every pixel and every colour byte compared.
struct OcclusionCheck @version(1) {
  frames: u32 = 0
  width: u32 = 0
  height: u32 = 0
  /// Frames whose pictures differ at all; 0 is the invariant.
  frames_differing: u32 = 0
  surface_differences: u64 = 0
  colour_differences: u64 = 0
  /// Pixels whose triangle differs with the surface the same: a shared edge where depths tie.
  triangle_differences: u64 = 0
  /// The surface differences by depth (see `OcclusionFrame`). **`lost_nearer` and
  /// `gained_nearer` are the invariant**: a pixel where the frame without occlusion culling had a
  /// nearer surface is a visible cluster that was culled. `tied` is two surfaces at exactly one
  /// depth — coincident geometry, such as a leaf modelled as two back-to-back faces — where the
  /// visibility buffer keeps the larger visible-entry index, and the list's order is the GPU's
  /// append order, which culling changes and nothing makes repeatable.
  lost_nearer: u64 = 0
  tied: u64 = 0
  gained_nearer: u64 = 0
  /// Frames with at least one pixel lost or gained nearer: 0 is the invariant.
  frames_culled_visible: u32 = 0
  covered_min: u32 = 0
  covered_max: u32 = 0
  /// Every frame that differed, in path order.
  differing: OcclusionFrame[]
}

/// What the ray tracing chain held over a flythrough (`renderer::RtStats`): the capacity in
/// clusters at the end and at its largest, the budget as a capacity, what the chain would be sized
/// for if it were sized by the scene (`views * pairs`), its device bytes at the end and at their
/// largest, how often it was resized, and the frames that wanted more than it held. All zero
/// without the chain.
struct FlythroughRt @version(1) {
  capacity: u32 = 0
  peak_capacity: u32 = 0
  limit: u32 = 0
  union_clusters: u32 = 0
  bytes: u64 = 0
  peak_bytes: u64 = 0
  grows: u32 = 0
  shrinks: u32 = 0
  overflow_frames: u64 = 0
  dropped_instances: u64 = 0
  dropped_caster_instances: u64 = 0
  /// Per frame, over the path: what the chain built and what the frame wanted.
  built: Percentiles
  wanted: Percentiles
}

/// The materials' textures a scene holds on the device (`renderer::GpuScene`): the distinct
/// textures, built from the content build's `.tex` files or decoded from their images; how many
/// of the meshes' sampled images took a texture another mesh had already uploaded instead of their
/// own copy; the device bytes of what was uploaded, and of what sharing did not upload again
/// (docs/subsystems/renderer.md, "One upload per distinct image"). `sharing` is
/// `RenderSettings::share_textures`: false is every mesh its own copy, to measure against.
struct FlythroughTextures @version(1) {
  built: u32 = 0
  decoded: u32 = 0
  shared: u32 = 0
  bytes: u64 = 0
  bytes_saved: u64 = 0
  sharing: bool = true
}

/// How a windowed run presented (`engine-view --interactive --benchmark`, and a replay flown in
/// the window with `--windowed`): the swapchain it got, the frames it kept in flight, the pacer,
/// and where the frames' waits went. What a frame-time distribution has to be read against,
/// since the same GPU work paces differently under another present mode or queue depth
/// (docs/subsystems/apps.md, "Pacing").
struct FlythroughPresentation @version(1) {
  /// The present mode the swapchain was created with: "fifo", "fifo_relaxed", "mailbox",
  /// "immediate" or "fifo_latest_ready"; and the one `--present` asked for ("auto" when it
  /// asked for none, which is FIFO with vsync).
  present_mode: string
  requested_mode: string
  /// The swapchain's images as created (the driver may give more than was asked for), what
  /// `--swapchain-images` asked for, and `--frames-in-flight`.
  image_count: u32 = 0
  requested_images: u32 = 0
  frames_in_flight: u32 = 0
  /// The pacer the run had (`--pace`, resolved): "display" (each frame sampled when the one before
  /// it reached the display, `docs/subsystems/apps.md`, "Pacing") or "off" (the swapchain's own
  /// waits set the cadence), whatever was asked — "auto" resolves to one of the two, and
  /// "display" on a surface that cannot wait on a present is "off".
  pacing: string
  /// The display pacer's own count: refreshes that went by with no new frame (frames that missed
  /// their refresh, and stalls; `view::DisplayPacer::misses`), and its changes of depth.
  pace_misses: u64 = 0
  pace_switches: u32 = 0
  /// `--borderless`: the window had no decorations and sat at the primary display's corner.
  borderless: bool = false
  /// The display's refresh as the swapchain reports it (VK_EXT_present_timing), 0 where it
  /// cannot say; and the median of the presented frames' `shown_ms`.
  refresh_ms: f64 = 0
  shown_ms: Percentiles
  latency_ms: Percentiles
  /// Whether frames' display times were measured at all (VK_EXT_present_timing on this
  /// surface), and for how many frames they came back.
  present_timing: bool = false
  timed_frames: u32 = 0
  /// Swapchain recreations during the run (a resize, or a present or acquire that said the chain
  /// was out of date), and presents that came back VK_SUBOPTIMAL_KHR.
  recreated: u32 = 0
  suboptimal: u32 = 0
  /// Per frame: the waits `FrameRecord` carries, and its `submit_ms`.
  wait_ms: Percentiles
  acquire_ms: Percentiles
  present_ms: Percentiles
  pace_ms: Percentiles
  submit_ms: Percentiles
}

/// The last line of a flythrough benchmark's `.jsonl`, and engine-view's summary line. An
/// interactive session measured with `--benchmark` ends its `.jsonl` with one too.
struct FlythroughSummary @version(7) {
  /// "engine.flythrough.v1".
  format: string
  scene: string
  /// Hashes of the scene file's and the camera path file's bytes, and of both together with
  /// every mesh's, which is the one number that names what was measured.
  scene_hash: string
  path: string
  path_hash: string
  identity: string
  meshes: MeshIdentity[]
  width: u32 = 0
  height: u32 = 0
  views: string
  raster: string
  shadows: string
  occlusion: bool = false
  lod_px: f32 = 1
  stream: bool = false
  page_budget_bytes: u64 = 0
  instances: u32 = 0
  pairs: u32 = 0
  clusters: u32 = 0
  frames: u32 = 0
  repeats: u32 = 0
  warmup: u32 = 0
  /// Per pass, over the path's frames, of each frame's median across the repeats.
  gpu_ms: PassPercentiles
  visible_pairs: Percentiles
  /// The shadow chain's extra casters per frame (`FrameRecord.shadow_casters`).
  shadow_casters: Percentiles
  /// The cascaded shadow maps' pairs per frame (`FrameRecord.shadow_pairs`).
  shadow_pairs: Percentiles @since(3)
  /// True when every repeat drew the same visible pairs at every frame.
  deterministic: bool = false
  mismatched_frames: u32 = 0
  /// Frames where the census pass's visible pairs differ from the timed pass's first repeat.
  census_mismatched_frames: u32 = 0
  census: bool = false
  uploads: u64 = 0
  upload_bytes: u64 = 0
  evictions: u64 = 0
  markers: MarkerRecord[]
  occlusion_check: OcclusionCheck?
  /// Wall time of the timed passes, and per frame: barriers, gaps and the CPU included.
  seconds: f64 = 0
  wall_ms_per_frame: f64 = 0
  gpu_memory_used_mib: u64 = 0
  gpu_memory_budget_mib: u64 = 0
  /// The harness's samples around the run, as `foundation/bench` writes them.
  machine_state: json
  quiet: bool = false
  /// The ray tracing chain's memory and what it built (see `FlythroughRt`).
  rt: FlythroughRt @since(2)
  /// Per frame, over the path's frames, of each frame's median across the repeats: the CPU's
  /// own milliseconds and the wall milliseconds between frames (`FrameRecord.cpu_ms`,
  /// `FrameRecord.frame_ms`). An interactive session's `frame_ms.p99` is its pacing number.
  cpu_ms: Percentiles @since(4)
  frame_ms: Percentiles @since(4)
  /// The camera ticks the frames consumed, summed (`FrameRecord.ticks`); zero on a flythrough.
  ticks: u64 = 0 @since(4)
  /// An interactive session's own block (`engine-view --interactive` or `--replay-input`): its
  /// mode, its session header, and its trajectory — the hash over every tick's camera and the
  /// markers — which is what says two runs flew the same path. Null on a flythrough.
  interactive: json @since(4)
  /// A streamed world's run (`engine.world.TileWorldSummary`: the rings, the updates and events,
  /// the ring's microseconds, each consumer's cost, the ruins' assembly and the renderer taking
  /// them). Null for a scene read whole.
  world: json @since(5)
  /// The scene's textures on the device, and what one upload per distinct image saved.
  textures: FlythroughTextures @since(6)
  /// A windowed run's presentation: null offscreen (see `FlythroughPresentation`).
  presentation: FlythroughPresentation? @since(7)
}
