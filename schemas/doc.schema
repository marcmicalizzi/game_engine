// The authoring document model (docs/plan/03-data-model.md §3.2–3.3, ADR-0002): layers of
// sparse object records, the commands that edit them, and the journal that records edits.
namespace engine.doc

/// Role of a layer in the document's stack.
enum LayerRole : u8 {
  /// Generated or authored world content.
  Base = 0
  /// A feature's placements (a quest, a settlement) layered over the base.
  Feature = 1
  /// An agent's in-progress work, promoted into a feature layer on acceptance.
  Proposal = 2
  /// Ephemeral edits not yet committed.
  Session = 3
}

/// One layer's opinion about one object. A record with a non-empty type defines the object;
/// a record without a type only overrides properties, the parent, or deletion.
struct ObjectRecord @version(1) {
  id: id128
  /// Qualified schema type name of the object; empty in override-only records.
  type: string
  /// Present when this layer assigns the parent; the null id means the root.
  parent: id128?
  /// Tombstone: hides the object defined in this or a weaker layer.
  deleted: bool = false
  /// Sparse property values keyed by field name of the object's type.
  properties: map<string, json>
}

/// A record type a layer file's records are written in, and the version of it they were written at
/// (docs/subsystems/doc.md, "A layer says which versions it holds").
struct RecordTypeVersion @version(1) {
  /// The type's qualified schema name.
  name: string
  version: u32 = 0
}

/// On-disk form of one layer: canonical JSON, records in id order.
///
/// Version 2 (2026-10-06) added `types`: a document records no version per record, so a build that
/// read a newer record type's fields read them as its own — a `worldpos` as float32, silently. A
/// reader refuses a file naming a type newer than its own, by name, and reads a file without the
/// table, or naming an older version, as before. A build that predates the table refuses the field
/// itself ("unknown field"), which is a refusal and not a misreading.
struct LayerFile @version(2) @kind(document) {
  name: string
  role: LayerRole = Base
  /// Every record type the file's records are of, defined here or overridden here (the type the
  /// document composes for them), that the writing build has in its schema registry: in name
  /// order, once each, at the version that build has. Empty for a file written before version 2.
  types: RecordTypeVersion[] @since(2)
  objects: ObjectRecord[]
}

enum CommandKind : u8 {
  /// Defines a new object in the edit layer (type, parent, optional initial properties in `value`).
  CreateObject = 0
  /// Removes the defining record when the edit layer defines the object; otherwise tombstones it.
  DeleteObject = 1
  /// Sets one property in the edit layer.
  SetProperty = 2
  /// Removes one property override from the edit layer.
  ClearProperty = 3
  /// Sets the parent in the edit layer (null id = root).
  SetParent = 4
  /// Removes the edit layer's record for the object entirely.
  RemoveRecord = 5
  /// Replaces the edit layer's record (or removes it when `record` is absent). The inverse of every command.
  RestoreRecord = 6
}

/// A single edit to the document's edit layer. Fields beyond `kind` and `id` are used as the
/// kind requires.
struct Command @version(1) {
  kind: CommandKind = SetProperty
  id: id128
  type: string
  parent: id128?
  name: string
  value: json
  record: ObjectRecord?
}

/// Who made a change, and why.
struct Attribution @version(1) {
  actor: string
  role: string
  task: string
  rationale: string
  timestamp_unix_ms: i64 = 0
}

/// A committed transaction: the forward commands and the inverse that undoes them.
struct Patch @version(2) @kind(journal) @additive(2) {
  attribution: Attribution
  layer: string
  forward: Command[]
  inverse: Command[]
  /// The client transaction (`doc.begin`, engine.protocol.TransactionInfo.id) this patch is the
  /// commit of; 0 for every other write. It is how a `doc.commit` retried after a failure that
  /// came after the journal (a side file's write, a host killed) finds the patch already landed
  /// and applies nothing twice (docs/subsystems/protocol.md, "Transactions a client opens"). Set
  /// by the session, never from a client's attribution.
  transaction: u64 = 0 @since(2)
}

/// How a layer's records are spread over tile files (docs/plan/03-data-model.md §3.7). A layer
/// with a partition is stored as `layers/<layer>/tiles/<x>_<y>.json` plus `index.json` and
/// `untiled.json`; a layer without one is a single `layers/<layer>.json`.
struct LayerPartition @version(1) {
  /// Name of the property holding the record's world position: a JSON array of two or three
  /// numbers, or an object with numeric `x`, `y` (and `z`), or a transform object with a
  /// `position` or `translation` member. Empty means the property is the record type's first
  /// `position` or `transform` field, as the schema registry reports it.
  property: string
  /// Tile edge length in world units on the horizontal plane. Greater than zero.
  tile_size: f64 = 0
}

/// One tile file of a partitioned layer: `layers/<layer>/tiles/<x>_<y>.json`.
struct TileRef @version(1) {
  /// Tile coordinates on the horizontal plane: floor(position / tile_size).
  x: i32 = 0
  y: i32 = 0
  /// File name under the layer's `tiles/` directory.
  file: string
  /// The records the file holds, in id order: the record-to-tile map, read the other way.
  objects: id128[]
}

/// `layers/<layer>/index.json`: a partitioned layer's tile grid and which tile holds each
/// record. The tile files hold the records themselves, each one a `LayerFile` restricted to
/// them.
struct LayerIndex @version(1) @kind(document) {
  name: string
  role: LayerRole = Base
  partition: LayerPartition
  /// Occupied tiles, in (x, y) order. A tile with no records has no file and no entry.
  tiles: TileRef[]
  /// Records with no usable position, held by `untiled.json`, in id order.
  untiled: id128[]
  /// Inclusive tile coordinates covering every occupied tile; all zero when there are none.
  min_x: i32 = 0
  min_y: i32 = 0
  max_x: i32 = 0
  max_y: i32 = 0
}

/// One layer of a stored document: its file under the document's `layers/` directory.
struct LayerRef @version(2) {
  name: string
  role: LayerRole = Base
  /// File name under `layers/`: `<layer>.json` for a single-file layer, `<layer>/index.json`
  /// for a partitioned one.
  file: string
  /// Present when the layer is stored as tiles; absent for a single file.
  partition: LayerPartition? @since(2)
}

/// **A reference to a blob**: bytes a document holds beside its layers (a heightfield's grid, a
/// painted mask, a generated image), named by their SHA-256 and kept once in the document's
/// `blobs/` directory (docs/subsystems/doc.md, "Blobs"; plan 03 §3.2). A property holds the
/// reference, never the bytes, so the JSON stays small and diffable and two equal blobs compare by
/// name. Any JSON object whose `blob` member is 64 lowercase hexadecimal characters is a reference
/// wherever it stands in a property's value — that is how the store finds what a document still
/// names without knowing every type — so a type that holds one declares a field of this type.
struct BlobRef @version(1) {
  /// The SHA-256 of the bytes, 64 lowercase hexadecimal characters: the blob's name, and the whole
  /// of its identity.
  blob: string
  /// Length in bytes, checked with the hash when the blob is read.
  size: u64 = 0
  /// What the bytes are, for a reader ("engine.terrain.grid/1", "image/png"). Not part of the name:
  /// the same bytes under two media are one blob.
  media: string
}

/// One checkpoint of a document: a commit of its directory's own git repository (plan 06 §6.4,
/// docs/subsystems/doc.md, "Checkpoints"), holding the manifest, the layer files and the blobs as
/// they were saved, with the journal patches since the previous checkpoint as the commit's body.
struct CheckpointInfo @version(1) {
  /// The commit's object name, 40 hexadecimal characters: what `rollback_to` takes.
  id: string
  /// The previous checkpoint's id; empty for the first.
  parent: string
  /// The label the checkpoint was taken with: the commit's subject.
  label: string
  /// Who took it, and why; `timestamp_unix_ms` is when.
  attribution: Attribution
  /// The journal's length and the undo position when it was taken: the layer files hold the
  /// patches before `undo_position`.
  journal_length: u32 = 0
  undo_position: u32 = 0
  /// The commit body carries the journal's patches from this index to `undo_position`: those since
  /// the previous checkpoint, when the journal still holds them.
  journal_from: u32 = 0
}

/// `manifest.json` of a document directory: the layer stack (weakest first), the edit layer,
/// and how many journal patches are applied (the rest form the redo tail).
struct DocumentManifest @version(1) @kind(document) {
  name: string
  layers: LayerRef[]
  edit_layer: string
  undo_position: u32 = 0
}
