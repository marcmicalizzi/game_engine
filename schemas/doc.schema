// The authoring document model (docs/plan/03-data-model.md §3.2–3.3, ADR-0002): layers of
// sparse object records, the commands that edit them, and the journal that records edits.
namespace engine.doc

/// Role of a layer in the document's stack.
enum LayerRole : u8 {
  /// Generated or authored world content.
  Base = 0
  /// A feature's placements (a quest, a settlement) layered over the base.
  Feature = 1
  /// An agent's in-progress work, promoted into a feature layer on acceptance.
  Proposal = 2
  /// Ephemeral edits not yet committed.
  Session = 3
}

/// One layer's opinion about one object. A record with a non-empty type defines the object;
/// a record without a type only overrides properties, the parent, or deletion.
struct ObjectRecord @version(1) {
  id: id128
  /// Qualified schema type name of the object; empty in override-only records.
  type: string
  /// Present when this layer assigns the parent; the null id means the root.
  parent: id128?
  /// Tombstone: hides the object defined in this or a weaker layer.
  deleted: bool = false
  /// Sparse property values keyed by field name of the object's type.
  properties: map<string, json>
}

/// On-disk form of one layer: canonical JSON, records in id order.
struct LayerFile @version(1) @kind(document) {
  name: string
  role: LayerRole = Base
  objects: ObjectRecord[]
}

enum CommandKind : u8 {
  /// Defines a new object in the edit layer (type, parent, optional initial properties in `value`).
  CreateObject = 0
  /// Removes the defining record when the edit layer defines the object; otherwise tombstones it.
  DeleteObject = 1
  /// Sets one property in the edit layer.
  SetProperty = 2
  /// Removes one property override from the edit layer.
  ClearProperty = 3
  /// Sets the parent in the edit layer (null id = root).
  SetParent = 4
  /// Removes the edit layer's record for the object entirely.
  RemoveRecord = 5
  /// Replaces the edit layer's record (or removes it when `record` is absent). The inverse of every command.
  RestoreRecord = 6
}

/// A single edit to the document's edit layer. Fields beyond `kind` and `id` are used as the
/// kind requires.
struct Command @version(1) {
  kind: CommandKind = SetProperty
  id: id128
  type: string
  parent: id128?
  name: string
  value: json
  record: ObjectRecord?
}

/// Who made a change, and why.
struct Attribution @version(1) {
  actor: string
  role: string
  task: string
  rationale: string
  timestamp_unix_ms: i64 = 0
}

/// A committed transaction: the forward commands and the inverse that undoes them.
struct Patch @version(1) @kind(journal) {
  attribution: Attribution
  layer: string
  forward: Command[]
  inverse: Command[]
}

/// How a layer's records are spread over tile files (docs/plan/03-data-model.md §3.7). A layer
/// with a partition is stored as `layers/<layer>/tiles/<x>_<y>.json` plus `index.json` and
/// `untiled.json`; a layer without one is a single `layers/<layer>.json`.
struct LayerPartition @version(1) {
  /// Name of the property holding the record's world position: a JSON array of two or three
  /// numbers, or an object with numeric `x`, `y` (and `z`), or a transform object with a
  /// `position` or `translation` member. Empty means the property is the record type's first
  /// `position` or `transform` field, as the schema registry reports it.
  property: string
  /// Tile edge length in world units on the horizontal plane. Greater than zero.
  tile_size: f64 = 0
}

/// One tile file of a partitioned layer: `layers/<layer>/tiles/<x>_<y>.json`.
struct TileRef @version(1) {
  /// Tile coordinates on the horizontal plane: floor(position / tile_size).
  x: i32 = 0
  y: i32 = 0
  /// File name under the layer's `tiles/` directory.
  file: string
  /// The records the file holds, in id order: the record-to-tile map, read the other way.
  objects: id128[]
}

/// `layers/<layer>/index.json`: a partitioned layer's tile grid and which tile holds each
/// record. The tile files hold the records themselves, each one a `LayerFile` restricted to
/// them.
struct LayerIndex @version(1) @kind(document) {
  name: string
  role: LayerRole = Base
  partition: LayerPartition
  /// Occupied tiles, in (x, y) order. A tile with no records has no file and no entry.
  tiles: TileRef[]
  /// Records with no usable position, held by `untiled.json`, in id order.
  untiled: id128[]
  /// Inclusive tile coordinates covering every occupied tile; all zero when there are none.
  min_x: i32 = 0
  min_y: i32 = 0
  max_x: i32 = 0
  max_y: i32 = 0
}

/// One layer of a stored document: its file under the document's `layers/` directory.
struct LayerRef @version(2) {
  name: string
  role: LayerRole = Base
  /// File name under `layers/`: `<layer>.json` for a single-file layer, `<layer>/index.json`
  /// for a partitioned one.
  file: string
  /// Present when the layer is stored as tiles; absent for a single file.
  partition: LayerPartition? @since(2)
}

/// `manifest.json` of a document directory: the layer stack (weakest first), the edit layer,
/// and how many journal patches are applied (the rest form the redo tail).
struct DocumentManifest @version(1) @kind(document) {
  name: string
  layers: LayerRef[]
  edit_layer: string
  undo_position: u32 = 0
}
