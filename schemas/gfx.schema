// Graphics device description (docs/plan/04-renderer.md §4.1, ADR-0006): what the renderer
// learns about each Vulkan physical device before choosing one and a capability tier.
namespace engine.gfx

enum AdapterType : u8 {
  Other = 0
  IntegratedGpu = 1
  DiscreteGpu = 2
  VirtualGpu = 3
  Cpu = 4
}

struct QueueFamilyInfo @version(1) {
  index: u32 = 0
  count: u32 = 0
  graphics: bool = false
  compute: bool = false
  transfer: bool = false
}

/// How strongly the renderer needs one row of the requirements table
/// (docs/subsystems/gfx.md, "What a device has to have").
enum RequirementLevel : u8 {
  /// Device creation fails without it.
  Required = 0
  /// Enables the capability named in `unlocks`; the renderer runs without it.
  Optional = 1
  /// Reported because a reader looks for it; nothing enforces it.
  Note = 2
}

/// One row of the renderer's requirements table, checked against one device. The table lives in
/// `domain/gfx/requirements.h`; device creation and this report walk the same rows, so the check
/// and the report cannot drift.
struct DeviceRequirement @version(1) {
  /// The Vulkan spelling: "apiVersion", "dynamicRendering", "VK_EXT_mesh_shader",
  /// "maxPushConstantsSize".
  name: string
  /// "api", "feature", "extension", "limit", or "queue".
  kind: string
  level: RequirementLevel = Required
  /// What the engine needs, as text: "1.3", "true", ">= 128".
  needed: string
  /// What this device reports, as text.
  found: string
  pass: bool = false
  /// The capability an Optional row unlocks ("mesh-shaders", "ray-tracing",
  /// "cluster-acceleration-structures", "visibility-buffer", "presentation", ...). Empty on a
  /// Required or Note row.
  unlocks: string
  /// What in the engine needs it, in one sentence.
  why: string
}

/// A bindless array whose requested size did not fit the device (ADR-0023). The engine clamps
/// rather than fails as long as `granted` is at or above `floor`.
struct DeviceClamp @version(1) {
  name: string
  requested: u32 = 0
  granted: u32 = 0
  /// Below this the renderer refuses instead of clamping.
  floor: u32 = 0
  why: string
}

/// What the renderer would do with a device, in plain words.
struct DeviceVerdict @version(1) {
  /// The tier the renderer would run at: "raster", "rt", "rt-cluster", or "none" when a
  /// Required row fails and `Device::create()` refuses the device.
  tier: string
  /// True when `Device::create()` would succeed here.
  usable: bool = false
  /// Why not, one plain sentence each. Empty when `usable`.
  blocking: string[]
  /// What will not run although the device is usable, one plain sentence each.
  degraded: string[]
  /// Bindless arrays the device's limits made smaller than the default configuration asked for.
  clamps: DeviceClamp[]
}

/// One physical device as reported by the Vulkan loader.
struct AdapterInfo @version(2) {
  name: string
  /// "NVIDIA", "AMD", "Intel", or the hexadecimal vendor id.
  vendor: string
  vendor_id: u32 = 0
  device_id: u32 = 0
  type: AdapterType = Other
  /// Highest Vulkan API version the device supports, "major.minor.patch".
  api_version: string
  driver_name: string
  driver_info: string
  /// Sum of device-local memory heaps.
  device_local_bytes: u64 = 0
  /// Device extensions the renderer cares about: present or absent.
  extensions: map<string, bool>
  queue_families: QueueFamilyInfo[]
  /// Capability tier the *hardware* advertises: "raster", "rt", or "rt-cluster". It says nothing
  /// about whether the renderer would accept the device; `verdict.tier` says that, and is "none"
  /// when a required feature or limit is missing.
  tier: string
  /// Every row of the renderer's requirements table, checked against this device.
  requirements: DeviceRequirement[] @since(2)
  /// Whether the renderer would run here, and at what tier.
  verdict: DeviceVerdict @since(2)
}

/// One format and colour space a window's surface offers a swapchain
/// (vkGetPhysicalDeviceSurfaceFormatsKHR on an instance with VK_EXT_swapchain_colorspace; E39's
/// first measurement, docs/experiments/hdr-output-proposal.md).
struct SurfaceOffer @version(1) {
  /// The format as gfx spells it ("A2B10G10R10Unorm", "R16G16B16A16Sfloat"); "other" for one the
  /// engine has no name for, whose VkFormat is `format_value`.
  format: string
  format_value: u32 = 0
  /// "srgb_nonlinear", "hdr10_st2084", "extended_srgb_linear", ...; "other" with the
  /// VkColorSpaceKHR in `color_space_value`.
  color_space: string
  color_space_value: u32 = 0
}

/// What one Vulkan device offers a hidden window placed on one output.
struct SurfaceOffers @version(1) {
  /// The device's name, as `gpu.adapters` reports it.
  adapter: string
  /// The device's graphics queue can present to the window; nothing else is filled when false.
  supported: bool = false
  formats: SurfaceOffer[]
  /// "fifo", "mailbox", "immediate", "fifo_relaxed", or the number.
  present_modes: string[]
  /// The device offers VK_EXT_hdr_metadata (the HDR10 static metadata a swapchain can carry).
  hdr_metadata: bool = false
}

/// One display output as Windows reports it — DXGI's `IDXGIOutput6::GetDesc1` and the display
/// configuration's SDR white level — with what a window on it is offered. Read with no window
/// shown and no device opened (docs/subsystems/gfx.md, "The surface's offers").
struct DisplayOutput @version(1) {
  /// The GDI device name ("DISPLAY1" after its prefix): one per output, and one for a whole NVIDIA
  /// Surround group, which Windows sees as a single display.
  name: string
  /// The DXGI adapter it hangs off.
  adapter: string
  /// Its rectangle on the desktop, pixels: left, top, right, bottom.
  desktop: i32[]
  attached: bool = false
  /// What the output is driven at, bits a colour channel (DXGI's `BitsPerColor`).
  bits_per_color: u32 = 0
  /// DXGI's colour space: "rgb_full_g22_none_p709" with Windows' HDR off,
  /// "rgb_full_g2084_none_p2020" with it on; another one's number.
  color_space: string
  /// The output is in HDR10's colour space: Windows' "Use HDR" is on for it.
  hdr: bool = false
  /// The luminances DXGI reports for the panel, nits: the darkest, the brightest a small area can
  /// reach, and the brightest a full white frame holds.
  min_luminance: f32 = 0
  max_luminance: f32 = 0
  max_full_frame_luminance: f32 = 0
  /// Windows' SDR white level for the output, nits ("SDR content brightness"): where an SDR
  /// picture's white lands with HDR on, the natural paper white. 0 when Windows does not say.
  sdr_white_nits: f32 = 0
  /// The panel's primaries and white point as DXGI reports them, CIE 1931 x, y.
  red: f32[]
  green: f32[]
  blue: f32[]
  white: f32[]
  /// What each Vulkan device offers a window on this output.
  surfaces: SurfaceOffers[]
}
