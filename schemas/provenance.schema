// Asset provenance and licensing metadata (docs/plan/07-content-pipeline.md §7.5, ADR-0014,
// ADR-0015). Every generated or imported asset carries one of these; the content build refuses
// assets whose license is not in the project allowlist.
namespace engine.content

/// Coarse license class used by the build's allowlist check.
enum LicenseClass : u8 {
  /// MIT, BSD, zlib, Apache-2.0, BSL-1.0, public domain, CC0.
  Permissive = 0
  /// LGPL and similar: allowed only as a dynamically linked, replaceable component.
  WeakCopyleft = 1
  /// GPL, AGPL, SSPL: never allowed in the engine or its content.
  StrongCopyleft = 2
  /// Vendor or model licenses reviewed individually.
  Proprietary = 3
  Unknown = 255
}

/// Who or what produced an asset, from which inputs, and under which license.
struct AssetProvenance @version(1) @kind(record) {
  /// Tool, pipeline step, or model family that produced the asset.
  generator: string
  /// Model identifier when the generator is a model; absent for hand-authored or procedural.
  model_id: string?
  model_version: string?
  /// Hash of the prompt or parameter set that drove generation; 0 when not applicable.
  prompt_hash: u64 = 0
  seed: u64 = 0
  /// Content hashes (as ids) of the inputs the asset was derived from.
  inputs: id128[]
  /// The human or agent that ran the step.
  operator_id: id128
  created_at_unix_ms: i64 = 0
  /// SPDX identifier or a project-defined id from the license allowlist.
  license: string
  license_class: LicenseClass = Unknown
  license_terms_url: string?
  commercial_ok: bool = false
  attribution_required: bool = true
  /// Assets this one was derived from, by id.
  derived_from: id128[]
}

// Content classes and view policies (ADR-0033, ADR-0074; docs/content-classes.md). These are
// the shapes the files are written in; `foundation/content_class` reads them into the compact
// values a decision is made on, and refuses a file that is wrong, whole, with the reason.

/// One material's own classes, for an asset whose classified part is one material.
struct MaterialContentClasses {
  /// Category name to level name.
  levels: map<string, string>
}

/// What an asset declares, in its provenance sidecar's `content_classes`: category name to
/// level name. A category it does not name is `none`; absent altogether is `none` everywhere.
struct ContentClasses @version(1) {
  /// Category name to level name, for the whole asset.
  levels: map<string, string>
  /// A material's name to its own classes.
  materials: map<string, MaterialContentClasses>
}

/// A category a game adds: its name and its levels, lowest first, the first always `none`.
struct ContentCategory {
  name: string
  levels: string[]
}

/// A game's categories, given to its content build beside the engine's three.
struct ContentCategoriesFile @version(1) {
  categories: ContentCategory[]
}

/// One category's cap in a view policy, and what stands in for content above it.
struct ViewPolicyCap {
  /// A category the engine or the game's categories file defines.
  category: string
  /// The highest level of that category the output may contain.
  cap: string
  /// `omit` or `proxy`; `cover` and `obscure at capture` are refused until they are built.
  substitution: string
}

/// A named view policy. A category it does not name is capped at `none` with `omit`.
struct ViewPolicy {
  name: string
  caps: ViewPolicyCap[]
}

/// The operator's view policies, named on a host's command line (not read by any host yet).
/// `agent-default` is compiled in and may not be redefined here.
struct ViewPoliciesFile @version(1) {
  policies: ViewPolicy[]
}
