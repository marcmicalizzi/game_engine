// The state of @@NAME@@: everything the game remembers between ticks, as one struct of
// fixed-layout values. The engine's host allocates one object of this type when the module loads,
// carries it across every rebuild through this descriptor (a field added starts at its default, a
// field removed is dropped), and `--game-state <file>` saves and restores it. Nothing else the
// module keeps survives a rebuild, so anything that matters belongs here.
//
// Allowed fields: numbers (f32 f64 i32 u32 i64 u64), bool, the fixed vector types (vec3, dvec3,
// ...) and nested structs of the same; never a string, an array or a pointer. The engine's
// docs/subsystems/hotload.md, "What a module's state may hold", has the rule and why.
namespace engine.@@NAME@@

/// One run of @@NAME@@, from the first tick to the day it ends.
struct Run @version(1) {
  /// Game seconds the run has lasted, a tick's dt at a time.
  seconds: f64 = 0
  /// The world's time on the run's first tick; the day counter is measured from it. Negative
  /// means the run has not started (the default of a fresh state).
  start_world_s: f64 = -1
  /// Times the player pressed `interact` (E on the keyboard).
  interactions: u32 = 0
}
