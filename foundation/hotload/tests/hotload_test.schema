// Host object types the hotload tests and bench bind for modules to read through views. The same
// shapes as foundation/scripting/tests/scripting_test.schema, so E7's two arms read the same
// objects: characters, quests with a state machine, and a struct of ten scalars.
namespace engine.hotload_test

/// Where a quest is in its state machine.
enum QuestState : u8 {
  NotStarted = 0
  Active = 1
  Completed = 2
  Failed = 3
}

enum Faction : u8 {
  Neutral = 0
  Ironbound = 1
  Drifters = 2
}

struct Attributes @version(1) {
  strength: i32 = 10
  agility: f32 = 1.5
}

/// A person in the world.
struct Character @version(1) @kind(record) {
  name: string
  /// Hit points; 0 is dead.
  health: f32 = 100
  alive: bool = true
  faction: Faction = Neutral
  position: vec3
  attributes: Attributes
  /// Ids of the items carried.
  inventory: id128[]
  tags: string[]
  reputation: map<string, f32>
  home: id128?
  level: u16 = 1
  xp: u64 = 0
}

/// One quest: a state machine whose conditions modules evaluate.
struct Quest @version(1) @kind(record) {
  title: string
  state: QuestState = NotStarted
  stage: u32 = 0
  giver: id128
  required_item: id128?
  required_level: u16 = 1
  reward_xp: u32 = 100
}

/// Ten scalar properties, for the per-property read bench.
struct Ten @version(1) {
  a: f32 = 1
  b: f32 = 2
  c: f32 = 3
  d: i32 = 4
  e: u32 = 5
  f: bool = true
  g: f64 = 7
  h: f32 = 8
  i: i16 = 9
  j: u8 = 10
}
