// The state of walk_poc, the fixture game module that proves engine-view's game runner
// (game/walk_poc/README.md; docs/subsystems/apps.md "--game: running a game module"). One struct of
// fixed-layout values, so the host carries it across a rebuild and `--game-state` saves it.
namespace engine.walk_poc

/// What the fixture remembers between ticks and runs.
struct Survivor @version(5) {
  /// Thirst, 100 full and 0 the end of the run.
  thirst: f64 = 100
  /// Game seconds survived, a tick's dt at a time, and metres walked.
  seconds: f64 = 0
  walked_m: f64 = 0
  /// Whole days survived: midnights the world's clock has passed since the run began.
  days: u32 = 0
  /// The world's time when the run began (set on its first tick), for the day counter.
  start_world_s: f64 = 0
  started: bool = false
  /// The water the run drinks at when no ruin is near: fixed on the first tick, 25 m ahead of
  /// where the walker stood.
  spring: dvec3
  /// Times `interact` was pressed, and ticks spent drinking.
  interactions: u32 = 0
  drinking_ticks: u64 = 0
  /// Whether the run has ended (end_run said once).
  over: bool = false
  /// The water can (a prop, when the scene declares one): its id while it stands at the spring,
  /// 0 once it was picked up or never placed; and whether it has been.
  can: u32 = 0 @since(2)
  can_placed: bool = false @since(2)
  can_taken: bool = false @since(2)
  /// Markers placed with `use`.
  markers: u32 = 0 @since(2)
  /// The actor build's (WALK_POC_TEST 5, `walk_poc_actor`; apps.md "Actors"): the centre of the
  /// circle the actor `bar` walks, fixed where it stood on the first tick; the ticks it walked;
  /// and the pose hash `actor_state` gave on the last one, so the state shows what the module saw.
  actor_centre: dvec3 @since(3)
  actor_started: bool = false @since(3)
  actor_ticks: u64 = 0 @since(3)
  actor_pose: u64 = 0 @since(3)
  /// The loading build's (WALK_POC_TEST 6, `walk_poc_loading`; ABI 7, apps.md "The loading
  /// presentation"): the calls `game_loading` had, the fraction the last one carried, and how many
  /// times a call's fraction fell below the one before it (never, if the host keeps its promise).
  loading_calls: u32 = 0 @since(4)
  loading_fraction: f64 = 0 @since(4)
  loading_falls: u32 = 0 @since(4)
  /// The aligned build's (WALK_POC_TEST 7, `walk_poc_aligned`; ABI 8, apps.md "Actors"): the
  /// answer of each call it made (a `Result`, four bits a call, call 0 lowest), the tilt `actor_state`
  /// reported after each of four placements, whether the third (60 degrees against the default 30) was held,
  /// and what `ground_sample` said against `ground_height` at the same point.
  align_codes: u64 = 0 @since(5)
  align_tilt: f64[4] @since(5)
  align_clamped: u32 = 0 @since(5)
  align_sample_height_delta: f64 = 0 @since(5)
  align_sample_normal: dvec3 @since(5)
  /// The ABI 7 build's (WALK_POC_TEST 8, `walk_poc_abi7`): bytes past the 136 an ABI 5 to 7 module
  /// owns that `actor_state` wrote anyway (never, if the host copies only as far as `size`).
  abi7_overrun: u32 = 0 @since(5)
}
