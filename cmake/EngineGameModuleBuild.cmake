# Builds a hot-reloadable game module from a directory of sources outside the build tree, with
# the compiler and flags the build's own game modules use (cmake/EngineGameModule.cmake).
#
#   cmake -DCONFIG=<build>/game_modules/build_config.cmake -DSOURCE_DIR=<dir> -DOUTPUT=<file>
#         -P cmake/EngineGameModuleBuild.cmake
#
# Every `*.cpp` in SOURCE_DIR is one unity translation unit; every `*.schema` is run through
# schemac and its generated tables join that unit (with ENGINE_SCHEMA_NO_REGISTRAR, from the
# config's definitions). Intermediate files go to `<OUTPUT without extension>.build/` beside the
# output, so a caller that names an output in its own scratch directory owns everything this
# writes. The compiler's diagnostics are printed; a failed compile or link exits non-zero.
#
# It exists for the tests: a test of reloading has to compile a second build of a module, and a
# test owns nothing outside its scratch directory (AGENTS.md, "Test hygiene"). It is also the build
# command of an exported game SDK (tools/export-game-sdk.ps1, docs/game-authoring.md), whose
# `cmake/build_config.cmake` names the SDK's own headers, schemac and schema root relative to
# itself and the exporting machine's compiler and MSVC environment. On a machine without that
# compiler the SDK's build-module.ps1 finds one through vswhere, imports its developer environment
# and passes it as -DCOMPILER=<cl.exe>; the recorded environment is then left aside in favour of
# the caller's, which is the one that matches the compiler.

cmake_minimum_required(VERSION 3.28)

if(NOT CONFIG OR NOT SOURCE_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "EngineGameModuleBuild: CONFIG, SOURCE_DIR and OUTPUT are required")
endif()
include("${CONFIG}")

if(COMPILER)
  set(GM_CXX "${COMPILER}")
  set(GM_ENV_INCLUDE "")
  set(GM_ENV_LIB "")
  set(GM_ENV_PATH "")
endif()
if(NOT EXISTS "${GM_CXX}")
  message(FATAL_ERROR "EngineGameModuleBuild: the compiler the configuration records, ${GM_CXX}, "
    "is not on this machine. A game SDK's tools/build-module.ps1 finds Visual Studio through vswhere "
    "and passes its compiler as -DCOMPILER=<cl.exe>; from a build tree, configure it again.")
endif()

file(GLOB _sources "${SOURCE_DIR}/*.cpp")
file(GLOB _schemas "${SOURCE_DIR}/*.schema")
list(SORT _sources)
list(SORT _schemas)
if(NOT _sources)
  message(FATAL_ERROR "EngineGameModuleBuild: no .cpp in ${SOURCE_DIR}")
endif()

get_filename_component(_out_dir "${OUTPUT}" DIRECTORY)
get_filename_component(_out_stem "${OUTPUT}" NAME_WE)
set(_work "${_out_dir}/${_out_stem}.build")
file(MAKE_DIRECTORY "${_work}")

set(_generated "")
if(_schemas)
  execute_process(
    COMMAND "${GM_SCHEMAC}" --out "${_work}/gen" --schema-root "${GM_SCHEMA_ROOT}" ${_schemas}
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _out)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "schemac failed (${_rc}):\n${_out}")
  endif()
  foreach(_schema IN LISTS _schemas)
    get_filename_component(_stem "${_schema}" NAME_WE)
    list(APPEND _generated "${_work}/gen/src/${_stem}.cpp")
  endforeach()
endif()

set(_unity "${_work}/unity.cpp")
set(_text "// Generated by cmake/EngineGameModuleBuild.cmake: one translation unit per module.\n")
foreach(_file IN LISTS _sources _generated)
  string(APPEND _text "#include \"${_file}\"\n")
endforeach()
file(WRITE "${_unity}" "${_text}")

set(_cmd "${GM_CXX}")
if(GM_MSVC)
  if(GM_ENV_INCLUDE)
    set(ENV{INCLUDE} "${GM_ENV_INCLUDE}")
  endif()
  if(GM_ENV_LIB)
    set(ENV{LIB} "${GM_ENV_LIB}")
  endif()
  if(GM_ENV_PATH)
    set(ENV{PATH} "${GM_ENV_PATH}")
  endif()
  list(APPEND _cmd /nologo ${GM_FLAGS})
  foreach(_d IN LISTS GM_DEFINES)
    list(APPEND _cmd "/D${_d}")
  endforeach()
  foreach(_i IN LISTS GM_INCLUDES)
    list(APPEND _cmd "/I${_i}")
  endforeach()
  list(APPEND _cmd "/I${_work}/gen/include" "/Fo${_work}/" /LD "${_unity}" "/Fe${OUTPUT}"
    /link /INCREMENTAL:NO)
else()
  list(APPEND _cmd ${GM_FLAGS})
  foreach(_d IN LISTS GM_DEFINES)
    list(APPEND _cmd "-D${_d}")
  endforeach()
  foreach(_i IN LISTS GM_INCLUDES)
    list(APPEND _cmd "-I${_i}")
  endforeach()
  list(APPEND _cmd "-I${_work}/gen/include" "${_unity}" -o "${OUTPUT}" ${GM_LINK_FLAGS})
endif()

execute_process(COMMAND ${_cmd} WORKING_DIRECTORY "${_work}"
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _out)
if(_out)
  message("${_out}")
endif()
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "EngineGameModuleBuild: the compiler failed (${_rc})")
endif()
