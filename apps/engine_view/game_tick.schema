// What a game module run by `engine-view --game` reads every tick (docs/subsystems/apps.md, "The
// game contract"; roadmap P41). The host binds one `GameTick` and hands its view to the module's
// `game_tick` export; the module resolves the fields it reads by these names in `on_load` and reads
// them through `HostApi::read` (foundation/hotload/module_abi.h), so it never depends on this
// struct's layout. A field may be added here; renaming or removing one breaks every module that
// resolves it, which a module hears about when it loads, naming the path.
namespace engine.game

/// One tick of the walking session, as a game sees it: no engine types, only values.
struct GameTick @version(3) {
  /// The session's tick (the first is 1) and its length in seconds (1 / the tick rate).
  tick: u64 = 0
  dt: f64 = 0
  /// The camera's eye, world metres (f64: a walk 10,000 km out reads as one by the origin).
  eye: dvec3
  /// The walker's feet, world metres; the eye when the session is flying.
  feet: dvec3
  /// The look: heading (yaw) about +y counter-clockwise from above, 0 looking along -z, and
  /// pitch, up positive; radians.
  heading: f32 = 0
  pitch: f32 = 0
  /// Whether the camera is on the walker, and whether the walker's feet stand on something.
  walking: bool = false
  on_ground: bool = false
  /// Whether the walker is sprinting (the `fast` action held while walking).
  sprinting: bool = false
  /// Metres the walker moved over the ground this tick (0 while flying).
  moved_m: f64 = 0
  /// The clocks (docs/subsystems/renderer.md, "One world clock, and the day's length"):
  /// `sun_time_s` is the sky's offset from the scene's epoch as the session runs it (the
  /// --time-of-day offset plus the day's game seconds at the session's day length);
  /// `world_time_s` the world clock, real seconds scaled by the world rate — what a game animates
  /// by (until 2026-10-20 it was the sky's hour, which is `sky_time_s` now); and `day_fraction`
  /// where in its day the **sky** is, 0 at midnight to 1.
  sun_time_s: f64 = 0
  world_time_s: f64 = 0
  day_fraction: f64 = 0
  /// The declared game actions (HostApi::game_action) by bit: pressed on this tick, held now,
  /// released on this tick.
  actions_pressed: u64 = 0
  actions_held: u64 = 0
  actions_released: u64 = 0
  /// The sky's hour, absolute game seconds (the scene's epoch plus `sun_time_s`): what a game
  /// counts its days by. The day's length in real seconds (0 a still sky: 86,400 over the sun
  /// rate) and the world's rate (world seconds a real second; 0 pauses every animation), as the
  /// keys have left them.
  sky_time_s: f64 = 0 @since(2)
  day_length_s: f64 = 0 @since(2)
  world_rate: f64 = 1 @since(2)
  /// Observational window-render timing, independent of simulation/world speed. Zero until
  /// two window frames start; unavailable in offscreen replay. Includes pacing and waits.
  render_frame_ms: f64 = 0 @since(3)
  /// Number of measured frame intervals, not simulation ticks or presented scanouts.
  render_frame_serial: u64 = 0 @since(3)
  /// Sum of measured render intervals in seconds, for HUD refresh while world time is paused.
  render_elapsed_s: f64 = 0 @since(3)
}
